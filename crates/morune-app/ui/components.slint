import { Theme, Layout, Brand } from "theme.slint";

// Elementos reutilizaveis. Nenhum deles carrega valor visual proprio: tudo sai
// de `Theme`, para que um pacote de tema consiga mudar a aparencia inteira sem
// que nenhuma tela precise ser reescrita.

// Icones sao caminhos vetoriais no espaco 24x24, nao imagens: escalam em
// qualquer DPI do Windows e recebem a cor do tema sem recolorir bitmap.
export component Icon {
    in property <string> path;
    in property <brush> tint: Theme.text;
    in property <length> size: 16px;
    /// `true` para silhuetas cheias (play, pause), `false` para contornos.
    in property <bool> filled: false;

    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: root.filled ? root.tint : transparent;
        stroke: root.filled ? transparent : root.tint;
        stroke-width: 2px;
    }
}

export component PressableArea inherits FocusScope {
    // Area acionavel por mouse e teclado, com foco visivel e semantica para
    // tecnologias assistivas.
    in property <bool> enabled-input: true;
    in property <length> focus-radius: Theme.radius-sm;
    out property <bool> has-hover: pointer.has-hover;
    out property <bool> pressed: pointer.pressed;
    out property <bool> highlighted: pointer.has-hover && root.enabled-input;
    callback clicked();
    callback double-clicked();

    enabled: root.enabled-input;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-enabled: root.enabled-input;
    accessible-action-default => {
        if (root.enabled-input) { root.clicked(); }
    }

    key-pressed(event) => {
        if (root.enabled-input && (event.text == Key.Return || event.text == Key.Space)) {
            root.clicked();
            return EventResult.accept;
        }
        EventResult.reject
    }

    Rectangle {
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: root.focus-radius;
    }

    pointer := TouchArea {
        mouse-cursor: root.enabled-input ? MouseCursor.pointer : MouseCursor.default;
        enabled: root.enabled-input;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <length> button-size: 32px;
    in property <length> icon-size: 16px;
    in property <brush> tint: Theme.text;
    in property <bool> filled: false;
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    callback clicked();

    width: root.button-size;
    height: root.button-size;
    border-radius: root.button-size / 2;
    background: root.active ? Theme.selected : (touch.has-hover && root.enabled ? Theme.hover : transparent);
    opacity: root.enabled ? 1.0 : 0.4;

    animate background { duration: Theme.motion-fast; }

    Icon {
        path: root.path;
        tint: root.active ? Theme.accent : root.tint;
        size: root.icon-size;
        filled: root.filled;
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        accessible-checkable: root.checkable;
        accessible-checked: root.active;
        focus-radius: root.button-size / 2;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }

    // Rotulos visuais preservam a limpeza dos controles por icone, mas tiram
    // do usuario a obrigacao de adivinhar botoes menos universais.
    if touch.has-hover && root.label != "": Rectangle {
        z: 20;
        x: (root.width - self.width) / 2;
        y: -self.height - Theme.space-xs;
        width: min(280px, tooltip-text.preferred-width + Theme.space-md * 2);
        height: 28px;
        border-radius: Theme.radius-sm;
        background: Theme.surface-raised;
        border-width: Theme.border-width;
        border-color: Theme.border;

        tooltip-text := Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: text.preferred-width + Theme.space-lg * 2;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; }

    text := Text {
        text: root.label;
        color: Theme.text-on-accent;
        font-size: Theme.size-md;
        font-weight: Theme.weight-medium;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        focus-radius: Theme.radius-md;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    min-width: text.preferred-width + Theme.space-md * 2;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.hover : transparent;

    animate background { duration: Theme.motion-fast; }

    text := Text {
        text: root.label;
        color: root.danger ? Theme.danger : Theme.text;
        font-size: Theme.size-sm;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        accessible-label: root.label;
        focus-radius: Theme.radius-md;
        clicked => { root.clicked(); }
    }
}

// Interruptor de duas posicoes. Como todo o resto, so tem forma e cor vindas
// do tema: um tema de cantos retos deixa o interruptor retangular.
export component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: min(self.height / 2, Theme.radius-md);
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; }

    knob := Rectangle {
        width: parent.height - 6px;
        height: self.width;
        border-radius: min(self.width / 2, Theme.radius-sm);
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: root.checked ? Theme.text-on-accent : Theme.text-muted;

        animate x { duration: Theme.motion-fast; easing: ease-in-out; }
        animate background { duration: Theme.motion-fast; }
    }

    if root.interactive: PressableArea {
        enabled-input: root.enabled;
        accessible-role: switch;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        focus-radius: min(root.height / 2, Theme.radius-md);
        clicked => {
            if (root.enabled) { root.toggled(!root.checked); }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Buscar";
    callback edited(string);
    callback accepted(string);

    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : Theme.border-width;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        Icon {
            path: "M 10 2 a 8 8 0 1 0 0 16 a 8 8 0 0 0 0 -16 M 16 16 l 6 6";
            tint: Theme.text-muted;
            size: 16px;
            y: (parent.height - self.size) / 2;
        }

        Rectangle {
            placeholder := Text {
                text: root.placeholder;
                color: Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-alignment: left;
                visible: input.text == "";
                width: 100%;
            }

            input := TextInput {
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                single-line: true;
                width: 100%;
                height: 100%;
                accessible-label: root.placeholder;
                accessible-placeholder-text: root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

// Trilha arrastavel usada por progresso e volume.
export component Slider inherits Rectangle {
    in property <string> label;
    in property <float> value;          // 0.0 .. 1.0
    in property <bool> enabled: true;
    in property <length> thickness: Theme.progress-thickness;
    callback changed(float);
    callback committed(float);

    height: max(root.thickness, 16px);
    // A area de toque e maior que o traco desenhado: uma barra de 4px seria
    // dificil de acertar com o mouse.

    // Enquanto o dedo esta na trilha, quem manda no desenho e o ponteiro, e nao
    // o valor que volta do Rust. Sem isto o preenchimento so anda depois da
    // volta pelo estado da aplicacao -- e no caso do progresso ele nem chegava
    // a andar, porque o seek so e enviado ao soltar.
    private property <float> drag-value;
    private property <bool> dragging;
    private property <float> shown: root.dragging
        ? clamp(root.drag-value, 0.0, 1.0)
        : clamp(root.value, 0.0, 1.0);

    // `changed` avisa o Rust enquanto se arrasta, e o mouse dita o ritmo: um
    // mouse gamer reporta ate 1000 posicoes por segundo, e cada aviso atravessa
    // para a thread do motor e reescreve a barra inteira. Sem limite, o gesto
    // gastava mais tempo avisando do que desenhando.
    //
    // 16 ms e um quadro. O desenho nao depende disto -- ele sai de `drag-value`,
    // que continua acompanhando o ponteiro em tempo real -- e volume nao muda
    // de forma audivel mais rapido que um quadro.
    private property <bool> pending;
    throttle := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            if (root.pending) {
                root.pending = false;
                root.changed(root.drag-value);
            } else {
                // Nada novo desde o ultimo aviso: o gesto parou, e manter o
                // temporizador vivo so acordaria a interface a toa.
                self.running = false;
            }
        }
    }

    focus := FocusScope {
        accessible-role: slider;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        accessible-orientation: horizontal;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;
        accessible-value: round(root.value * 100) + "%";
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.committed(clamp(root.value + 0.05, 0, 1));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.committed(clamp(root.value - 0.05, 0, 1));
                return EventResult.accept;
            }
            EventResult.reject
        }

        accessible-action-increment => { root.committed(clamp(root.value + 0.05, 0, 1)); }
        accessible-action-decrement => { root.committed(clamp(root.value - 0.05, 0, 1)); }
    }

    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Theme.radius-sm;
    }

    track := Rectangle {
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        width: 100%;
        border-radius: root.thickness / 2;
        background: Theme.border;

        fill := Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: root.thickness / 2;
            background: touch.has-hover || touch.pressed ? Theme.accent-hover : Theme.accent;
            animate background { duration: Theme.motion-fast; }
        }
    }

    knob := Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        x: track.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        visible: root.enabled && (touch.has-hover || touch.pressed);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        width: 100%;
        height: 100%;

        moved => {
            if (self.pressed) {
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                // Primeiro movimento avisa na hora; os seguintes esperam o
                // quadro. Assim o volume reage ao inicio do gesto sem atraso e
                // mesmo assim nao passa de um aviso por quadro.
                if (throttle.running) {
                    root.pending = true;
                } else {
                    throttle.running = true;
                    root.changed(root.drag-value);
                }
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                focus.focus();
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.dragging = true;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.committed(clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
            // Tambem no `cancel`: perder o ponteiro para outra janela nao pode
            // deixar a barra congelada no ultimo lugar arrastado.
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
                // O ultimo movimento nao pode ficar preso no temporizador: o
                // `committed` acima ja mandou o valor final, entao o que sobrou
                // e ruido de um quadro.
                root.pending = false;
                throttle.running = false;
            }
        }
    }
}

// Simbolo da marca.
//
// Reproduz o desenho responsivo de 32 px de
// assets/brand/morune-logo-system/morune-symbol-32.svg, que e um desenho
// proprio e nao uma reducao do master de 512 -- por isso os numeros abaixo nao
// sao os da prancheta grande.
//
// Sao tres tracos de espessura diferente, e o Slint so aceita uma espessura por
// `Path`. Cada traco vira um elemento, e todos precisam enxergar a mesma caixa:
// o Slint encaixa a viewbox em `tamanho - espessura`, entao um elemento mais
// grosso encolheria o desenho e as barras laterais sairiam do lugar. A
// compensacao e dar a cada elemento o tamanho da caixa comum mais a propria
// espessura, centralizado.
export component Logo {
    in property <length> size: 32px;
    in property <brush> tint: Brand.mark;

    // Espessuras do desenho de 32 px: 3, 2 e 1,5 unidades.
    property <length> stroke-wave: root.size * 3 / 32;
    property <length> stroke-bar: root.size * 2 / 32;
    property <length> stroke-dot: root.size * 1.5 / 32;
    // Caixa comum, ditada pelo traco mais grosso.
    property <length> box: root.size - root.stroke-wave;

    width: root.size;
    height: root.size;

    wave := Path {
        width: root.box + root.stroke-wave;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M10 20.5 C10 15 10 7.25 12 7.25 C14.5 7.25 13.5 24.75 16 24.75 C18.5 24.75 17.5 7.25 20 7.25 C22 7.25 22 15 22 20.5";
        stroke: root.tint;
        stroke-width: root.stroke-wave;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-bar;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M6.75 13.5 V18.5 M25.25 13.5 V18.5";
        stroke: root.tint;
        stroke-width: root.stroke-bar;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-dot;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M4.25 15.25 V16.75 M27.75 15.25 V16.75";
        stroke: root.tint;
        stroke-width: root.stroke-dot;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Marcador de capa. Enquanto nao ha download de imagem, desenha um bloco com a
// inicial do titulo -- deliberadamente estavel para nao causar "pulo" de layout
// quando a capa real chegar.
export component Artwork inherits Rectangle {
    in property <string> seed;
    in property <length> radius: Theme.radius-artwork;
    // Capa de verdade. Vazia enquanto ela nao chega do cache, e o bloco neutro
    // abaixo ocupa o lugar sem mudar o layout quando ela chegar.
    in property <image> source;

    border-radius: root.radius;
    background: Theme.surface-raised;
    clip: true;

    // Sem capa, a marca do Morune.
    //
    // Boa parte das playlists nao tem imagem nenhuma na resposta do Spotify --
    // o mosaico que o cliente oficial desenha e montado por ele a partir das
    // faixas. Um bloco neutro nesses casos parecia carregamento eterno; a
    // marca diz "nao ha capa" em vez de "ainda nao chegou".
    //
    // Discreta de proposito: numa grade de vinte cartoes sem capa, a marca em
    // cor cheia viraria vinte logos disputando atencao com os titulos.
    if root.source.width == 0: Logo {
        size: parent.width * 0.42;
        tint: Theme.border;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        // A capa e quadrada e a caixa tambem; `fill` evita a borda de fundo
        // aparecer por arredondamento de um pixel.
        image-fit: fill;
    }
}
