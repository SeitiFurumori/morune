import { Theme, Layout, Brand } from "theme.slint";

// Elementos reutilizaveis. Nenhum deles carrega valor visual proprio: tudo sai
// de `Theme`, para que um pacote de tema consiga mudar a aparencia inteira sem
// que nenhuma tela precise ser reescrita.

/// Um icone: o desenho embutido e, quando o tema traz um, o arquivo que o
/// substitui.
///
/// Os dois andam juntos num valor so para que trocar de icone continue sendo
/// uma linha em quem desenha a tela. `source` vazio = usa o desenho embutido.
export struct IconRef {
    commands: string,
    source: image,
}

// Icones sao caminhos vetoriais no espaco 24x24, nao imagens: escalam em
// qualquer DPI do Windows e recebem a cor do tema sem recolorir bitmap.
//
// Um tema pode substituir qualquer um deles por um SVG em `assets/icons/`. O
// substituto continua obedecendo a cor do tema por `colorize`: um icone custom
// que ignorasse a paleta seria a unica coisa da interface fora do tema.
export component Icon {
    in property <IconRef> glyph;
    in property <brush> tint: Theme.text;
    in property <length> size: Theme.control-icon-size;
    /// `true` para silhuetas cheias (play, pause), `false` para contornos.
    in property <bool> filled: false;

    width: root.size;
    height: root.size;

    if root.glyph.source.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.glyph.source;
        colorize: root.tint;
        image-fit: contain;
    }

    if root.glyph.source.width == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.commands;
        fill: root.filled ? root.tint : transparent;
        stroke: root.filled ? transparent : root.tint;
        // O traco vem do tema em unidades do viewbox e so aqui vira pixel.
        // Antes disto eram 2px fixos: num icone de 12px o traco comia 17% da
        // caixa e o desenho sumia dentro do proprio contorno.
        //
        // Zero quando o icone e cheio, e nao a espessura com cor transparente:
        // o Slint encaixa a viewbox em `tamanho - espessura` **mesmo se o traco
        // for invisivel**. Reservar 1,5 px para um contorno que ninguem desenha
        // encolhia o glifo em 8% e fechava o vao do pause.
        stroke-width: root.filled ? 0px : root.size * Theme.control-icon-stroke / 24;
        // Sem isto o Slint junta os segmentos em miter puro, e cada canto de
        // contorno sai numa ponta aguda que nao combina com nenhum outro
        // elemento da interface.
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Realce do contorno de uma superficie de vidro.
//
// E o que faz um painel translucido parecer ter espessura: uma linha de luz
// correndo pela quina, mais clara que o contorno comum. Num tema opaco
// `border-highlight` chega igual a `border` e isto vira a mesma linha de sempre
// -- nada muda.
//
// **Contorno inteiro, de uma intensidade so.** Duas tentativas anteriores
// falharam e vale registrar por que, para ninguem refazer:
//
// 1. Duas linhas retas de 1px recuadas pela metade do raio. Linha reta nao
//    acompanha curva: ela terminava antes do canto e deixava um corte reto.
// 2. A borda de um retangulo arredondado, cortada ao meio na horizontal, com a
//    metade de baixo mais fraca. O raio ficou certo, mas na altura do corte a
//    opacidade pulava de 100% para 45% de uma vez, e o salto aparecia como um
//    talho no meio das duas laterais.
//
// O degrade so ficaria continuo com uma mascara, que o Slint nao tem, ou com
// dezenas de faixas -- e faixa por painel e custo por painel. A luz que decai
// de cima para baixo ja existe e e continua: e o `Gloss`, que e preenchimento e
// aceita gradiente de verdade. Ao contorno cabe so fechar a quina, inteiro e
// parelho.
export component GlassEdge {
    in property <length> radius: 0px;
    // `false` deixa so a linha do topo. E o caso dos paineis colados na moldura
    // da janela -- barra de titulo, barra lateral, barra de reproducao: ali a
    // base nao e quina, nao ha raio, e um contorno completo desenharia riscos
    // verticais no meio da interface.
    in property <bool> bottom: true;

    width: 100%;
    height: 100%;

    if !root.bottom: Rectangle {
        y: 0;
        width: 100%;
        height: Theme.border-width;
        background: Theme.border-highlight;
    }

    if root.bottom: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: Theme.border-width;
        border-color: Theme.border-highlight;
        // Entre a quina de cima cheia e a de baixo apagada: o contorno inteiro
        // fica no meio-termo, e quem da a direcao da luz e o `Gloss` por cima.
        opacity: 0.7;
    }
}

// Brilho difuso sobre um painel.
//
// **A luz vem na diagonal, e volta.** Antes o degrade era vertical e morria
// antes do meio: a peca ficava com uma faixa clara no topo e nada mais, que le
// como painel pintado, nao como vidro. Vidro tem dois brilhos -- o reflexo
// direto na quina que recebe a luz, e um retorno mais fraco na quina oposta,
// da luz que atravessa e bate de volta. Sem o segundo, a metade de baixo fica
// morta.
//
// O meio fica limpo de proposito: e o que separa os dois brilhos e faz o
// material parecer ter espessura.
//
// E o par do `GlassEdge`: a aresta desenha o contorno do vidro, isto desenha a
// luz caindo sobre ele. Um sem o outro parece painel contornado; os dois juntos
// parecem vidro.
//
// Preenchimento estatico, resolvido na pintura como qualquer cor chapada --
// nao ha nada a recalcular por quadro.
export component Gloss inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    // O `gloss` do tema entra na opacidade, e nao nas paradas do degrade: assim
    // `0` some por completo em vez de deixar uma faixa clara residual. E o que
    // mantem os temas sem vidro intactos: neles `gloss` e 0.
    opacity: Theme.gloss;
    // 160 graus, e nao 145: a inclinacao e **leve**. Numa peca quadrada os dois
    // dao a mesma leitura, mas a interface e feita de barras largas e baixas --
    // a de reproducao tem 1180 por 100 --, e num degrade de 145 graus o inicio
    // cai so na quina superior esquerda: o resto do topo fica sem luz nenhuma.
    // Perto da vertical, a luz corre a largura toda e a diagonal aparece como
    // deslocamento, que e o que se quer.
    background: @linear-gradient(160deg,
        #ffffff 0%,
        #ffffff45 20%,
        #ffffff00 46%,
        #ffffff00 74%,
        #ffffff2b 93%,
        #ffffff6b 100%);
}

// Densidade do fosco.
//
// Vidro fosco nao espalha a luz por igual: o centro e a orla espalham mais que
// o anel entre eles, e por isso, olhando de perto, o meio e a beirada parecem
// mais leitosos e sobra uma faixa mais limpa no caminho.
//
// **Isto e um veu, nao desfoque.** O Slint nao aplica filtro no que esta atras
// de um elemento -- nao existe `backdrop-filter` aqui. O que da para fazer e
// imitar a variacao de densidade com branco translucido. De perto convence; de
// perto tambem se percebe que o que esta atras nao esta realmente distorcido.
export component Frost inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    opacity: Theme.gloss;
    // Alfas baixos de proposito. O que conta e a **diferenca** entre o centro,
    // o anel do meio e a orla; o total somado entra por cima de toda superficie
    // de vidro da tela, e Bruma ja e um tema claro -- generoso aqui, a interface
    // inteira desbota.
    background: @radial-gradient(circle,
        #ffffff17 0%,
        #ffffff10 26%,
        #ffffff03 55%,
        #ffffff0d 83%,
        #ffffff1c 100%);
}

// A torcao da luz na orla.
//
// Numa peca de vidro a borda e mais grossa que o meio no caminho optico, e o
// que passa por ali sai deslocado -- e a faixa clara que contorna qualquer
// objeto de vidro visto de frente. Sem isso a peca parece um recorte chapado
// com um contorno desenhado.
//
// Refracao de verdade exigiria deslocar o que esta atras, e para isso seria
// preciso um shader. Aqui e um anel de luz colado na orla: nao desloca nada,
// mas devolve a leitura de espessura, que e o que falta.
export component Rim inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    opacity: Theme.gloss;
    background: @radial-gradient(circle,
        #ffffff00 0%,
        #ffffff00 86%,
        #ffffff33 95%,
        #ffffff0d 100%);
}

// Uma superficie de vidro inteira: brilho, aresta de cima e luz de retorno.
//
// Existe para nao repetir a mesma trinca em cada painel da interface -- e para
// que mudar o que e "vidro" seja mudar um componente, e nao quinze arquivos.
//
// Nao intercepta ponteiro nem entra em layout: e um filho solto do retangulo
// que hospeda, desenhado por cima do fundo e por baixo do conteudo. Por isso
// vai declarado logo depois do `background:` do hospedeiro.
export component Glass {
    in property <length> radius: 0px;
    in property <bool> bottom: true;

    width: 100%;
    height: 100%;

    // A ordem e a da luz atravessando o material: primeiro o fosco que espalha,
    // depois o brilho que cai sobre ele, depois a orla que torce, e por fim o
    // contorno. Trocar a ordem poe o brilho por baixo do fosco e apaga os dois.
    Frost { radius: root.radius; }
    Gloss { radius: root.radius; }
    Rim { radius: root.radius; }
    GlassEdge {
        radius: root.radius;
        bottom: root.bottom;
    }
}

// Diz que a lista continua alem da borda.
//
// Uma lista rolavel que termina em corte reto no meio de um texto nao le como
// "há mais abaixo": le como defeito de desenho. O degrade resolve isso sem
// ocupar altura -- ele e desenhado por cima do conteudo, na propria faixa que
// seria cortada.
//
// A cor de base e obrigatoria porque o degrade tem de morrer exatamente na
// superficie que esta atras: o fundo da pagina, o da barra lateral e o do
// painel sao tokens diferentes, e adivinhar qual deles seria errar em dois
// dos tres casos.
//
// Nao intercepta ponteiro e nao entra em layout, pelo mesmo motivo que o
// `Glass`: e um filho solto, declarado depois do conteudo que encobre.
// A raiz cobre o hospedeiro inteiro e nao pinta nada; quem pinta e a faixa
// interna, que se ancora na base. A raiz de um componente nao enxerga `parent`
// em Slint, entao a ancoragem tem de acontecer um nivel abaixo.
export component ScrollFade {
    in property <brush> base;
    // Ligado por quem hospeda: um degrade permanente mentiria numa lista curta,
    // que nao tem nada alem da borda.
    in property <bool> active: true;

    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: Theme.space-lg;
        y: parent.height - self.height;
        visible: root.active;
        background: @linear-gradient(180deg, transparent 0%, root.base 100%);
    }
}

export component PressableArea inherits FocusScope {
    // Area acionavel por mouse e teclado, com foco visivel e semantica para
    // tecnologias assistivas.
    in property <bool> enabled-input: true;
    in property <length> focus-radius: Theme.radius-sm;
    out property <bool> has-hover: pointer.has-hover;
    out property <bool> pressed: pointer.pressed;
    out property <bool> highlighted: pointer.has-hover && root.enabled-input;
    callback clicked();
    callback double-clicked();
    // Pedido de menu de contexto, em coordenadas do proprio elemento.
    //
    // Nasce aqui e nao em cada chamador porque o `TouchArea` e interno: sem
    // isto o botao direito morreria dentro do componente. O mesmo callback
    // atende a tecla Menu, para que quem navega por teclado chegue ao mesmo
    // lugar sem mouse.
    callback context-menu-requested(x: length, y: length);

    enabled: root.enabled-input;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-enabled: root.enabled-input;
    accessible-action-default => {
        if (root.enabled-input) { root.clicked(); }
    }

    key-pressed(event) => {
        if (root.enabled-input && (event.text == Key.Return || event.text == Key.Space)) {
            root.clicked();
            return EventResult.accept;
        }
        // A tecla Menu e tratada aqui dentro, e nao por quem usa o componente:
        // um `key-pressed` na instancia substituiria este bloco inteiro e
        // levaria junto o Return e o Espaco.
        if (root.enabled-input && event.text == Key.Menu) {
            root.context-menu-requested(root.width / 2, root.height / 2);
            return EventResult.accept;
        }
        EventResult.reject
    }

    Rectangle {
        border-width: root.has-focus ? Theme.border-width * 2 : 0px;
        border-color: Theme.focus-ring;
        border-radius: root.focus-radius;
    }

    pointer := TouchArea {
        mouse-cursor: root.enabled-input ? MouseCursor.pointer : MouseCursor.default;
        enabled: root.enabled-input;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        // O `clicked` do Slint e so o botao esquerdo; o direito so chega por
        // aqui. O foco vai junto para que Escape e as setas continuem valendo
        // depois que o menu fechar.
        pointer-event(event) => {
            if (root.enabled-input
                && event.kind == PointerEventKind.down
                && event.button == PointerEventButton.right) {
                root.focus();
                root.context-menu-requested(pointer.mouse-x, pointer.mouse-y);
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    in property <IconRef> glyph;
    in property <length> button-size: Theme.control-button-size;
    in property <length> icon-size: Theme.control-icon-size;
    in property <brush> tint: Theme.text;
    in property <bool> filled: false;
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    /// Para quem revela o botao so no hover: sem isto, um botao com opacidade
    /// zero continua no caminho do Tab e o foco desaparece da tela.
    out property <bool> has-focus: touch.has-focus;
    /// Ativo sem pintar o fundo.
    ///
    /// Existe para nao ter de escolher entre acessibilidade e ruido visual:
    /// numa lista de curtidas, `active` em cem coracoes desenha cem caixinhas
    /// coloridas, mas tirar `active` tiraria junto o `accessible-checked` que
    /// diz ao leitor de tela que a faixa esta curtida. Com isto o estado
    /// continua sendo anunciado e quem mostra que esta marcado e o proprio
    /// icone, cheio em vez de contornado.
    in property <bool> quiet: false;
    callback clicked();

    width: root.button-size;
    height: root.button-size;
    border-radius: min(Theme.control-button-radius, root.button-size / 2);
    background: root.active && !root.quiet
        ? Theme.selected
        : (touch.has-hover && root.enabled ? Theme.hover : transparent);
    opacity: root.enabled ? 1.0 : 0.4;

    animate background { duration: Theme.motion-fast; }

    Icon {
        glyph: root.glyph;
        // `quiet` tambem tira o accent do icone, e nao so o fundo do botao. Era
        // aqui que os cem coracoes de uma biblioteca de curtidas viravam cem
        // manchas na cor de destaque: quem esta ativo pinta de accent, e curtir
        // e a regra e nao a excecao numa lista de curtidas. Quem quer o accent
        // continua tendo -- basta nao pedir `quiet`.
        tint: root.active && !root.quiet ? Theme.accent : root.tint;
        size: root.icon-size;
        filled: root.filled;
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        accessible-checkable: root.checkable;
        accessible-checked: root.active;
        focus-radius: min(Theme.control-button-radius, root.button-size / 2);
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }

    // Rotulos visuais preservam a limpeza dos controles por icone, mas tiram
    // do usuario a obrigacao de adivinhar botoes menos universais.
    if touch.has-hover && root.label != "": Rectangle {
        z: 20;
        x: (root.width - self.width) / 2;
        y: -self.height - Theme.space-xs;
        width: min(280px, tooltip-text.preferred-width + Theme.space-md * 2);
        height: Theme.control-tooltip-height;
        border-radius: Theme.radius-sm;
        background: Theme.surface-raised;
        border-width: Theme.border-width;
        border-color: Theme.border;

        Glass { radius: Theme.radius-sm; }

        tooltip-text := Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: text.preferred-width + Theme.space-lg * 2;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; }

    text := Text {
        text: root.label;
        color: Theme.text-on-accent;
        font-size: Theme.size-md;
        font-weight: Theme.weight-medium;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        focus-radius: Theme.radius-md;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    /// Escolha corrente, quando o botao faz parte de um grupo de opcoes.
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    min-width: text.preferred-width + Theme.space-md * 2;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    // Ativo se distingue por contorno e cor de texto, nao por sombra: e a
    // mesma regra que o resto da interface segue.
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active
        ? Theme.selected
        : (touch.has-hover ? Theme.hover : transparent);

    animate background { duration: Theme.motion-fast; }

    text := Text {
        text: root.label;
        color: root.danger
            ? Theme.danger
            : (root.active ? Theme.accent : Theme.text);
        font-size: Theme.size-sm;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        accessible-label: root.label;
        accessible-checkable: root.active;
        accessible-checked: root.active;
        focus-radius: Theme.radius-md;
        clicked => { root.clicked(); }
    }
}

// Interruptor de duas posicoes. Como todo o resto, so tem forma e cor vindas
// do tema: um tema de cantos retos deixa o interruptor retangular.
export component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: min(self.height / 2, Theme.radius-md);
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; }

    knob := Rectangle {
        width: parent.height - 6px;
        height: self.width;
        border-radius: min(self.width / 2, Theme.radius-sm);
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: root.checked ? Theme.text-on-accent : Theme.text-muted;

        animate x { duration: Theme.motion-fast; easing: ease-in-out; }
        animate background { duration: Theme.motion-fast; }
    }

    if root.interactive: PressableArea {
        enabled-input: root.enabled;
        accessible-role: switch;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        focus-radius: min(root.height / 2, Theme.radius-md);
        clicked => {
            if (root.enabled) { root.toggled(!root.checked); }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Buscar";
    callback edited(string);
    callback accepted(string);

    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : Theme.border-width;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;

    Glass { radius: Theme.radius-md; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        Icon {
            glyph: { commands: "M 10 2 a 8 8 0 1 0 0 16 a 8 8 0 0 0 0 -16 M 16 16 l 6 6" };
            tint: Theme.text-muted;
            size: Theme.control-icon-size;
            y: (parent.height - self.size) / 2;
        }

        Rectangle {
            placeholder := Text {
                text: root.placeholder;
                color: Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-alignment: left;
                visible: input.text == "";
                width: 100%;
            }

            input := TextInput {
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                single-line: true;
                width: 100%;
                height: 100%;
                accessible-label: root.placeholder;
                accessible-placeholder-text: root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

// Trilha arrastavel usada por progresso e volume.
export component Slider inherits Rectangle {
    in property <string> label;
    in property <float> value;          // 0.0 .. 1.0
    in property <bool> enabled: true;
    in property <length> thickness: Theme.progress-thickness;
    callback changed(float);
    callback committed(float);

    height: max(root.thickness, 16px);
    // A area de toque e maior que o traco desenhado: uma barra de 4px seria
    // dificil de acertar com o mouse.

    // Enquanto o dedo esta na trilha, quem manda no desenho e o ponteiro, e nao
    // o valor que volta do Rust. Sem isto o preenchimento so anda depois da
    // volta pelo estado da aplicacao -- e no caso do progresso ele nem chegava
    // a andar, porque o seek so e enviado ao soltar.
    private property <float> drag-value;
    private property <bool> dragging;
    private property <float> shown: root.dragging
        ? clamp(root.drag-value, 0.0, 1.0)
        : clamp(root.value, 0.0, 1.0);

    // `changed` avisa o Rust enquanto se arrasta, e o mouse dita o ritmo: um
    // mouse gamer reporta ate 1000 posicoes por segundo, e cada aviso atravessa
    // para a thread do motor e reescreve a barra inteira. Sem limite, o gesto
    // gastava mais tempo avisando do que desenhando.
    //
    // 16 ms e um quadro. O desenho nao depende disto -- ele sai de `drag-value`,
    // que continua acompanhando o ponteiro em tempo real -- e volume nao muda
    // de forma audivel mais rapido que um quadro.
    private property <bool> pending;
    throttle := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            if (root.pending) {
                root.pending = false;
                root.changed(root.drag-value);
            } else {
                // Nada novo desde o ultimo aviso: o gesto parou, e manter o
                // temporizador vivo so acordaria a interface a toa.
                self.running = false;
            }
        }
    }

    focus := FocusScope {
        accessible-role: slider;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        accessible-orientation: horizontal;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;
        accessible-value: round(root.value * 100) + "%";
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.committed(clamp(root.value + 0.05, 0, 1));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.committed(clamp(root.value - 0.05, 0, 1));
                return EventResult.accept;
            }
            EventResult.reject
        }

        accessible-action-increment => { root.committed(clamp(root.value + 0.05, 0, 1)); }
        accessible-action-decrement => { root.committed(clamp(root.value - 0.05, 0, 1)); }
    }

    Rectangle {
        border-width: focus.has-focus ? Theme.border-width * 2 : 0px;
        border-color: Theme.focus-ring;
        border-radius: Theme.radius-sm;
    }

    track := Rectangle {
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        width: 100%;
        border-radius: root.thickness / 2;
        background: Theme.border;

        fill := Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: root.thickness / 2;
            background: touch.has-hover || touch.pressed ? Theme.accent-hover : Theme.accent;
            animate background { duration: Theme.motion-fast; }
        }
    }

    knob := Rectangle {
        width: Theme.control-slider-knob;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.text;
        x: track.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        visible: root.enabled && (touch.has-hover || touch.pressed);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        width: 100%;
        height: 100%;

        moved => {
            if (self.pressed) {
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                // Primeiro movimento avisa na hora; os seguintes esperam o
                // quadro. Assim o volume reage ao inicio do gesto sem atraso e
                // mesmo assim nao passa de um aviso por quadro.
                if (throttle.running) {
                    root.pending = true;
                } else {
                    throttle.running = true;
                    root.changed(root.drag-value);
                }
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                focus.focus();
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.dragging = true;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.committed(clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
            // Tambem no `cancel`: perder o ponteiro para outra janela nao pode
            // deixar a barra congelada no ultimo lugar arrastado.
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
                // O ultimo movimento nao pode ficar preso no temporizador: o
                // `committed` acima ja mandou o valor final, entao o que sobrou
                // e ruido de um quadro.
                root.pending = false;
                throttle.running = false;
            }
        }
    }
}

// Simbolo da marca.
//
// Reproduz o desenho responsivo de 32 px de
// assets/brand/morune-logo-system/morune-symbol-32.svg, que e um desenho
// proprio e nao uma reducao do master de 512 -- por isso os numeros abaixo nao
// sao os da prancheta grande.
//
// Sao tres tracos de espessura diferente, e o Slint so aceita uma espessura por
// `Path`. Cada traco vira um elemento, e todos precisam enxergar a mesma caixa:
// o Slint encaixa a viewbox em `tamanho - espessura`, entao um elemento mais
// grosso encolheria o desenho e as barras laterais sairiam do lugar. A
// compensacao e dar a cada elemento o tamanho da caixa comum mais a propria
// espessura, centralizado.
export component Logo {
    in property <length> size: 32px;
    in property <brush> tint: Brand.mark;

    // Espessuras do desenho de 32 px: 3, 2 e 1,5 unidades.
    property <length> stroke-wave: root.size * 3 / 32;
    property <length> stroke-bar: root.size * 2 / 32;
    property <length> stroke-dot: root.size * 1.5 / 32;
    // Caixa comum, ditada pelo traco mais grosso.
    property <length> box: root.size - root.stroke-wave;

    width: root.size;
    height: root.size;

    wave := Path {
        width: root.box + root.stroke-wave;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M10 20.5 C10 15 10 7.25 12 7.25 C14.5 7.25 13.5 24.75 16 24.75 C18.5 24.75 17.5 7.25 20 7.25 C22 7.25 22 15 22 20.5";
        stroke: root.tint;
        stroke-width: root.stroke-wave;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-bar;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M6.75 13.5 V18.5 M25.25 13.5 V18.5";
        stroke: root.tint;
        stroke-width: root.stroke-bar;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-dot;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M4.25 15.25 V16.75 M27.75 15.25 V16.75";
        stroke: root.tint;
        stroke-width: root.stroke-dot;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Marcador de capa. Enquanto nao ha download de imagem, desenha um bloco com a
// inicial do titulo -- deliberadamente estavel para nao causar "pulo" de layout
// quando a capa real chegar.
// Capa de um item, com dois estados de ausencia que nao sao o mesmo.
//
// **Por que a marca saiu daqui.** Antes, tudo que nao tinha imagem virava o
// simbolo do Morune. Numa unica tela de Inicio isso dava **dezenove logos** --
// oito nos cartoes, dez na barra lateral, um no rodape -- e a marca passou a
// significar "faltou alguma coisa". Pior: o mesmo desenho aparecia enquanto a
// capa ainda estava baixando, entao "carregando" e "nao existe" -- que sao o
// oposto um do outro -- eram indistinguiveis.
//
// Agora sao tres estados separados:
//
// | estado | como se sabe | o que aparece |
// |---|---|---|
// | tem capa | `source` chegou | a imagem |
// | ainda chegando | `pending`, capa vazia | superficie neutra, sem simbolo |
// | nao tem capa | nem `source` nem `pending` | ficha gerada: matiz do nome + inicial |
//
// A ficha gerada nao e enfeite. Boa parte das playlists nao tem imagem alguma
// na resposta do Spotify -- o mosaico que o cliente oficial mostra e montado
// por ele a partir das faixas. Repetir o mesmo desenho em todas elas apagava a
// diferenca entre listas; uma cor propria por nome devolve identidade a cada
// uma, e a inicial da o que ler quando o cartao e pequeno demais para o titulo.
export component Artwork inherits Rectangle {
    /// Inicial do nome, ja recortada pelo lado Rust: o Slint nao fatia string.
    in property <string> initial;
    /// Matiz da ficha, 0..360, derivada do nome. Vem pronta do Rust pelo mesmo
    /// motivo -- nao ha como somar os codigos das letras aqui.
    in property <float> hue;
    /// `true` enquanto a capa existe e ainda esta a caminho do cache.
    in property <bool> pending;
    in property <length> radius: Theme.radius-artwork;
    // Capa de verdade. Vazia enquanto ela nao chega do cache, e o bloco neutro
    // abaixo ocupa o lugar sem mudar o layout quando ela chegar.
    in property <image> source;

    // Claro ou escuro sai do proprio tema, e nao de um token novo: o contrato
    // de tema e um conjunto fechado de slots, e ler o valor do fundo responde a
    // mesma pergunta sem abrir mais um.
    private property <bool> claro: Theme.background.to-hsv().value > 0.5;

    border-radius: root.radius;
    background: Theme.surface-raised;
    clip: true;

    // Sem nome nao ha ficha: o rodape sem musica tocando cairia numa cor
    // sorteada do texto vazio, e um quadrado colorido ao lado de "Nada tocando"
    // promete um conteudo que nao existe.
    if root.source.width == 0 && !root.pending && root.initial != "": Rectangle {
        // Diagonal, e nao chapado: o gradiente e o que faz vinte fichas lado a
        // lado parecerem capas em vez de vinte retangulos de cor.
        background: @linear-gradient(135deg,
            hsv(root.hue, root.claro ? 0.34 : 0.52, root.claro ? 0.94 : 0.42) 0%,
            hsv(root.hue, root.claro ? 0.24 : 0.44, root.claro ? 0.80 : 0.24) 100%);

        Text {
            text: root.initial;
            // Acompanha a caixa: a mesma ficha serve a linha de 40px da lista e
            // ao cartao de 160px, e uma inicial de tamanho fixo sumiria numa e
            // estouraria na outra.
            font-size: parent.height * 0.42;
            font-family: Theme.font-family;
            font-weight: Theme.weight-bold;
            color: root.claro ? hsv(root.hue, 0.55, 0.32) : hsv(root.hue, 0.22, 0.97);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        // A capa e quadrada e a caixa tambem; `fill` evita a borda de fundo
        // aparecer por arredondamento de um pixel.
        image-fit: fill;
    }
}

// Avatar da conta: circulo com a inicial.
//
// **Por que uma inicial e nao a foto:** o caminho de login do Morune nao
// entrega foto nem nome de exibicao -- so o identificador da sessao (ver
// `morune-spotify/src/auth.rs`). Desenhar a inicial e o que da forma e cor a um
// dado que, sozinho, e um texto minusculo em cinza.
//
// A cor vem do acento do tema, com o par `text-on-accent` que o contrato de
// tema garante legivel. E o unico elemento saturado do rodape da barra
// lateral, e e de proposito: e ali que a conta se identifica.
export component AccountAvatar inherits Rectangle {
    in property <string> initial;
    in property <length> size: 22px;
    /// Foto do perfil. Vazia enquanto o cache nao a entrega, e vazia para
    /// sempre em quem nunca escolheu uma -- nos dois casos vale a inicial, e o
    /// circulo tem o mesmo tamanho, entao a chegada da foto nao mexe o layout.
    in property <image> source;

    width: root.size;
    height: root.size;
    border-radius: min(root.size / 2, Theme.radius-avatar);
    background: Theme.accent;
    clip: true;

    if root.source.width == 0: Text {
        text: root.initial;
        color: Theme.text-on-accent;
        // Proporcional ao circulo: o mesmo componente serve a barra lateral e
        // a tela de configuracoes, em tamanhos diferentes.
        font-size: root.size * 0.5;
        font-weight: Theme.weight-bold;
        font-family: Theme.font-family;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        // A foto do Spotify e quadrada e o circulo tambem; `fill` evita o
        // acento aparecer por arredondamento de um pixel na borda.
        image-fit: fill;
    }
}

// Linha de acao de um menu desenhado pelo proprio aplicativo.
//
// O menu nativo do Windows nao aceita estilo: e um HMENU desenhado pelo
// sistema. Vale para a bandeja e vale dentro da janela -- o `ContextMenuArea`
// do Slint tambem sai como HMENU no Windows. Desenhado aqui, cada item volta a
// ser um retangulo comum, e o realce de hover passa a ser o mesmo dos itens de
// navegacao da janela principal, em vez do azul do sistema.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <IconRef> glyph;
    in property <brush> tint: Theme.text;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.hover : transparent;

    animate background { duration: Theme.motion-fast; }

    if touch.has-hover: Glass { radius: Theme.radius-sm; }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Icon {
            glyph: root.glyph;
            tint: root.tint;
            size: 16px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.tint;
            font-size: Theme.size-md;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: root.text;
        focus-radius: Theme.radius-sm;
        clicked => { root.clicked(); }
    }
}
