import { Theme, Layout, Brand } from "theme.slint";

// Elementos reutilizaveis. Nenhum deles carrega valor visual proprio: tudo sai
// de `Theme`, para que um pacote de tema consiga mudar a aparencia inteira sem
// que nenhuma tela precise ser reescrita.

/// Um icone: o desenho embutido e, quando o tema traz um, o arquivo que o
/// substitui.
///
/// Os dois andam juntos num valor so para que trocar de icone continue sendo
/// uma linha em quem desenha a tela. `source` vazio = usa o desenho embutido.
export struct IconRef {
    commands: string,
    source: image,
    // Desenho embutido como imagem, e a versao cheia dele para o estado ligado
    // (coracao curtido, play no botao principal). `source` -- o do tema --
    // vence os dois. Campos separados, e nao `source: tema ? tema : embutido`:
    // usar a mesma imagem do tema duas vezes num literal gera Rust invalido no
    // Slint 1.17 (valor movido).
    builtin: image,
    solid-builtin: image,
}

// Icones sao caminhos vetoriais no espaco 24x24, nao imagens: escalam em
// qualquer DPI do Windows e recebem a cor do tema sem recolorir bitmap.
//
// Um tema pode substituir qualquer um deles por um SVG em `assets/icons/`. O
// substituto continua obedecendo a cor do tema por `colorize`: um icone custom
// que ignorasse a paleta seria a unica coisa da interface fora do tema.
export component Icon {
    in property <IconRef> glyph;
    in property <brush> tint: Theme.text;
    in property <length> size: Theme.control-icon-size;
    /// `true` para silhuetas cheias (play, pause), `false` para contornos.
    in property <bool> filled: false;

    width: root.size;
    height: root.size;

    property <image> imagem: root.glyph.source.width > 0 ? root.glyph.source
        : (root.filled && root.glyph.solid-builtin.width > 0 ? root.glyph.solid-builtin : root.glyph.builtin);

    if root.imagem.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.imagem;
        colorize: root.tint;
        image-fit: contain;
    }

    if root.imagem.width == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.commands;
        fill: root.filled ? root.tint : transparent;
        stroke: root.filled ? transparent : root.tint;
        // O traco vem do tema em unidades do viewbox e so aqui vira pixel.
        // Antes disto eram 2px fixos: num icone de 12px o traco comia 17% da
        // caixa e o desenho sumia dentro do proprio contorno.
        //
        // Zero quando o icone e cheio, e nao a espessura com cor transparente:
        // o Slint encaixa a viewbox em `tamanho - espessura` **mesmo se o traco
        // for invisivel**. Reservar 1,5 px para um contorno que ninguem desenha
        // encolhia o glifo em 8% e fechava o vao do pause.
        stroke-width: root.filled ? 0px : root.size * Theme.control-icon-stroke / 24;
        // Sem isto o Slint junta os segmentos em miter puro, e cada canto de
        // contorno sai numa ponta aguda que nao combina com nenhum outro
        // elemento da interface.
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Realce do contorno de uma superficie de vidro.
//
// E o que faz um painel translucido parecer ter espessura: uma linha de luz
// correndo pela quina, mais clara que o contorno comum. Num tema opaco
// `border-highlight` chega igual a `border` e isto vira a mesma linha de sempre
// -- nada muda.
//
// **Contorno inteiro, de uma intensidade so.** Duas tentativas anteriores
// falharam e vale registrar por que, para ninguem refazer:
//
// 1. Duas linhas retas de 1px recuadas pela metade do raio. Linha reta nao
//    acompanha curva: ela terminava antes do canto e deixava um corte reto.
// 2. A borda de um retangulo arredondado, cortada ao meio na horizontal, com a
//    metade de baixo mais fraca. O raio ficou certo, mas na altura do corte a
//    opacidade pulava de 100% para 45% de uma vez, e o salto aparecia como um
//    talho no meio das duas laterais.
//
// O degrade so ficaria continuo com uma mascara, que o Slint nao tem, ou com
// dezenas de faixas -- e faixa por painel e custo por painel. A luz que decai
// de cima para baixo ja existe e e continua: e o `Gloss`, que e preenchimento e
// aceita gradiente de verdade. Ao contorno cabe so fechar a quina, inteiro e
// parelho.
export component GlassEdge {
    in property <length> radius: 0px;
    // `false` deixa so a linha do topo. E o caso dos paineis colados na moldura
    // da janela -- barra de titulo, barra lateral, barra de reproducao: ali a
    // base nao e quina, nao ha raio, e um contorno completo desenharia riscos
    // verticais no meio da interface.
    in property <bool> bottom: true;

    width: 100%;
    height: 100%;

    if !root.bottom: Rectangle {
        y: 0;
        width: 100%;
        height: Theme.border-width;
        background: Theme.border-highlight;
    }

    if root.bottom: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: Theme.border-width;
        border-color: Theme.border-highlight;
        // Entre a quina de cima cheia e a de baixo apagada: o contorno inteiro
        // fica no meio-termo, e quem da a direcao da luz e o `Gloss` por cima.
        opacity: 0.7;
    }
}

// Brilho difuso sobre um painel.
//
// **A luz vem na diagonal, e volta.** Antes o degrade era vertical e morria
// antes do meio: a peca ficava com uma faixa clara no topo e nada mais, que le
// como painel pintado, nao como vidro. Vidro tem dois brilhos -- o reflexo
// direto na quina que recebe a luz, e um retorno mais fraco na quina oposta,
// da luz que atravessa e bate de volta. Sem o segundo, a metade de baixo fica
// morta.
//
// O meio fica limpo de proposito: e o que separa os dois brilhos e faz o
// material parecer ter espessura.
//
// E o par do `GlassEdge`: a aresta desenha o contorno do vidro, isto desenha a
// luz caindo sobre ele. Um sem o outro parece painel contornado; os dois juntos
// parecem vidro.
//
// Preenchimento estatico, resolvido na pintura como qualquer cor chapada --
// nao ha nada a recalcular por quadro.
export component Gloss inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    // O `gloss` do tema entra na opacidade, e nao nas paradas do degrade: assim
    // `0` some por completo em vez de deixar uma faixa clara residual. E o que
    // mantem os temas sem vidro intactos: neles `gloss` e 0.
    opacity: Theme.gloss;
    // 160 graus, e nao 145: a inclinacao e **leve**. Numa peca quadrada os dois
    // dao a mesma leitura, mas a interface e feita de barras largas e baixas --
    // a de reproducao tem 1180 por 100 --, e num degrade de 145 graus o inicio
    // cai so na quina superior esquerda: o resto do topo fica sem luz nenhuma.
    // Perto da vertical, a luz corre a largura toda e a diagonal aparece como
    // deslocamento, que e o que se quer.
    // **Nao ha degrade nenhum. So a linha.**
    //
    // Este componente foi, em ordem: um veu vertical, um veu diagonal com dois
    // brilhos, e um degrade curto nas duas pontas. Os tres estavam errados pelo
    // mesmo motivo -- o original nao tem veu. O que ele tem e uma LINHA de luz
    // na quina, e o resto da peca limpo.
    //
    // Medido na versao com degrade curto: a luminancia dentro da barra lateral
    // ainda ia de 0,067 a 0,759. Encurtar as paradas diminuiu o problema sem
    // resolver, porque o problema era existir.
    //
    // O preenchimento fica transparente e quem desenha a linha e o `GlassEdge`,
    // que ja existia e ja acompanha o raio da peca. Este componente vira o lugar
    // onde o `gloss` do tema controla a INTENSIDADE dessa linha -- nada mais.
    background: transparent;
}

// Densidade do fosco.
//
// Vidro fosco nao espalha a luz por igual: o centro e a orla espalham mais que
// o anel entre eles, e por isso, olhando de perto, o meio e a beirada parecem
// mais leitosos e sobra uma faixa mais limpa no caminho.
//
// **Isto e um veu, nao desfoque.** O Slint nao aplica filtro no que esta atras
// de um elemento -- nao existe `backdrop-filter` aqui. O que da para fazer e
// imitar a variacao de densidade com branco translucido. De perto convence; de
// perto tambem se percebe que o que esta atras nao esta realmente distorcido.
export component Frost inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    opacity: Theme.gloss;
    // Alfas baixos de proposito. O que conta e a **diferenca** entre o centro,
    // o anel do meio e a orla; o total somado entra por cima de toda superficie
    // de vidro da tela, e Bruma ja e um tema claro -- generoso aqui, a interface
    // inteira desbota.
    // **Tambem sem degrade.** Este era o terceiro veu empilhado sobre a mesma
    // peca -- fosco, brilho e orla, todos radiais, todos por cima de tudo. Com
    // acrilico de verdade atras, o fosco ja e feito pelo Windows: imitar de novo
    // aqui so lava o que aparece atraves.
    //
    // Sobra transparente. O componente fica porque o `Glass` o compoe e porque
    // um tema sem material de sistema pode voltar a querer o veu; hoje nenhum
    // quer.
    background: transparent;
}

// A torcao da luz na orla.
//
// Numa peca de vidro a borda e mais grossa que o meio no caminho optico, e o
// que passa por ali sai deslocado -- e a faixa clara que contorna qualquer
// objeto de vidro visto de frente. Sem isso a peca parece um recorte chapado
// com um contorno desenhado.
//
// Refracao de verdade exigiria deslocar o que esta atras, e para isso seria
// preciso um shader. Aqui e um anel de luz colado na orla: nao desloca nada,
// mas devolve a leitura de espessura, que e o que falta.
export component Rim inherits Rectangle {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    opacity: Theme.gloss;
    // A orla e o unico degrade que fica, e ela e estreita de proposito: comeca
    // em 94% do raio. E a linha de luz da quina, nao um veu -- some antes de
    // chegar ao miolo da peca.
    background: @radial-gradient(circle,
        #ffffff00 0%,
        #ffffff00 94%,
        #ffffff26 98%,
        #ffffff00 100%);
}

// Uma superficie de vidro inteira: brilho, aresta de cima e luz de retorno.
//
// Existe para nao repetir a mesma trinca em cada painel da interface -- e para
// que mudar o que e "vidro" seja mudar um componente, e nao quinze arquivos.
//
// Nao intercepta ponteiro nem entra em layout: e um filho solto do retangulo
// que hospeda, desenhado por cima do fundo e por baixo do conteudo. Por isso
// vai declarado logo depois do `background:` do hospedeiro.
// **Onde este componente pode entrar, e a lista e fechada.**
//
// A regra e das duas plataformas, com as proprias palavras. Apple: "Don't use
// Liquid Glass in the content layer... Instead, use standard materials for
// elements in the content layer." Microsoft: "Don't apply backdrop material to
// a UI element", e acrilico "only for transient, light-dismiss surfaces such as
// flyouts and context menus". Quando tudo e vidro, nada esta acima de nada.
//
// Logo, `Glass` so vale em duas familias:
//
// 1. **Moldura da janela** -- barra de titulo, barra de reproducao, casca da
//    barra lateral. Sao a borda do aplicativo, nao o conteudo dele.
// 2. **Superficie transitoria** -- menu de contexto, aviso de rodape, dialogo
//    de atalhos, sobreposicao de diagnostico. Aparecem, sao dispensadas, e
//    enquanto estao ali precisam dizer que flutuam acima de tudo.
//
// Fora dessas duas, a resposta e a cor do tema: `surface` para o painel,
// `hover`/`selected` para o realce -- que e o "low-opacity solid color" que a
// documentacao do Windows manda usar na camada de conteudo. Oito chamadas foram
// removidas por esta regra (linha de faixa, cartao, item de navegacao, chip de
// ordenacao, linha de tema e os paineis das Configuracoes); em todas elas ja
// havia cor solida por baixo, entao o vidro era puramente aditivo.
//
// Nos cartoes que perderam o vidro o contorno passou a ser `border` do proprio
// Rectangle. Sem isso, num tema cuja `surface` e branco a 12% -- o Bruma --, o
// painel ficava sem nenhuma aresta e desaparecia no fundo.
// A aurora do Windows 7: listras finas a 54 graus que andam devagar.
//
// E o detalhe que mais identifica aquele vidro. A folha (`materiais/aurora.png`,
// ver tools/material-aurora.py) ja vem inclinada e emenda sem costura nas duas
// direcoes, entao o painel e coberto por uma grade de ladrilhos -- imagens
// pequenas, sem giro -- e a grade inteira desliza em `x` pela
// `Theme.aurora-fase`, voltando ao inicio a cada largura de ladrilho.
//
// **Sem giro de proposito.** Girar uma imagem grande dentro de um recorte
// fazia o renderizador abrir uma camada do tamanho da imagem girada por
// painel: medido em 6 GB de memoria e 11% de GPU. Ladrilhos retos sao
// quadrilateros com textura, o caso mais barato que existe.
//
// Fica por cima do borrao e da cor e por baixo do conteudo, como no original.
// So existe no material Aero: nos outros nao desenha nada.
export component Aurora inherits Rectangle {
    in property <length> radius: 0px;
    /// Quanto a aurora aparece. Painel grande aguenta mais que peca pequena.
    in property <float> forca: 1.0;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    // **Sem `clip` proprio nem opacidade de grupo.** Cada um dos dois abre
    // uma camada inteira no renderizador a cada quadro; quem recorta e o
    // painel que hospeda, uma vez so. A opacidade vai em cada ladrilho.

    // Medidas do ladrilho, as mesmas da folha.
    private property <length> ladrilho-w: 791px;
    private property <length> ladrilho-h: 1089px;
    // Uma coluna a mais para o deslocamento nao descobrir a borda esquerda.
    private property <int> colunas: floor(root.width / root.ladrilho-w) + 2;
    private property <int> linhas: floor(root.height / root.ladrilho-h) + 1;

    if Theme.material-kind == 1: Rectangle {
        width: 100%;
        height: 100%;
        for c in root.colunas: Rectangle {
            for l in root.linhas: Image {
                source: @image-url("materiais/aurora.png");
                image-fit: fill;
                width: root.ladrilho-w;
                height: root.ladrilho-h;
                x: (c - 1) * root.ladrilho-w + root.ladrilho-w * Theme.aurora-fase;
                y: l * root.ladrilho-h;
                opacity: root.forca * Theme.gloss;
            }
        }
    }
}

// A moldura do vidro do Windows 7: escura por fora, branca por dentro.
//
// Sao duas linhas de 1 px, uma dentro da outra, e e a combinacao que le como
// "borda de vidro": a escura separa o painel do que esta atras, a branca e a
// luz batendo na quina. Uma so das duas parece painel pintado.
export component MolduraAero {
    in property <length> radius: 0px;

    width: 100%;
    height: 100%;

    if Theme.material-kind == 1: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: Theme.border-width;
        border-color: Theme.border;
    }
    if Theme.material-kind == 1: Rectangle {
        x: Theme.border-width;
        y: Theme.border-width;
        width: parent.width - Theme.border-width * 2;
        height: parent.height - Theme.border-width * 2;
        border-radius: max(0px, root.radius - Theme.border-width);
        border-width: Theme.border-width;
        border-color: Theme.border-highlight;
    }
}

// Cena de chuva sobre a imagem de fundo (Lo-fi, Neo-Shinjuku).
//
// A area onde chove vem do tema em fracao da IMAGEM: a conta abaixo refaz o
// `image-fit: cover` do fundo, entao a chuva continua no mesmo lugar da foto
// (o vidro da janela, por exemplo) em qualquer tamanho de janela do app.
//
// Duas camadas: garoa fina ao longe e, com `chuva-forca` alta, gotas grossas
// na frente. Cada gota cai um numero INTEIRO de vezes por volta do relogio,
// entao o laco recomeca sem salto. Perto das bordas da area as gotas somem aos
// poucos, para a chuva nao terminar num risco reto. So posicao e opacidade:
// nada de desfoque por quadro atras do jogo.
export component CenaChuva inherits Rectangle {
    clip: true;
    private property <bool> ligado: false;
    private property <bool> vivo: Theme.cena-viva && self.ligado;
    init => { self.ligado = true; }

    // --- onde a imagem de fundo caiu na janela ---
    private property <float> iw: Theme.background-image.width;
    private property <float> ih: Theme.background-image.height;
    private property <bool> tem-imagem: self.iw > 0 && self.ih > 0;
    private property <float> esc: self.tem-imagem ? max(root.width / 1px / self.iw, root.height / 1px / self.ih) : 1.0;
    private property <length> dw: self.tem-imagem ? self.iw * self.esc * 1px : root.width;
    private property <length> dh: self.tem-imagem ? self.ih * self.esc * 1px : root.height;
    private property <length> ox: (root.width - self.dw) / 2;
    private property <length> oy: (root.height - self.dh) / 2;

    // --- relogio da chuva: 0 a 1 em 2 s, sem fim ---
    private property <float> t: root.vivo ? 1.0 : 0.0;
    animate t { duration: 2s; iteration-count: -1; easing: linear; }

    private property <float> forca: Theme.chuva-forca;
    private property <float> vento: Theme.chuva-vento;
    private property <int> n-longe: 50 + 110 * root.forca;
    private property <int> n-perto: max(0, (root.forca - 0.55) * 90);

    area := Rectangle {
        clip: true;
        x: root.ox + Theme.chuva-x * root.dw;
        y: root.oy + Theme.chuva-y * root.dh;
        width: Theme.chuva-largura * root.dw;
        height: Theme.chuva-altura * root.dh;
        // Borda que some: o quanto da area, em cada lado, e transicao.
        private property <bool> inteira: Theme.chuva-largura >= 0.999 && Theme.chuva-altura >= 0.999;

        for i in root.n-longe: Rectangle {
            private property <float> r1: Math.mod(Math.abs(Math.sin((i + 1) * 12.9898 * 1rad) * 43758.5453), 1.0);
            private property <float> r2: Math.mod(Math.abs(Math.sin((i + 1) * 78.233 * 1rad) * 43758.5453), 1.0);
            private property <float> r3: Math.mod(Math.abs(Math.sin((i + 1) * 37.719 * 1rad) * 43758.5453), 1.0);
            private property <int> voltas: 3 + Math.mod(i * 31, 3);
            private property <length> comp: 12px + 20px * self.r1;
            private property <float> fy: Math.mod(self.r3 + root.t * self.voltas, 1.0);
            private property <length> x0: self.r2 * (parent.width + root.vento * parent.height) - root.vento * parent.height;
            y: self.fy * (parent.height + self.comp) - self.comp;
            x: self.x0 + root.vento * self.y;
            width: 1px;
            height: self.comp;
            transform-rotation: -Math.atan(root.vento);
            // Some perto das bordas da area (so quando ela nao e a tela toda).
            private property <float> fx: (self.x + 0.5px) / max(1px, parent.width);
            private property <float> borda: parent.inteira ? 1.0 : min(1.0, min(self.fx, 1.0 - self.fx) * 8.0) * min(1.0, (1.0 - self.fy) * 5.0);
            opacity: max(0.0, self.borda) * (0.16 + 0.26 * self.r1);
            background: @linear-gradient(180deg, #dce8ff00 0%, #dce8ff 100%);
        }

        for i in root.n-perto: Rectangle {
            private property <float> r1: Math.mod(Math.abs(Math.sin((i + 1) * 93.989 * 1rad) * 43758.5453), 1.0);
            private property <float> r2: Math.mod(Math.abs(Math.sin((i + 1) * 26.651 * 1rad) * 43758.5453), 1.0);
            private property <float> r3: Math.mod(Math.abs(Math.sin((i + 1) * 54.337 * 1rad) * 43758.5453), 1.0);
            private property <int> voltas: 5 + Math.mod(i * 17, 3);
            private property <length> comp: 44px + 46px * self.r1;
            private property <float> fy: Math.mod(self.r3 + root.t * self.voltas, 1.0);
            private property <length> x0: self.r2 * (parent.width + root.vento * parent.height) - root.vento * parent.height;
            y: self.fy * (parent.height + self.comp) - self.comp;
            x: self.x0 + root.vento * self.y;
            width: 2px;
            height: self.comp;
            border-radius: 1px;
            transform-rotation: -Math.atan(root.vento);
            opacity: 0.30 + 0.25 * self.r1;
            background: @linear-gradient(180deg, #ffffff00 0%, #eef4ff 100%);
        }
    }
}

// Acabamento estrelado (Travessia): fio violeta, clarao de cima e cinco
// estrelas cintilando no fundo da peca. As posicoes sao fixas por peca para
// nao "dancarem" quando o painel muda de tamanho.
export component Estrelado {
    in property <length> radius: 0px;
    private property <bool> ligado: false;
    init => { self.ligado = true; }
    width: 100%;
    height: 100%;
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(180deg, Theme.border-highlight.with-alpha(0.16) 0%, transparent 35%);
        border-width: 1px;
        border-color: Theme.border-highlight;
    }
    for i in 5: Rectangle {
        private property <float> fx: [0.12, 0.34, 0.58, 0.81, 0.93][i];
        private property <float> fy: [0.22, 0.70, 0.18, 0.55, 0.30][i];
        x: parent.width * self.fx;
        y: parent.height * self.fy;
        width: 2px; height: 2px; border-radius: 1px;
        background: Theme.accent;
        opacity: root.ligado && Theme.cena-viva ? 0.1 : 0.55;
        animate opacity {
            duration: 1300ms + i * 470ms; delay: i * 300ms;
            iteration-count: -1; direction: alternate; easing: ease-in-out;
        }
    }
}

// Acabamento neon: aresta acesa na cor secundaria e cantoneiras de HUD na cor
// de destaque. O brilho de fora fica no hospedeiro (`drop-shadow`), porque um
// filho recortado nao desenha para fora do painel.
export component Neon {
    in property <length> radius: 0px;
    // Pecas pequenas (chip, item de menu) ficam so com a aresta.
    private property <bool> cantos: root.width > 90px && root.height > 44px;
    private property <length> perna: min(16px, root.height / 3);

    width: 100%;
    height: 100%;

    // Halo interno: a luz vaza um pouco para dentro da aresta.
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        border-width: 3px;
        border-color: Theme.border-highlight.with-alpha(0.10);
    }
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.border-highlight.with-alpha(0.55);
    }
    // Cantoneiras: duas pernas de 2 px em cada canto, como a mira de um HUD.
    if root.cantos: Rectangle { x: 0; y: 0; width: root.perna; height: 2px; background: Theme.accent; }
    if root.cantos: Rectangle { x: 0; y: 0; width: 2px; height: root.perna; background: Theme.accent; }
    if root.cantos: Rectangle { x: parent.width - root.perna; y: parent.height - 2px; width: root.perna; height: 2px; background: Theme.accent; }
    if root.cantos: Rectangle { x: parent.width - 2px; y: parent.height - root.perna; width: 2px; height: root.perna; background: Theme.accent; }
}

// Acabamento adesivo: contorno grosso. A sombra dura deslocada fica no
// hospedeiro, pelo mesmo motivo do brilho do neon.
export component Adesivo {
    in property <length> radius: 0px;
    width: 100%;
    height: 100%;
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        border-width: 2px;
        border-color: Theme.border-highlight;
    }
}

// Cena "Travessia": a madrugada ate o amanhecer, atras da interface.
//
// Camadas de tras para frente: tres ceus que se fundem pela hora, estrelas que
// cintilam e derivam, estrela cadente, colinas em dois planos, nevoa, e faroes
// de um carro atravessando a estrada. Tudo e transformacao de quadrilatero ou
// opacidade -- nada de giro nem desfoque por quadro, que custariam GPU atras do
// jogo. Com `cena-viva` falso as animacoes nao rodam.
export component CenaTravessia inherits Rectangle {
    clip: true;
    private property <bool> ligado: false;
    private property <bool> vivo: Theme.cena-viva && self.ligado;
    private property <float> h: Theme.cena-hora;
    init => { self.ligado = true; }

    // --- ceu: a hora escolhe a mistura ---
    Image { width: 100%; height: 100%; source: Theme.cena-camada-1; image-fit: cover; }
    Image {
        width: 100%; height: 100%; source: Theme.cena-camada-2; image-fit: cover;
        opacity: clamp(root.h * 2.0, 0.0, 1.0);
        animate opacity { duration: 4s; easing: ease-in-out; }
    }
    Image {
        width: 100%; height: 100%; source: Theme.cena-camada-3; image-fit: cover;
        opacity: clamp(root.h * 2.0 - 1.0, 0.0, 1.0);
        animate opacity { duration: 4s; easing: ease-in-out; }
    }

    // --- estrelas: o ceu gira sem parar e emenda sem costura ---
    // Dois ladrilhos identicos lado a lado; quando o primeiro sai inteiro pela
    // esquerda o laco recomeca e o segundo esta exatamente onde o primeiro
    // estava. Cada estrela cintila no proprio ritmo por cima disso.
    estrelas := Rectangle {
        width: root.width * 2;
        height: root.height * 0.72;
        x: root.vivo ? -root.width : 0px;
        animate x { duration: 420s; iteration-count: -1; easing: linear; }
        opacity: 1.0 - clamp(root.h * 1.4 - 0.2, 0.0, 0.95);
        animate opacity { duration: 4s; }
        for i in 220: Rectangle {
            private property <int> j: Math.mod(i, 110);
            private property <float> r: Math.mod(self.j * 7919, 1000) / 1000.0;
            private property <length> tam: self.r > 0.9 ? 3px : (self.r > 0.6 ? 2px : 1.5px);
            x: (Math.mod(self.j * 397, 1000) / 1000.0 + (i >= 110 ? 1.0 : 0.0)) * root.width;
            y: Math.mod(self.j * 619, 1000) / 1000.0 * parent.height;
            width: self.tam; height: self.tam;
            border-radius: self.tam / 2;
            background: self.r > 0.8 ? #ffffff : #d8ccff;
            opacity: root.vivo ? 0.25 + 0.35 * self.r : 0.9;
            animate opacity {
                duration: 1400ms + Math.mod(self.j * 131, 2600) * 1ms;
                delay: Math.mod(self.j * 57, 1500) * 1ms;
                iteration-count: -1; direction: alternate; easing: ease-in-out;
            }
        }
    }

    // --- estrela cadente: ponto e angulo novos a cada vez, so no alto do ceu ---
    // Rastro e caminho saem do MESMO angulo, em pixels: a estrela anda na
    // direcao do proprio risco, com a cabeca na frente.
    private property <int> semente: 1;
    private property <float> cadente: 0.0;
    private property <bool> cadente-volta: false;
    // Velocidade constante (~750 px/s): uma queda longa demora mais que uma curta.
    animate cadente { duration: root.cadente-volta ? 0ms : root.c-dist / 750px * 1s; easing: ease-in; }
    // Onde nasce: largura inteira, altura so ate a linha de 40% do ceu.
    private property <length> c-x0: (0.15 + 0.80 * Math.mod(root.semente * 7919, 1000) / 1000.0) * root.width;
    private property <length> c-y0: (0.03 + 0.30 * Math.mod(root.semente * 3571, 1000) / 1000.0) * root.height;
    // Angulo de 18 a 40 graus abaixo da horizontal, sempre descendo para a esquerda.
    private property <angle> c-ang: (18 + Math.mod(root.semente * 1237, 23)) * 1deg;
    // Cai ate o chao: o caminho termina atras das colinas, que sao desenhadas
    // por cima e escondem o fim da queda.
    private property <length> c-dist: (root.height * 0.82 - root.c-y0) / Math.sin(root.c-ang);
    Timer {
        // Intervalo variado: 9 a 19 s.
        interval: (9000 + Math.mod(root.semente * 4099, 10000)) * 1ms;
        running: root.vivo && root.h < 0.8;
        triggered => {
            root.cadente-volta = true; root.cadente = 0.0;
            root.semente += 1;
            root.cadente-volta = false; root.cadente = 1.0;
            volta-cadente.running = true;
        }
    }
    volta-cadente := Timer {
        interval: 3200ms;
        running: false;
        triggered => { self.running = false; root.cadente-volta = true; root.cadente = 0.0; }
    }
    Rectangle {
        private property <length> comp: 150px;
        // Posicao da cabeca ao longo do caminho.
        private property <length> hx: root.c-x0 - root.c-dist * Math.cos(root.c-ang) * root.cadente;
        private property <length> hy: root.c-y0 + root.c-dist * Math.sin(root.c-ang) * root.cadente;
        width: self.comp; height: 2px;
        // O retangulo gira em volta do proprio centro: o centro fica meio
        // rastro atras da cabeca, na direcao contraria ao movimento.
        x: self.hx + self.comp / 2 * Math.cos(root.c-ang) - self.comp / 2;
        y: self.hy - self.comp / 2 * Math.sin(root.c-ang) - 1px;
        transform-rotation: -root.c-ang;
        opacity: root.cadente > 0.02 && root.cadente < 0.99 ? 0.95 * (1.0 - root.cadente * 0.35) : 0.0;
        background: @linear-gradient(90deg, #ffffff 0%, #c4a6ffaa 25%, transparent 100%);
    }

    // --- colinas: a de tras mexe menos, a da frente mais -- e a profundidade ---
    Image {
        x: root.vivo ? -18px : 0px; y: 0;
        width: parent.width + 36px; height: parent.height;
        source: Theme.cena-camada-4; image-fit: fill;
        animate x { duration: 60s; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    }
    nevoa := Image {
        x: root.vivo ? -parent.width : 0px;
        y: parent.height * 0.62;
        width: parent.width * 2; height: parent.height * 0.28;
        source: Theme.cena-camada-6; image-fit: fill;
        animate x { duration: 120s; iteration-count: -1; direction: alternate; easing: linear; }
    }
    perto := Image {
        x: root.vivo ? -40px : 0px; y: 0;
        width: parent.width + 80px; height: parent.height;
        source: Theme.cena-camada-5; image-fit: fill;
        animate x { duration: 60s; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    }

    // --- farois: um carro atravessando a estrada, do horizonte ate perto ---
    private property <float> carro: 0.0;
    private property <bool> carro-volta: false;
    animate carro { duration: root.carro-volta ? 0ms : 9s; easing: ease-in; }
    Timer {
        interval: 22s;
        running: root.vivo;
        triggered => { root.carro-volta = false; root.carro = 1.0; volta-carro.running = true; }
    }
    volta-carro := Timer {
        interval: 9500ms;
        running: false;
        triggered => { self.running = false; root.carro-volta = true; root.carro = 0.0; }
    }
    // Mesma curva da estrada desenhada em `colinas-perto`, em fracao da tela.
    private property <float> t: root.carro;
    private property <float> base: 0.83;
    Rectangle {
        private property <length> tam: 3px + 12px * root.t * root.t;
        x: perto.x + parent.width * (0.58 + Math.sin(root.t * 3.2 * 1rad) * 0.047 * (1.0 - root.t) - 0.156 * root.t * root.t) - self.tam;
        y: parent.height * (root.base + 0.0185 + (1.0 - root.base - 0.0185) * Math.pow(root.t, 1.4)) - self.tam;
        width: self.tam * 2; height: self.tam;
        opacity: root.carro > 0.01 && root.carro < 0.99 ? 1.0 : 0.0;
        Rectangle {
            x: 0; width: parent.height; height: parent.height; border-radius: self.width / 2;
            background: #fff4d6; drop-shadow-color: #ffd9a6; drop-shadow-blur: 10px;
        }
        Rectangle {
            x: parent.width - parent.height; width: parent.height; height: parent.height; border-radius: self.width / 2;
            background: #fff4d6; drop-shadow-color: #ffd9a6; drop-shadow-blur: 10px;
        }
    }
}

export component Glass {
    in property <length> radius: 0px;
    in property <bool> bottom: true;

    width: 100%;
    height: 100%;

    // A ordem e a da luz atravessando o material: primeiro o fosco que espalha,
    // depois o brilho que cai sobre ele, depois a orla que torce, e por fim o
    // contorno. Trocar a ordem poe o brilho por baixo do fosco e apaga os dois.
    Frost { radius: root.radius; }
    Gloss { radius: root.radius; }
    if Theme.material-kind == 0: Rim { radius: root.radius; }
    if Theme.material-kind == 2: Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(155deg, #ffffff18 0%, transparent 18%,
            transparent 84%, #ffffff0a 100%);
        opacity: Theme.gloss;
    }
    // Aero: a aurora e a moldura dupla; os outros materiais, a aresta simples.
    if Theme.material-kind == 1: Aurora { radius: root.radius; }
    if Theme.material-kind == 1: MolduraAero { radius: root.radius; }
    if Theme.material-kind != 1 && Theme.acabamento == 0: GlassEdge {
        radius: root.radius;
        bottom: root.bottom;
    }
    if Theme.acabamento == 1: Neon { radius: root.radius; }
    if Theme.acabamento == 2: Adesivo { radius: root.radius; }
    // Sonho: sem aresta nenhuma; so uma luz leitosa descendo do topo, como
    // lembranca fora de foco.
    if Theme.acabamento == 3: Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(180deg, #ffffff66 0%, #ffffff14 40%, transparent 100%);
    }
    if Theme.acabamento == 4: Estrelado { radius: root.radius; }
}


// Diz que a lista continua alem da borda.
//
// Uma lista rolavel que termina em corte reto no meio de um texto nao le como
// "há mais abaixo": le como defeito de desenho. O degrade resolve isso sem
// ocupar altura -- ele e desenhado por cima do conteudo, na propria faixa que
// seria cortada.
//
// A cor de base e obrigatoria porque o degrade tem de morrer exatamente na
// superficie que esta atras: o fundo da pagina, o da barra lateral e o do
// painel sao tokens diferentes, e adivinhar qual deles seria errar em dois
// dos tres casos.
//
// Nao intercepta ponteiro e nao entra em layout, pelo mesmo motivo que o
// `Glass`: e um filho solto, declarado depois do conteudo que encobre.
// A raiz cobre o hospedeiro inteiro e nao pinta nada; quem pinta e a faixa
// interna, que se ancora na base. A raiz de um componente nao enxerga `parent`
// em Slint, entao a ancoragem tem de acontecer um nivel abaixo.
export component ScrollFade {
    in property <brush> base;
    // Ligado por quem hospeda: um degrade permanente mentiria numa lista curta,
    // que nao tem nada alem da borda.
    in property <bool> active: true;

    width: 100%;
    height: 100%;

    // **So quando o tema nao pinta imagem de fundo.**
    //
    // Este degrade termina na cor que o hospedeiro passa em `base`, quase sempre
    // `Theme.background`. Isso e verdade num tema de cor chapada e mentira num
    // tema com `background.image`: ali quem esta atras do conteudo e a imagem, e
    // a cor do token so aparece por transparencia. No Aquario o resultado era uma
    // tira azul-claro de 22px desenhada sobre a agua verde, colada acima da barra
    // de reproducao -- exatamente com a cara de componente fora do lugar.
    //
    // Nao ha cor honesta para fechar um degrade sobre imagem arbitraria, entao a
    // resposta e nao desenhar. O que se perde e o aviso de "ha mais abaixo" nos
    // temas com imagem; o que se ganha e nao afirmar uma cor que nao esta ali.
    Rectangle {
        width: 100%;
        height: Theme.space-lg;
        y: parent.height - self.height;
        visible: root.active && Theme.background-image.width == 0 && Theme.material-kind != 2;
        background: @linear-gradient(180deg, transparent 0%, root.base 100%);
    }
}

export component PressableArea inherits FocusScope {
    // Area acionavel por mouse e teclado, com foco visivel e semantica para
    // tecnologias assistivas.
    in property <bool> enabled-input: true;
    in property <length> focus-radius: Theme.radius-sm;
    out property <bool> has-hover: pointer.has-hover;
    out property <bool> pressed: pointer.pressed;
    out property <bool> highlighted: pointer.has-hover && root.enabled-input;
    callback clicked();
    callback double-clicked();
    // Pedido de menu de contexto, em coordenadas do proprio elemento.
    //
    // Nasce aqui e nao em cada chamador porque o `TouchArea` e interno: sem
    // isto o botao direito morreria dentro do componente. O mesmo callback
    // atende a tecla Menu, para que quem navega por teclado chegue ao mesmo
    // lugar sem mouse.
    callback context-menu-requested(x: length, y: length);

    enabled: root.enabled-input;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-enabled: root.enabled-input;
    accessible-action-default => {
        if (root.enabled-input) { root.clicked(); }
    }

    key-pressed(event) => {
        if (root.enabled-input && (event.text == Key.Return || event.text == Key.Space)) {
            root.clicked();
            return EventResult.accept;
        }
        // A tecla Menu e tratada aqui dentro, e nao por quem usa o componente:
        // um `key-pressed` na instancia substituiria este bloco inteiro e
        // levaria junto o Return e o Espaco.
        if (root.enabled-input && event.text == Key.Menu) {
            root.context-menu-requested(root.width / 2, root.height / 2);
            return EventResult.accept;
        }
        EventResult.reject
    }

    Rectangle {
        border-width: root.has-focus ? Theme.border-width * 2 : 0px;
        border-color: Theme.focus-ring;
        border-radius: root.focus-radius;
    }

    pointer := TouchArea {
        mouse-cursor: root.enabled-input ? MouseCursor.pointer : MouseCursor.default;
        enabled: root.enabled-input;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        // O `clicked` do Slint e so o botao esquerdo; o direito so chega por
        // aqui. O foco vai junto para que Escape e as setas continuem valendo
        // depois que o menu fechar.
        pointer-event(event) => {
            if (root.enabled-input
                && event.kind == PointerEventKind.down
                && event.button == PointerEventButton.right) {
                root.focus();
                root.context-menu-requested(pointer.mouse-x, pointer.mouse-y);
            }
        }
    }
}

// Reflexo de superficie por familia. Legacy preserva as folhas antigas;
// Aero usa gel vetorial e Liquid usa luz discreta. Gloss controla intensidade.
export component Material inherits Rectangle {
    in property <length> radius: 0px;
    /// Quanto da folha entra. Peca pequena aguenta menos que painel grande.
    in property <float> forca: 1.0;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    clip: true;

    if Theme.material-kind == 1: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        // Duas metades, com a troca seca em 45%: e a capsula do botao do
        // Windows 7 (7.css: `#f2f2f2 45%, #ebebeb 45%, #cfcfcf`). A metade de
        // cima e clara, a de baixo escurece um fio ate a base.
        background: @linear-gradient(180deg, #ffffffa6 0%, #ffffff80 45%,
            #ffffff1f 45.5%, #ffffff0a 80%, #00000014 100%);
        border-width: Theme.border-width;
        border-color: Theme.border-highlight;
        opacity: root.forca * Theme.gloss;
    }

    if Theme.material-kind == 2: Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        border-width: Theme.border-width;
        border-color: Theme.border-highlight;
        background: @linear-gradient(165deg, #ffffff44 0%, #ffffff06 22%,
            transparent 65%, #ffffff1a 100%);
        opacity: root.forca * Theme.gloss;
    }

    if Theme.material-kind == 0 && Theme.gloss >= 0.62: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: @image-url("materiais/gel.png");
        opacity: root.forca;
        animate opacity { duration: Theme.motion-fast; easing: ease; }
    }

    if Theme.material-kind == 0 && Theme.gloss >= 0.20 && Theme.gloss < 0.62: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: @image-url("materiais/vidro.png");
        opacity: root.forca;
        animate opacity { duration: Theme.motion-fast; easing: ease; }
    }
}

// A varredura especular das pecas redondas.
//
// Rampa nao serve num circulo: numa esfera a luz e um ovalo deslocado para o
// alto e para a esquerda, com a orla devolvendo luz em volta. E a diferenca
// entre "botao brilhante" e "botao esferico", e o botao de tocar e a unica peca
// grande e redonda da interface -- e onde o olho pousa.
export component MaterialRedondo inherits Rectangle {
    in property <float> forca: 1.0;

    width: 100%;
    height: 100%;

    if Theme.material-kind == 2: Rectangle {
        width: 100%; height: 100%;
        border-radius: self.width / 2;
        background: @linear-gradient(155deg, #ffffff88 0%, #ffffff10 42%,
            transparent 60%, #ffffff33 100%);
        opacity: root.forca * Theme.gloss;
    }
    if Theme.material-kind != 2 && Theme.gloss >= 0.20: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: @image-url("materiais/reflexo.png");
        opacity: root.forca * (Theme.gloss >= 0.62 ? 1.0 : 0.55);
    }
}

/// Dois icones no mesmo lugar, trocando por estado: play/pause, mudo.
///
/// O Slint nao interpola `Path.commands`, entao o "morph" e o que o sistema da
/// Apple faz na troca de simbolo: o que sai encolhe e some, o que entra cresce
/// e aparece, os dois ao mesmo tempo. Duas `Path` de 24x24 -- nada por quadro
/// fora dos 120 ms da troca.
export component IconSwap {
    in property <IconRef> off;
    in property <IconRef> on;
    in property <bool> state;
    in property <brush> tint: Theme.text;
    in property <length> size: Theme.control-icon-size;
    in property <bool> filled: false;

    width: root.size;
    height: root.size;

    Icon {
        glyph: root.off;
        tint: root.tint;
        size: root.size;
        filled: root.filled;
        opacity: root.state ? 0.0 : 1.0;
        transform-scale: root.state ? 0.5 : 1.0;
        animate opacity, transform-scale { duration: Theme.motion-fast; easing: ease-out; }
    }
    Icon {
        glyph: root.on;
        tint: root.tint;
        size: root.size;
        filled: root.filled;
        opacity: root.state ? 1.0 : 0.0;
        transform-scale: root.state ? 1.0 : 0.5;
        animate opacity, transform-scale { duration: Theme.motion-fast; easing: ease-out; }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    in property <IconRef> glyph;
    in property <length> button-size: Theme.control-button-size;
    in property <length> icon-size: Theme.control-icon-size;
    in property <brush> tint: Theme.text;
    in property <bool> filled: false;
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    /// Para quem revela o botao so no hover: sem isto, um botao com opacidade
    /// zero continua no caminho do Tab e o foco desaparece da tela.
    out property <bool> has-focus: touch.has-focus;
    /// Ativo sem pintar o fundo.
    ///
    /// Existe para nao ter de escolher entre acessibilidade e ruido visual:
    /// numa lista de curtidas, `active` em cem coracoes desenha cem caixinhas
    /// coloridas, mas tirar `active` tiraria junto o `accessible-checked` que
    /// diz ao leitor de tela que a faixa esta curtida. Com isto o estado
    /// continua sendo anunciado e quem mostra que esta marcado e o proprio
    /// icone, cheio em vez de contornado.
    in property <bool> quiet: false;
    callback clicked();

    width: root.button-size;
    height: root.button-size;
    border-radius: min(Theme.control-button-radius, root.button-size / 2);
    // **Ativo e pastilha cheia de `accent`, com o icone em `text-on-accent`.**
    //
    // Duas tentativas antes desta, e a homologacao mediu as duas:
    //
    // 1. Fundo `selected` com icone `accent`. Depois que `selected` passou a
    //    derivar do accent, virou accent atras de accent.
    // 2. Sem fundo, so o icone em `accent`. Resolveu a colisao e criou outra: no
    //    Aquario, o `#2fc0ee` do aleatorio ligado contra a barra quase branca
    //    ficou em **2.06:1**, e a WCAG 1.4.11 pede 3:1 para elemento grafico. O
    //    estado "ligado" existia e quase nao se via.
    //
    // Pastilha cheia resolve os dois por construcao, pelo mesmo argumento do
    // `GhostButton`: `text_on_accent` existe no contrato para ser lido sobre
    // `accent`, e todo tema o declara com folga. E o desenho que um interruptor
    // pede -- ligado e cheio.
    //
    // `quiet` continua fora disto: numa biblioteca de curtidas, cem coracoes
    // ligados virariam cem pastilhas.
    background: root.active && !root.quiet
        ? (Theme.material-kind == 1 ? #ffffff55 : Theme.accent)
        : (touch.has-hover && root.enabled ? Theme.hover : transparent);
    border-width: Theme.material-kind == 1 && root.active && !root.quiet ? 1px : 0px;
    border-color: Theme.text.with-alpha(0.32);
    opacity: !root.enabled ? 0.4 : (Theme.material-kind > 0 && touch.pressed ? 0.82 : 1.0);

    animate background { duration: Theme.motion-fast; easing: ease; }

    Icon {
        glyph: root.glyph;
        // `quiet` tambem tira o accent do icone, e nao so o fundo do botao. Era
        // aqui que os cem coracoes de uma biblioteca de curtidas viravam cem
        // manchas na cor de destaque: quem esta ativo pinta de accent, e curtir
        // e a regra e nao a excecao numa lista de curtidas. Quem quer o accent
        // continua tendo -- basta nao pedir `quiet`.
        tint: root.active && !root.quiet
            ? (Theme.material-kind == 1 ? Theme.text : Theme.text-on-accent) : root.tint;
        size: root.icon-size;
        filled: root.filled;
        // Resposta no toque, antes de a rede voltar: o icone afunda ao apertar
        // e volta passando um pouco do tamanho -- o "pulo" que faz curtir e
        // silenciar parecerem fisicos. Escala so do desenho, nao do botao: a
        // area de clique e o layout ficam parados. Zera com `motion-fast`.
        transform-scale: touch.pressed && root.enabled ? 0.84 : 1.0;
        animate transform-scale {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }
    }

    // No Aero o botao sob o cursor vira a capsula do Windows 7, com a borda
    // azul e as duas metades. Fora do cursor nao ha nada, como no original.
    if Theme.material-kind == 1 && root.enabled && (touch.has-hover || (root.active && !root.quiet)): Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        border-width: Theme.border-width;
        border-color: Theme.accent.darker(0.35);
        Material { radius: root.border-radius; }
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        accessible-checkable: root.checkable;
        accessible-checked: root.active;
        focus-radius: min(Theme.control-button-radius, root.button-size / 2);
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }

    // Rotulos visuais preservam a limpeza dos controles por icone, mas tiram
    // do usuario a obrigacao de adivinhar botoes menos universais.
    //
    // Com meio segundo de espera: sem ele, varrer a barra do player com o
    // cursor abria seis rotulos seguidos. Quem para em cima de um botao ve o
    // nome; quem so passa nao ve nada piscar.
    private property <bool> tooltip-devida: false;
    espera-tooltip := Timer {
        interval: 500ms;
        running: touch.has-hover && root.label != "" && !root.tooltip-devida;
        triggered => { root.tooltip-devida = true; }
    }
    if touch.has-hover && root.tooltip-devida && root.label != "": Rectangle {
        z: 20;
        x: (root.width - self.width) / 2;
        y: -self.height - Theme.space-xs;
        width: min(280px, tooltip-text.preferred-width + Theme.space-md * 2);
        height: Theme.control-tooltip-height;
        border-radius: Theme.radius-sm;
        background: Theme.surface-raised;
        border-width: Theme.border-width;
        border-color: Theme.border;

        Glass { radius: Theme.radius-sm; }

        tooltip-text := Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Materiais sobre a cena do tema. A fonte e o wallpaper, nunca a UI composta.
// Lente da cena conhecida. O piso colorido protege texto mesmo sobre foto clara.
// Apenas o chrome usa este componente; nao le conteudo nem pixels da tela.
export component SceneGlass inherits Rectangle {
    in property <length> radius: Theme.radius-lg;
    in property <brush> tint: Theme.sidebar-background;
    width: 100%; height: 100%;
    border-radius: root.radius;
    clip: true;
    background: Theme.background-image.width > 0 ? Theme.background : transparent;
    // Brilho do neon e sombra dura do adesivo: por fora do painel.
    drop-shadow-color: Theme.acabamento == 1 ? Theme.border-highlight.with-alpha(0.28)
        : Theme.acabamento == 2 ? Theme.accent.with-alpha(0.85)
        : transparent;
    drop-shadow-blur: Theme.acabamento == 1 ? 18px : Theme.acabamento == 3 ? 36px : 0px;
    drop-shadow-offset-x: Theme.acabamento == 2 ? 4px : 0px;
    drop-shadow-offset-y: Theme.acabamento == 2 ? 4px : 0px;
    lens := Image {
        width: 100%; height: 100%;
        image-fit: fill;
        source: Theme.refract-background(Theme.background-image, {
            x: root.absolute-position.x / 1px, y: root.absolute-position.y / 1px,
            width: root.width / 1px, height: root.height / 1px,
            radius: root.radius / 1px,
            window-width: Theme.window-width / 1px,
            window-height: Theme.window-height / 1px, fit: Theme.background-fit
        });
        opacity: Theme.background-opacity;
    }
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        background: Theme.background-image.width > 0
            ? Theme.glass-tint(lens.source, root.tint) : transparent;
    }
    // Com acabamento o painel e cheio: a cor do tema por cima da lente.
    if Theme.acabamento > 0: Rectangle {
        width: 100%; height: 100%;
        border-radius: root.radius;
        background: root.tint;
    }
    Glass { radius: root.radius; }
}

export component Vidro inherits Rectangle {
    in property <length> radius: 0px;
    /// Quanto do fundo borrado aparece. O resto e a superficie do tema.
    in property <float> forca: 1.0;
    /// A cor do vidro, pintada POR CIMA do borrao. So o Aero usa: no Windows 7
    /// o vidro e azul porque a cor vem depois do desfoque, e nao por baixo
    /// dele -- por baixo, o borrao a cobriria.
    in property <brush> tinta: transparent;

    width: 100%;
    height: 100%;
    border-radius: root.radius;
    // No Aero quem recorta e o painel: um `clip` a menos por quadro.
    clip: Theme.material-kind != 1;

    // Escala do `cover`: a maior das duas, para a imagem cobrir a janela
    // inteira sem deixar borda.
    private property <float> escala-x: Theme.window-width / (Theme.background-blurred.width * 1px);
    private property <float> escala-y: Theme.window-height / (Theme.background-blurred.height * 1px);
    private property <float> escala: max(root.escala-x, root.escala-y);

    // Quanto sobrou para fora da janela, de um lado so. `cover` centraliza, e e
    // por isso que a metade do que sobrou e o deslocamento.
    private property <length> sobra-x: (Theme.background-blurred.width * 1px * root.escala - Theme.window-width) / 2;
    private property <length> sobra-y: (Theme.background-blurred.height * 1px * root.escala - Theme.window-height) / 2;

    // **Piso opaco, por baixo do borrao.**
    //
    // Com o borrao vivo, o que se copia e o quadro do proprio aplicativo -- e
    // onde ele nao desenhou nada, o pixel e transparente. Transparente entra na
    // media do desfoque como PRETO, entao um painel sobre area vazia ficava com
    // um borrao escuro em vez do que ha atras. Foi o que apareceu no Bruma.
    //
    // A cor do tema por baixo resolve: onde a copia nao tem conteudo, o que se
    // ve e o fundo do tema, que e o que estaria ali de qualquer modo.
    if Theme.material-kind == 0 && Theme.background-blurred.width > 0: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;
        opacity: root.forca;
        animate opacity { duration: Theme.motion-fast; easing: ease; }
    }

    // A condicao nao olha a forca, so a existencia da imagem: quem controla o
    // quanto e a opacidade, e ela precisa poder ir de zero ate o valor cheio
    // sem o elemento nascer e morrer no meio -- senao o realce de cursor
    // apareceria de estalo em vez de acender.
    if Theme.material-kind != 2 && Theme.background-blurred.width > 0: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: Theme.background-blurred;
        opacity: root.forca;
        animate opacity { duration: Theme.motion-fast; easing: ease; }

        // Da posicao na janela para posicao na imagem: soma o que sobrou fora
        // da janela e divide pela ampliacao.
        source-clip-x: (parent.absolute-position.x + root.sobra-x) / root.escala / 1px;
        source-clip-y: (parent.absolute-position.y + root.sobra-y) / root.escala / 1px;
        source-clip-width: root.width / root.escala / 1px;
        source-clip-height: root.height / root.escala / 1px;
    }

    if Theme.material-kind == 1: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: root.tinta;
        opacity: root.forca;
        animate opacity { duration: Theme.motion-fast; easing: ease; }
    }
}

// Realce de item: Liquid usa cor e preserva o plano do conteudo.
// Legacy e Aero mantem o corpo e a iluminacao do item.
export component Realce inherits Rectangle {
    in property <length> radius: 0px;
    /// Quanto do realce esta aceso. Anima sozinho.
    in property <float> aceso: 0.0;
    /// Deixa o fundo aparecer atraves. Desligue dentro de outra peca de vidro.
    in property <bool> com-vidro: true;

    width: 100%;
    height: 100%;
    border-radius: root.radius;

    // `surface`, e nao `surface-raised`.
    //
    // `surface-raised` e a peca mais clara do tema -- 42% de branco no Bruma --
    // e usar isso num realce de passagem dava o contraste mais forte da tela
    // para a coisa mais passageira dela. `surface` e a superficie normal de uma
    // peca, que e o que a linha sob o cursor vira.
    background: Theme.material-kind == 2 ? Theme.selected : (Theme.material-kind == 1 ? Theme.hover : Theme.surface);
    border-width: root.aceso > 0 && Theme.material-kind != 2 ? Theme.border-width : 0px;
    border-color: Theme.material-kind == 1 ? Theme.accent.with-alpha(0.6) : Theme.border-highlight;
    // No Aero o realce e a capsula inteira do Windows 7, nao um veu: quem
    // chama pede 0,30 para todos os materiais, e aqui isso vira a capsula cheia.
    opacity: Theme.material-kind == 1 ? min(1.0, root.aceso * 3.0) : root.aceso;
    animate opacity { duration: Theme.motion-fast; easing: ease; }

    // Sombra curta, e nao a do cartao: uma linha de lista sobe um fio, nao
    // flutua. Sombra grande numa lista de cinquenta linhas viraria sujeira.
    drop-shadow-color: root.aceso > 0 && Theme.material-kind != 2
        ? (Theme.background.to-hsv().value > 0.5 ? #00000014 : #00000040)
        : #00000000;
    drop-shadow-blur: 6px;
    drop-shadow-offset-y: 1px;

    // So no material antigo. No Aero o realce e a capsula, que ja cobre o
    // fundo -- e cada `Vidro` e mais uma copia da textura do fundo no driver
    // de video: com um por linha de lista, eram 160 copias e 5 GB reservados.
    if root.com-vidro && Theme.material-kind == 0: Vidro {
        radius: root.radius;
        forca: root.aceso * 0.55;
    }

    // Neon: a linha sob o cursor ganha uma barra acesa na esquerda, que cresce
    // do meio para as pontas.
    if Theme.acabamento == 1: Rectangle {
        x: 0;
        width: 3px;
        height: parent.height * min(1.0, root.aceso * 2.5);
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        drop-shadow-color: Theme.accent;
        drop-shadow-blur: 8px;
        animate height, y { duration: Theme.motion-normal; easing: ease-out; }
    }

    if Theme.material-kind != 2: Material {
        radius: root.radius;
        forca: root.aceso;
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: text.preferred-width + Theme.space-lg * 2;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.accent-hover : Theme.accent;
    opacity: !root.enabled ? 0.45 : (Theme.material-kind > 0 && touch.pressed ? 0.82 : 1.0);

    animate background { duration: Theme.motion-fast; easing: ease; }

    Material { radius: Theme.radius-md; }

    text := Text {
        text: root.label;
        color: Theme.text-on-accent;
        font-size: Theme.size-md;
        font-weight: Theme.weight-medium;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        enabled-input: root.enabled;
        accessible-label: root.label;
        focus-radius: Theme.radius-md;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    /// Escolha corrente, quando o botao faz parte de um grupo de opcoes.
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    min-width: text.preferred-width + Theme.space-md * 2;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    // **A opcao escolhida e solida, e nao contorno com texto colorido.**
    //
    // Era `background: selected` com `color: accent`. Ja era arriscado -- dois
    // tons da mesma cor, um atras do outro -- e virou defeito no dia em que
    // `selected` passou a derivar do `accent`: no Aquario o chip "320 kbps" saiu
    // com texto #2fc0ee sobre fundo #2fc0ee a 30%, medidos na captura em
    // **1.39:1**. Ilegivel, e ilegivel em todos os temas ao mesmo tempo, porque
    // a colisao e estrutural e nao de paleta.
    //
    // Preencher com `accent` e escrever com `text-on-accent` resolve por
    // construcao: `text_on_accent` existe no contrato justamente para ser lido
    // sobre `accent`, e os temas de fabrica o declaram com folga -- 7.8:1 no
    // Aquario, 10:1 no Cristal, 8.9:1 no Paper, 6.5:1 no Pulse. E o desenho
    // normal de um grupo de opcoes: o segmento escolhido e cheio.
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active
        ? Theme.accent
        : (touch.has-hover ? Theme.hover : transparent);

    animate background { duration: Theme.motion-fast; easing: ease; }

    text := Text {
        text: root.label;
        color: root.danger
            ? Theme.danger
            : (root.active ? Theme.text-on-accent : Theme.text);
        font-size: Theme.size-sm;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := PressableArea {
        accessible-label: root.label;
        accessible-checkable: root.active;
        accessible-checked: root.active;
        focus-radius: Theme.radius-md;
        clicked => { root.clicked(); }
    }
}

// Interruptor de duas posicoes. Como todo o resto, so tem forma e cor vindas
// do tema: um tema de cantos retos deixa o interruptor retangular.
export component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: min(self.height / 2, Theme.radius-md);
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; easing: ease; }

    knob := Rectangle {
        width: parent.height - 6px;
        height: self.width;
        border-radius: min(self.width / 2, Theme.radius-sm);
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: root.checked ? Theme.text-on-accent : Theme.text-muted;

        animate x { duration: Theme.motion-fast; easing: ease-in-out; }
        animate background { duration: Theme.motion-fast; easing: ease; }
    }

    if root.interactive: PressableArea {
        enabled-input: root.enabled;
        accessible-role: switch;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        focus-radius: min(root.height / 2, Theme.radius-md);
        clicked => {
            if (root.enabled) { root.toggled(!root.checked); }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Buscar";
    callback edited(string);
    callback accepted(string);
    // Poe o cursor no campo. Quem chama e o atalho Ctrl+K: abrir a Busca sem
    // o cursor no campo era meio atalho -- o que se digitava ia para o nada.
    public function focar() { input.focus(); }

    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : Theme.border-width;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;

    Glass { radius: Theme.radius-md; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        Icon {
            glyph: { builtin: @image-url("icones/search.svg") };
            tint: Theme.text-muted;
            size: Theme.control-icon-size;
            y: (parent.height - self.size) / 2;
        }

        Rectangle {
            placeholder := Text {
                text: root.placeholder;
                color: Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-alignment: left;
                visible: input.text == "";
                width: 100%;
            }

            input := TextInput {
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                single-line: true;
                width: 100%;
                height: 100%;
                accessible-label: root.placeholder;
                accessible-placeholder-text: root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

// Trilha arrastavel usada por progresso e volume.
export component Slider inherits Rectangle {
    in property <string> label;
    in property <float> value;          // 0.0 .. 1.0
    in property <bool> enabled: true;
    in property <length> thickness: Theme.progress-thickness;
    // Cor da parte cheia. O progresso da faixa passa `Theme.live-accent`, que
    // acompanha a capa; volume e ajustes ficam no acento fixo do tema.
    in property <brush> fill-color: Theme.accent;
    callback changed(float);
    callback committed(float);
    // Roda do mouse sobre a trilha: um passo por tique, sinal no `delta`.
    callback stepped(float);

    height: max(root.thickness, 16px);
    // A area de toque e maior que o traco desenhado: uma barra de 4px seria
    // dificil de acertar com o mouse.

    // Enquanto o dedo esta na trilha, quem manda no desenho e o ponteiro, e nao
    // o valor que volta do Rust. Sem isto o preenchimento so anda depois da
    // volta pelo estado da aplicacao -- e no caso do progresso ele nem chegava
    // a andar, porque o seek so e enviado ao soltar.
    private property <float> drag-value;
    private property <bool> dragging;
    private property <float> shown: root.dragging
        ? clamp(root.drag-value, 0.0, 1.0)
        : clamp(root.value, 0.0, 1.0);

    // `changed` avisa o Rust enquanto se arrasta, e o mouse dita o ritmo: um
    // mouse gamer reporta ate 1000 posicoes por segundo, e cada aviso atravessa
    // para a thread do motor e reescreve a barra inteira. Sem limite, o gesto
    // gastava mais tempo avisando do que desenhando.
    //
    // 16 ms e um quadro. O desenho nao depende disto -- ele sai de `drag-value`,
    // que continua acompanhando o ponteiro em tempo real -- e volume nao muda
    // de forma audivel mais rapido que um quadro.
    private property <bool> pending;
    throttle := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            if (root.pending) {
                root.pending = false;
                root.changed(root.drag-value);
            } else {
                // Nada novo desde o ultimo aviso: o gesto parou, e manter o
                // temporizador vivo so acordaria a interface a toa.
                self.running = false;
            }
        }
    }

    focus := FocusScope {
        accessible-role: slider;
        accessible-label: root.label;
        accessible-enabled: root.enabled;
        accessible-orientation: horizontal;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;
        accessible-value: round(root.value * 100) + "%";
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.committed(clamp(root.value + 0.05, 0, 1));
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.committed(clamp(root.value - 0.05, 0, 1));
                return EventResult.accept;
            }
            EventResult.reject
        }

        accessible-action-increment => { root.committed(clamp(root.value + 0.05, 0, 1)); }
        accessible-action-decrement => { root.committed(clamp(root.value - 0.05, 0, 1)); }
    }

    Rectangle {
        border-width: focus.has-focus ? Theme.border-width * 2 : 0px;
        border-color: Theme.focus-ring;
        border-radius: Theme.radius-sm;
    }

    track := Rectangle {
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        width: 100%;
        border-radius: root.thickness / 2;
        // Aero: calha afundada -- branco translucido com a borda escura e uma
        // sombra curta no topo, como a barra de progresso do Windows 7.
        background: Theme.material-kind == 1 ? #ffffff59 : Theme.border;
        border-width: Theme.material-kind == 1 ? Theme.border-width : 0px;
        border-color: Theme.border;

        if Theme.material-kind == 1: Rectangle {
            x: Theme.border-width;
            y: Theme.border-width;
            width: parent.width - Theme.border-width * 2;
            height: max(1px, root.thickness / 4);
            background: #00000026;
        }

        fill := Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: root.thickness / 2;
            // Aero: o preenchimento e a cor clara de selecao, como a barra de
            // progresso do Windows 7; o `accent` escuro fica para texto e borda.
            background: Theme.material-kind == 1
                ? Theme.selected.with-alpha(1.0)
                : (touch.has-hover || touch.pressed ? root.fill-color.brighter(0.15) : root.fill-color);
            // `motion-slow` e nao `fast`: a mudanca mais comum aqui e a troca
            // de faixa trocando a cor da capa, uma vez a cada tres minutos -- e
            // uma cor que muda de uma vez parece defeito, nao transicao.
            animate background { duration: Theme.motion-slow; easing: ease-out; }

            // O preenchimento tambem e uma capsula: metade de cima clara.
            if Theme.material-kind == 1: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: parent.border-radius;
                background: @linear-gradient(180deg, #ffffffb3 0%, #ffffff80 50%,
                    #ffffff1a 50.5%, #00000014 100%);
                border-width: Theme.border-width;
                border-color: Theme.border-highlight;
            }
        }
    }

    knob := Rectangle {
        width: Theme.control-slider-knob;
        height: self.width;
        border-radius: self.width / 2;
        // Aero: pastilha branca de vidro com borda escura, nao um ponto de texto.
        background: Theme.material-kind == 1 ? #f3faff : Theme.text;
        border-width: Theme.material-kind == 1 ? Theme.border-width : 0px;
        border-color: Theme.border;
        x: track.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        visible: root.enabled && (touch.has-hover || touch.pressed);
        if Theme.material-kind == 1: Material { radius: parent.border-radius; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        width: 100%;
        height: 100%;

        moved => {
            if (self.pressed) {
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                // Primeiro movimento avisa na hora; os seguintes esperam o
                // quadro. Assim o volume reage ao inicio do gesto sem atraso e
                // mesmo assim nao passa de um aviso por quadro.
                if (throttle.running) {
                    root.pending = true;
                } else {
                    throttle.running = true;
                    root.changed(root.drag-value);
                }
            }
        }
        scroll-event(event) => {
            if (event.delta-y != 0) {
                root.stepped(event.delta-y > 0 ? 0.05 : -0.05);
                return EventResult.accept;
            }
            EventResult.reject
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                focus.focus();
                root.drag-value = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.dragging = true;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.committed(clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
            // Tambem no `cancel`: perder o ponteiro para outra janela nao pode
            // deixar a barra congelada no ultimo lugar arrastado.
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
                // O ultimo movimento nao pode ficar preso no temporizador: o
                // `committed` acima ja mandou o valor final, entao o que sobrou
                // e ruido de um quadro.
                root.pending = false;
                throttle.running = false;
            }
        }
    }
}

// Simbolo da marca.
//
// Reproduz o desenho responsivo de 32 px de
// assets/brand/morune-logo-system/morune-symbol-32.svg, que e um desenho
// proprio e nao uma reducao do master de 512 -- por isso os numeros abaixo nao
// sao os da prancheta grande.
//
// Sao tres tracos de espessura diferente, e o Slint so aceita uma espessura por
// `Path`. Cada traco vira um elemento, e todos precisam enxergar a mesma caixa:
// o Slint encaixa a viewbox em `tamanho - espessura`, entao um elemento mais
// grosso encolheria o desenho e as barras laterais sairiam do lugar. A
// compensacao e dar a cada elemento o tamanho da caixa comum mais a propria
// espessura, centralizado.
export component Logo {
    in property <length> size: 32px;
    in property <brush> tint: Brand.mark;

    // Espessuras do desenho de 32 px: 3, 2 e 1,5 unidades.
    property <length> stroke-wave: root.size * 3 / 32;
    property <length> stroke-bar: root.size * 2 / 32;
    property <length> stroke-dot: root.size * 1.5 / 32;
    // Caixa comum, ditada pelo traco mais grosso.
    property <length> box: root.size - root.stroke-wave;

    width: root.size;
    height: root.size;

    wave := Path {
        width: root.box + root.stroke-wave;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M9 20.5 C9 14.75 9.25 7.25 11.6 7.25 C14.4 7.25 13.9 24.75 16 24.75 C18.1 24.75 17.6 7.25 20.4 7.25 C22.75 7.25 23 14.75 23 20.5";
        stroke: root.tint;
        stroke-width: root.stroke-wave;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-bar;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M5.5 13.5 V18.5 M26.5 13.5 V18.5";
        stroke: root.tint;
        stroke-width: root.stroke-bar;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: root.box + root.stroke-dot;
        height: self.width;
        x: (root.size - self.width) / 2;
        y: self.x;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M3.75 15.25 V16.75 M28.25 15.25 V16.75";
        stroke: root.tint;
        stroke-width: root.stroke-dot;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Marcador de capa. Enquanto nao ha download de imagem, desenha um bloco com a
// inicial do titulo -- deliberadamente estavel para nao causar "pulo" de layout
// quando a capa real chegar.
// Capa de um item, com dois estados de ausencia que nao sao o mesmo.
//
// **Por que a marca saiu daqui.** Antes, tudo que nao tinha imagem virava o
// simbolo do Morune. Numa unica tela de Inicio isso dava **dezenove logos** --
// oito nos cartoes, dez na barra lateral, um no rodape -- e a marca passou a
// significar "faltou alguma coisa". Pior: o mesmo desenho aparecia enquanto a
// capa ainda estava baixando, entao "carregando" e "nao existe" -- que sao o
// oposto um do outro -- eram indistinguiveis.
//
// Agora sao tres estados separados:
//
// | estado | como se sabe | o que aparece |
// |---|---|---|
// | tem capa | `source` chegou | a imagem |
// | ainda chegando | `pending`, capa vazia | superficie neutra, sem simbolo |
// | nao tem capa | nem `source` nem `pending` | ficha gerada: matiz do nome + inicial |
//
// A ficha gerada nao e enfeite. Boa parte das playlists nao tem imagem alguma
// na resposta do Spotify -- o mosaico que o cliente oficial mostra e montado
// por ele a partir das faixas. Repetir o mesmo desenho em todas elas apagava a
// diferenca entre listas; uma cor propria por nome devolve identidade a cada
// uma, e a inicial da o que ler quando o cartao e pequeno demais para o titulo.
export component Artwork inherits Rectangle {
    /// Inicial do nome, ja recortada pelo lado Rust: o Slint nao fatia string.
    in property <string> initial;
    /// Matiz da ficha, 0..360, derivada do nome. Vem pronta do Rust pelo mesmo
    /// motivo -- nao ha como somar os codigos das letras aqui.
    in property <float> hue;
    /// `true` enquanto a capa existe e ainda esta a caminho do cache.
    in property <bool> pending;
    /// Musicas curtidas: nao e playlist e nao tem capa. Ganha a marca que o
    /// Spotify usa -- degrade roxo para verde-agua com o coracao -- para ser
    /// reconhecida de relance entre as playlists.
    in property <bool> curtidas: false;
    // O raio do tema e o de capa GRANDE. Numa miniatura de 32 px, 14 px de
    // raio faziam da capa quase um circulo. Proporcional ate o teto do tema:
    // 32 px -> ~5, 56 px -> ~8, cartao e detalhe -> o raio do tema.
    in property <length> radius: min(Theme.radius-artwork, root.width * 0.15);
    // Capa de verdade. Vazia enquanto ela nao chega do cache, e o bloco neutro
    // abaixo ocupa o lugar sem mudar o layout quando ela chegar.
    in property <image> source;

    // Claro ou escuro sai do proprio tema, e nao de um token novo: o contrato
    // de tema e um conjunto fechado de slots, e ler o valor do fundo responde a
    // mesma pergunta sem abrir mais um.
    private property <bool> claro: Theme.background.to-hsv().value > 0.5;

    border-radius: root.radius;
    background: Theme.surface-raised;
    clip: true;

    // Sem nome nao ha ficha: o rodape sem musica tocando cairia numa cor
    // sorteada do texto vazio, e um quadrado colorido ao lado de "Nada tocando"
    // promete um conteudo que nao existe.
    if !root.curtidas && root.source.width == 0 && !root.pending && root.initial != "": Rectangle {
        // Diagonal, e nao chapado: o gradiente e o que faz vinte fichas lado a
        // lado parecerem capas em vez de vinte retangulos de cor.
        background: @linear-gradient(135deg,
            hsv(root.hue, root.claro ? 0.34 : 0.52, root.claro ? 0.94 : 0.42) 0%,
            hsv(root.hue, root.claro ? 0.24 : 0.44, root.claro ? 0.80 : 0.24) 100%);

        // Capa grande sem imagem ganha a nota musical, como no Spotify: a letra
        // de 45 px numa grade de playlists virava um alfabeto gigante e era a
        // primeira coisa que se via na tela. Na miniatura da lista e da barra
        // lateral a letra continua -- ali ela ajuda a achar a playlist.
        if parent.height >= 64px: Image {
            width: parent.width * 0.34;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icones/nota.svg");
            colorize: root.claro ? hsv(root.hue, 0.45, 0.40) : hsv(root.hue, 0.18, 0.92, 0.85);
        }

        if parent.height < 64px: Text {
            text: root.initial;
            // Acompanha a caixa: a mesma ficha serve a linha de 40px da lista e
            // ao cartao de 160px, e uma inicial de tamanho fixo sumiria numa e
            // estouraria na outra.
            //
            // 0,30 e nao 0,42: a 0,42 uma fileira de oito playlists sem capa
            // virava um alfabeto de letras gigantes, e a letra passava a ser a
            // capa. Ela e etiqueta; quem identifica e a cor.
            font-size: max(12px, parent.height * 0.30);
            font-family: Theme.font-family;
            font-weight: Theme.weight-bold;
            color: root.claro ? hsv(root.hue, 0.55, 0.32) : hsv(root.hue, 0.22, 0.97);
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    if root.curtidas: Rectangle {
        background: @linear-gradient(135deg, #450af5 0%, #8e8ee5 60%, #c4efd9 100%);
        Image {
            width: parent.width * 0.42;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icones/heart-cheio.svg");
            colorize: #ffffff;
        }
    }

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        // A capa e quadrada e a caixa tambem; `fill` evita a borda de fundo
        // aparecer por arredondamento de um pixel.
        image-fit: fill;
    }

    // Contorno de 1px a 10%, por dentro da capa.
    //
    // **Por que preto ou branco puro, e nunca a cor de borda do tema:** um
    // contorno tingido pega a superficie de baixo e aparece como sujeira na
    // beirada da imagem. Puro, ele so separa a capa do fundo -- e e o que da
    // profundidade parelha a vinte capas de cores diferentes lado a lado, que
    // sozinhas nao teriam nenhuma relacao visual entre si.
    //
    // So sobre imagem: a ficha gerada ja tem contraste proprio contra o fundo, e
    // um contorno ali viraria moldura em algo que nao e foto.
    if root.source.width > 0: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: 1px;
        border-color: root.claro ? #0000001a : #ffffff1a;
    }
}

// Avatar da conta: circulo com a inicial.
//
// **Por que uma inicial e nao a foto:** o caminho de login do Morune nao
// entrega foto nem nome de exibicao -- so o identificador da sessao (ver
// `morune-spotify/src/auth.rs`). Desenhar a inicial e o que da forma e cor a um
// dado que, sozinho, e um texto minusculo em cinza.
//
// A cor vem do acento do tema, com o par `text-on-accent` que o contrato de
// tema garante legivel. E o unico elemento saturado do rodape da barra
// lateral, e e de proposito: e ali que a conta se identifica.
export component AccountAvatar inherits Rectangle {
    in property <string> initial;
    in property <length> size: 22px;
    /// Foto do perfil. Vazia enquanto o cache nao a entrega, e vazia para
    /// sempre em quem nunca escolheu uma -- nos dois casos vale a inicial, e o
    /// circulo tem o mesmo tamanho, entao a chegada da foto nao mexe o layout.
    in property <image> source;

    width: root.size;
    height: root.size;
    border-radius: min(root.size / 2, Theme.radius-avatar);
    background: Theme.accent;
    clip: true;

    if root.source.width == 0: Text {
        text: root.initial;
        color: Theme.text-on-accent;
        // Proporcional ao circulo: o mesmo componente serve a barra lateral e
        // a tela de configuracoes, em tamanhos diferentes.
        font-size: root.size * 0.5;
        font-weight: Theme.weight-bold;
        font-family: Theme.font-family;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        // A foto do Spotify e quadrada e o circulo tambem; `fill` evita o
        // acento aparecer por arredondamento de um pixel na borda.
        image-fit: fill;
    }
}

// Linha de acao de um menu desenhado pelo proprio aplicativo.
//
// O menu nativo do Windows nao aceita estilo: e um HMENU desenhado pelo
// sistema. Vale para a bandeja e vale dentro da janela -- o `ContextMenuArea`
// do Slint tambem sai como HMENU no Windows. Desenhado aqui, cada item volta a
// ser um retangulo comum, e o realce de hover passa a ser o mesmo dos itens de
// navegacao da janela principal, em vez do azul do sistema.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <IconRef> glyph;
    in property <brush> tint: Theme.text;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    // O foco de teclado participa do mesmo estado de leitura do hover. O anel
    // continua marcando o alvo exato; este fundo impede que o foco se perca
    // entre as opcoes do menu.
    background: touch.has-hover || touch.has-focus ? Theme.hover : transparent;

    animate background { duration: Theme.motion-fast; easing: ease; }

    // Estrelado: os itens acendem um depois do outro quando o menu abre, como
    // estrelas aparecendo. O atraso sai da posicao do item no menu.
    private property <bool> entrou: false;
    private property <bool> estrelado: Theme.acabamento == 4;
    init => { self.entrou = true; }
    // Sonho: o menu inteiro surge devagar, como saindo de uma nevoa.
    private property <bool> sonho: Theme.acabamento == 3;
    opacity: (root.estrelado || root.sonho) && !root.entrou ? 0.0 : 1.0;
    animate opacity {
        duration: root.estrelado ? 320ms : (root.sonho ? 520ms : 0ms);
        delay: root.estrelado ? root.y / 34px * 55ms : 0ms;
        easing: ease-out;
    }

    // Sonho: halo branco macio que pulsa sob o item apontado.
    if root.sonho && (touch.has-hover || touch.has-focus): Rectangle {
        private property <bool> pulso: false;
        init => { self.pulso = true; }
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        background: #ffffff70;
        drop-shadow-color: #ffffff;
        drop-shadow-blur: self.pulso ? 18px : 6px;
        animate drop-shadow-blur { duration: 1400ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    }

    if touch.has-hover || touch.has-focus: Glass { radius: Theme.radius-sm; }

    // Estrelado: fio aceso na esquerda do item sob o cursor.
    if root.estrelado: Rectangle {
        x: 0;
        width: 2px;
        height: touch.has-hover || touch.has-focus ? parent.height * 0.6 : 0px;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        drop-shadow-color: Theme.accent;
        drop-shadow-blur: 6px;
        animate height, y { duration: Theme.motion-normal; easing: ease-out; }
    }
    // ... e a estrela que gira ate aparecer na ponta direita.
    if root.estrelado: Text {
        x: parent.width - Theme.space-sm - 12px;
        width: 12px;
        height: parent.height;
        text: "✦";
        color: Theme.accent;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
        opacity: touch.has-hover || touch.has-focus ? 1.0 : 0.0;
        transform-rotation: touch.has-hover || touch.has-focus ? 0deg : -120deg;
        transform-scale: touch.has-hover || touch.has-focus ? 1.0 : 0.3;
        animate opacity, transform-rotation, transform-scale {
            duration: Theme.motion-slow; easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Icon {
            glyph: root.glyph;
            tint: root.tint;
            size: 16px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.tint;
            font-size: Theme.size-md;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: root.text;
        focus-radius: Theme.radius-sm;
        clicked => { root.clicked(); }
    }
}
