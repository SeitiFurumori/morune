// Tokens de tema.
//
// Todos os valores vem do Rust em tempo de execucao (morune-theme). Os valores
// escritos aqui sao apenas o padrao usado enquanto o tema ainda nao foi
// aplicado -- e o que garante que a janela tenha aparencia coerente mesmo se o
// carregamento do tema demorar ou falhar.
//
// Nada nesta interface pode usar cor, tamanho ou duracao literal: se um valor
// nao esta aqui, ele nao e customizavel, e isso e um bug.

// Geometria logica de uma lente sobre o wallpaper; nao captura conteudo da UI.
export struct LensRegion {
    x: float, y: float, width: float, height: float, radius: float,
    window-width: float, window-height: float, fit: int,
}

export global Theme {
    pure callback refract-background(image, LensRegion) -> image;
    pure callback glass-tint(image, brush) -> brush;
    // --- cores ---
    in-out property <brush> background: #0b0d12;
    in-out property <brush> surface: #12151d;
    in-out property <brush> surface-raised: #1a1e29;
    in-out property <brush> player-background: #0f1219;
    in-out property <brush> sidebar-background: #0d1016;

    in-out property <brush> text: #eceff4;
    in-out property <brush> text-muted: #939cb0;
    in-out property <brush> text-on-accent: #080a0e;

    in-out property <brush> accent: #6dd49e;
    in-out property <brush> accent-hover: #87e4b2;

    in-out property <brush> border: #ffffff14;
    // Aresta superior das superficies. Chega igual a `border` quando o tema nao
    // pede realce, entao quem desenha nunca precisa checar se existe.
    in-out property <brush> border-highlight: #ffffff14;
    in-out property <brush> hover: #ffffff0d;
    in-out property <brush> selected: #ffffff1a;
    in-out property <brush> focus-ring: #6dd49e;

    in-out property <brush> danger: #e46d6d;
    in-out property <brush> warning: #e4b35c;
    in-out property <brush> success: #5cc98a;
    in-out property <brush> scrollbar: #ffffff24;

    // --- tipografia ---
    in-out property <string> font-family: "";
    /// Familia dos titulos grandes.
    ///
    /// Vazia = usa `font-family`, que e o caso de todo tema de uma familia so.
    /// Existe porque serifa e boa em titulo e ruim em rotulo de 11px: sem este
    /// par, um tema editorial tinha de escolher entre um titulo bonito e uma
    /// interface legivel.
    in-out property <string> display-family: "";
    in-out property <length> size-xs: 11px;
    in-out property <length> size-sm: 12px;
    in-out property <length> size-md: 14px;
    in-out property <length> size-lg: 17px;
    in-out property <length> size-xl: 22px;
    in-out property <length> size-display: 32px;
    in-out property <int> weight-normal: 400;
    in-out property <int> weight-medium: 500;
    in-out property <int> weight-bold: 700;
    in-out property <float> letter-spacing: 0;

    // --- formas ---
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 14px;
    in-out property <length> radius-artwork: 6px;
    in-out property <length> radius-avatar: 999px;

    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 12px;
    in-out property <length> space-lg: 20px;
    in-out property <length> space-xl: 32px;

    in-out property <length> border-width: 1px;
    in-out property <length> progress-thickness: 4px;
    in-out property <length> scrollbar-width: 10px;

    // --- fundo ---
    // A imagem chega decodificada, reduzida e ja desfocada do Rust. Aqui ela e
    // so um bitmap: nada nesta camada recalcula nada por quadro.
    in-out property <image> background-image;
    // A mesma imagem, ja borrada, para os paineis usarem como vidro.
    //
    // O Slint nao desfoca o que esta atras de um elemento -- nao existe filtro
    // de fundo aqui. Mas quando o que esta atras do painel e o fundo da janela,
    // o painel pode mostrar o pedaco desta copia que fica exatamente na posicao
    // dele, e o olho nao distingue disso e do desfoque real. Ver `Vidro` em
    // components.slint.
    in-out property <image> background-blurred;
    // 0 = cover, 1 = contain, 2 = center, 3 = stretch
    in-out property <int> background-fit: 0;
    // Tamanho da janela, escrito pela raiz em app.slint.
    //
    // O `Vidro` precisa refazer a conta que o `image-fit: cover` faz para saber
    // qual pedaco da imagem cai atras dele, e para isso precisa saber o tamanho
    // da area onde a imagem foi desenhada -- que e a janela.
    in-out property <length> window-width: 1220px;
    in-out property <length> window-height: 800px;
    in-out property <float> background-opacity: 1.0;
    in-out property <brush> background-tint: #00000000;
    in-out property <float> background-tint-strength: 0.0;

    // --- controles ---
    // Medida do alvo que a pessoa clica, separada das formas porque responde a
    // outra pergunta. `icon-stroke` esta em unidades do viewbox 24x24 do icone,
    // nao em pixels: e o que faz o traco acompanhar o tamanho do desenho.
    in-out property <length> control-button-size: 32px;
    in-out property <length> control-button-radius: 999px;
    in-out property <length> control-primary-size: 40px;
    in-out property <length> control-icon-size: 18px;
    in-out property <length> control-icon-size-primary: 22px;
    in-out property <float> control-icon-stroke: 2.0;
    in-out property <length> control-slider-knob: 12px;
    in-out property <length> control-tooltip-height: 28px;

    // --- movimento ---
    // Duracoes ja resolvidas no Rust: `enabled = false` chega aqui como 0ms,
    // entao a interface nao precisa checar se animacao esta ligada.
    in-out property <duration> motion-fast: 120ms;
    in-out property <duration> motion-normal: 200ms;
    in-out property <duration> motion-slow: 320ms;

    // --- efeitos ---
    // 0 conserva temas anteriores, 1 gel Aero, 2 lente Liquid.
    in-out property <int> material-kind: 0;
    // A aurora do vidro Aero: as listras diagonais que andam.
    //
    // `aurora-fase` vai de 0 a 1 e da a volta; quem a move e um temporizador
    // na raiz de cada janela, um so por janela, para todos os paineis andarem
    // juntos. `aurora-viva` e desligada pelo Rust com a janela escondida: na
    // bandeja nao ha o que animar, e um temporizador acordando vinte vezes por
    // segundo atras de um jogo e exatamente o gasto invisivel que o projeto
    // existe para nao ter. O portao de tela cheia e a animacao reduzida entram
    // por `motion-normal`, que chega zerado nos dois casos.
    in-out property <bool> aurora-viva: true;
    in-out property <float> aurora-fase: 0.0;
    in-out property <float> shadow-strength: 0.5;
    in-out property <float> gloss: 0.0;
    in-out property <bool> artwork-tint: true;
    in-out property <float> artwork-tint-strength: 0.35;
    // Cor dominante da capa que esta tocando, calculada no Rust uma vez por
    // faixa. Quando nao ha capa, chega igual a `player-background`, e o veu
    // some sozinho sem ninguem precisar checar.
    in-out property <color> artwork-color: #0f1219;
}

// Composicao da tela, tambem vinda do tema.
export global Layout {
    // 0 = esquerda, 1 = direita, 2 = oculta
    in-out property <int> sidebar-position: 0;
    in-out property <length> sidebar-width: 232px;
    in-out property <length> sidebar-collapsed-width: 64px;
    in-out property <bool> sidebar-collapsible: true;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> sidebar-icons: true;
    in-out property <bool> sidebar-labels: true;
    in-out property <bool> sidebar-playlists: true;
    in-out property <length> sidebar-playlist-height: 40px;
    in-out property <length> detail-cover-size: 160px;

    // Rotulos que a barra realmente desenha.
    //
    // `sidebar-labels` e escolha do tema; `sidebar-collapsed` e escolha do
    // usuario, feita em execucao. Quem desenha precisa das duas: recolher a
    // barra sem calar os rotulos deixa texto de 232 px dentro de uma caixa de
    // 64 px, que foi exatamente o defeito que isto corrige.
    out property <bool> sidebar-labels-shown: root.sidebar-labels && !root.sidebar-collapsed;

    // Icones que a barra realmente desenha.
    //
    // Recolhida, o icone e a unica coisa que cabe. Um tema que desliga os
    // icones e a barra recolhida deixariam a navegacao invisivel -- tres linhas
    // clicaveis e vazias. O estado recolhido manda aqui pelo mesmo motivo que
    // um tema quebrado nunca impede o aplicativo de abrir.
    out property <bool> sidebar-icons-shown: root.sidebar-icons || root.sidebar-collapsed;

    // 0 = rodape, 1 = topo, 2 = dentro da sidebar
    in-out property <int> player-position: 0;
    in-out property <length> player-height: 88px;
    in-out property <bool> player-artwork: true;
    in-out property <length> player-artwork-size: 56px;
    in-out property <bool> player-progress: true;
    in-out property <bool> player-progress-edge: false;
    in-out property <bool> player-volume: true;
    in-out property <bool> player-shuffle-repeat: true;
    in-out property <bool> player-queue-button: true;
    in-out property <bool> player-stop-button: false;
    in-out property <bool> player-times: true;
    in-out property <bool> player-center-controls: true;

    // 0 = grade, 1 = lista, 2 = compacta
    in-out property <int> view-mode: 0;
    in-out property <float> density: 1.0;
    in-out property <length> card-width: 168px;
    in-out property <length> row-height: 44px;
    in-out property <bool> show-hero: true;
    in-out property <length> hero-height: 240px;
}

// Cores da marca.
//
// Deliberadamente fora de `Theme`: sao identidade, nao aparencia. Um tema pode
// mudar tudo o que o usuario ve, menos o que identifica o aplicativo -- pela
// mesma razao que o simbolo tem geometria fixa e proporcoes travadas.
// Os valores vem de assets/brand/morune-logo-system/SPECIFICATION.md.
export global Brand {
    out property <color> violet-light: #8b63f6;
    out property <color> violet-dark: #6937ec;
    out property <brush> mark: @linear-gradient(135deg, Brand.violet-light 0%, Brand.violet-dark 100%);
}
