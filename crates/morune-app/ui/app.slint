    out property <string> search: "M 10 2 a 8 8 0 1 0 0 16 a 8 8 0 0 0 0 -16 M 16 16 L 22 22";
    out property <string> library: "M 4 3 L 7 3 L 7 21 L 4 21 Z M 10 3 L 13 3 L 13 21 L 10 21 Z M 16 4 L 19 5 L 15 21 L 12 20 Z";
    out property <string> settings: "M 12 8 a 4 4 0 1 0 0 8 a 4 4 0 0 0 0 -8 M 12 2 L 13 5 L 16 4 L 17 7 L 20 8 L 19 11 L 22 12 L 19 13 L 20 16 L 17 17 L 16 20 L 13 19 L 12 22 L 11 19 L 8 20 L 7 17 L 4 16 L 5 13 L 2 12 L 5 11 L 4 8 L 7 7 L 8 4 L 11 5 Z";
    out property <string> play: "M 7 4 L 20 12 L 7 20 Z";
    out property <string> pause: "M 7 4 L 11 4 L 11 20 L 7 20 Z M 13 4 L 17 4 L 17 20 L 13 20 Z";
    out property <string> next: "M 5 4 L 16 12 L 5 20 Z M 17 4 L 20 4 L 20 20 L 17 20 Z";
    out property <string> previous: "M 19 4 L 8 12 L 19 20 Z M 4 4 L 7 4 L 7 20 L 4 20 Z";
    out property <string> shuffle: "M 3 5 L 8 5 L 16 19 L 21 19 M 17 15 L 21 19 L 17 23 M 3 19 L 8 19 L 11 14 M 15 8 L 16 5 L 21 5 M 17 1 L 21 5 L 17 9";
    out property <string> repeat: "M 4 9 L 4 6 L 17 6 L 17 3 L 21 7 L 17 11 L 17 8 M 20 15 L 20 18 L 7 18 L 7 21 L 3 17 L 7 13 L 7 16";
    out property <string> repeat-one: "M 4 9 L 4 6 L 17 6 L 17 3 L 21 7 L 17 11 L 17 8 M 20 15 L 20 18 L 7 18 L 7 21 L 3 17 L 7 13 L 7 16 M 11 12 L 12 12 L 12 17";
    out property <string> queue: "M 3 6 L 15 6 M 3 12 L 15 12 M 3 18 L 11 18 M 17 10 L 17 19 M 17 10 L 21 9 L 21 7 L 17 8";
    out property <string> mini-player: "M 4 6 L 20 6 L 20 18 L 4 18 Z M 8 14 L 16 14";
    out property <string> volume: "M 4 9 L 7 9 L 12 5 L 12 19 L 7 15 L 4 15 Z M 15 9 a 5 5 0 0 1 0 6 M 18 6 a 9 9 0 0 1 0 12";
    out property <string> chevron-left: "M 15 5 L 8 12 L 15 19";
    out property <string> chevron-right: "M 9 5 L 16 12 L 9 19";
    out property <string> close: "M 5 5 L 19 19 M 19 5 L 5 19";
    out property <string> heart: "M 12 21 C 10 18 4 15 4 9 C 4 5 9 3 12 7 C 15 3 20 5 20 9 C 20 15 14 18 12 21 Z";
    out property <string> queue-add: "M 3 6 L 14 6 M 3 12 L 14 12 M 3 18 L 10 18 M 18 13 L 18 21 M 14 17 L 22 17";
    out property <string> queue-next: "M 3 6 L 14 6 M 3 12 L 14 12 M 3 18 L 10 18 M 18 12 L 18 21 M 14 16 L 18 12 L 22 16";
    out property <string> chevron-up: "M 5 15 L 12 8 L 19 15";
    out property <string> chevron-down: "M 5 9 L 12 16 L 19 9";
    out property <string> minimize-window: "M 5 12 L 19 12";
