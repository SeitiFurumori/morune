}

// **No Bruma o titulo de secao mora dentro do modulo, sem caixinha.**
//
// Antes cada titulo tinha a propria pastilha de `surface`, porque o texto
// flutuava sobre o desktop borrado e precisava de chao. Com a secao inteira
// num modulo (`Prateleira`), o chao ja existe: a pastilha virava caixa dentro
// de caixa, e o titulo passava a parecer botao. So o titulo de PAGINA, que
// fica fora dos modulos, ainda pede a pastilha -- por `chip`.
// Acoes que qualquer linha ou cartao pode pedir, sem encanar um callback por
// cada componente entre a linha e a janela. O Rust liga os handlers uma vez.
export global Acoes {
    callback copy-link(string);
    callback toggle-hidden(string);
    // Playlists da pessoa, para "Adicionar a playlist". Escrito pelo Rust.
    in-out property <[CardItem]> playlists;
    callback add-to-playlist(string, string);
    callback create-playlist(string);
    callback rename-playlist(string, string);
    callback delete-playlist(string);
}

component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Theme.size-lg;
    in property <bool> chip: false;
    height: label.preferred-height + (root.chip ? Theme.space-sm * 2 : 0px);
    // A pastilha e um modulo pequeno, com o mesmo raio e a mesma aresta de luz
    // dos grandes. Com `radius-sm` ela parecia etiqueta colada, de outra
    // familia que os paineis ao lado.
    if root.chip: Rectangle {
        x: 0; y: 0;
        width: min(parent.width, label.preferred-width + Theme.space-md * 2);
        height: 100%;
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        clip: true;
        Glass { radius: parent.border-radius; }
    }
    // Sem pastilha, o titulo recua `space-sm`: e o recuo interno do cartao e
    // da linha logo abaixo. Com x zero ele ficava 8 px a esquerda da primeira
    // capa -- o grupo parecia desalinhado consigo mesmo.
    label := Text {
        x: root.chip ? Theme.space-md : Theme.space-sm;
        width: parent.width - self.x * 2;
        height: 100%;
        text: root.text;
        font-size: root.font-size;
        font-weight: Theme.weight-bold;
        font-family: Theme.font-family;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Titulos de pagina lideram; titulos de secao organizam o conteudo abaixo.
component PageTitle inherits SectionTitle {
    font-size: Theme.size-xl;
    chip: Theme.material-kind == 2;
}

component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <string> action-label;
    /// Altura util da pagina, quando quem hospeda pode informa-la.
    ///
    /// **`alignment: center` sozinho nao centraliza nada.** Ele centraliza os
    /// filhos DENTRO desta caixa, e a caixa nascia com a altura do proprio
    /// conteudo -- umas 120px de titulo, dica e botao. Dentro de um visor de
    /// rolagem cujo viewport e `preferred-height`, isso deixa o bloco inteiro
    /// colado no topo, com a pagina vazia embaixo. Deslogado, o unico caminho
    /// que a tela oferece -- o botao de entrar -- ficava no alto, longe do
    /// centro do olhar.
    ///
    /// Quem esta num visor de rolagem passa a altura visivel aqui. Quem esta
    /// solto num layout usa `vertical-stretch: 1`, que resolve o mesmo por outro
    /// caminho.
    in property <length> altura-util: 0px;
    callback action();

    min-height: root.altura-util;
    alignment: center;
    spacing: Theme.space-sm;

    // No Aero o texto fica dentro de uma caixa de vidro, como os grupos do
    // Inicio: solto sobre a foto, o "entre com sua conta" da primeira abertura
    // nao dava para ler. Nos outros materiais a caixa nao pinta nada.
    HorizontalLayout {
        alignment: center;

        caixa := Rectangle {
            // `preferred` e `max`, e nao `width: min(root.width, ...)`: ler a
            // largura do pai aqui fecha um laco no resolvedor de layout.
            preferred-width: 520px;
            max-width: 520px;
            // No Bruma tambem: todo texto de conteudo mora num modulo.
            border-radius: Theme.material-kind > 0 ? Theme.radius-lg : 0px;
            clip: Theme.material-kind > 0;
            background: Theme.material-kind == 2 ? Theme.surface : transparent;

            if Theme.material-kind == 1: Vidro { radius: parent.border-radius; tinta: Theme.surface; }
            if Theme.material-kind > 0: Glass { radius: parent.border-radius; }

            VerticalLayout {
                padding: Theme.material-kind > 0 ? Theme.space-lg : 0px;
                spacing: Theme.space-sm;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.size-lg;
                    font-family: Theme.font-family;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.hint;
                    color: Theme.text-muted;
                    font-size: Theme.size-md;
                    font-family: Theme.font-family;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // O botao nao ocupa a largura da tela.
                //
                // Num `VerticalLayout` o filho estica na horizontal, entao o botao
                // de um estado vazio virava uma barra de 840px na cor de destaque
                // -- um banner, e nao uma acao. Numa area sem conteudo, o botao e
                // o unico elemento com peso: se ele tomar a largura toda, e a
                // unica coisa que a tela diz.
                if root.action-label != "": HorizontalLayout {
                    alignment: center;

                    PrimaryButton {
                        label: root.action-label;
                        clicked => { root.action(); }
                    }
                }
            }
        }
    }
}

// Controle da janela com a mesma semantica dos botoes nativos do Windows, mas
// integrado ao tema do Morune. O alvo ocupa toda a altura da title bar: alem de
// ser mais facil de acertar, permite levar o ponteiro ate a borda superior sem
// perder o botao (Lei de Fitts).
component WindowControl inherits Rectangle {
    in property <string> label;
    in property <IconRef> glyph;
    in property <bool> danger: false;
    callback clicked();

    width: Theme.space-xl + Theme.space-md;
    height: Theme.space-xl + Theme.space-xs;
    background: root.danger && touch.has-hover
        ? Theme.danger
        : (touch.pressed ? Theme.selected : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: Theme.motion-fast; easing: ease; }

    Path {
        width: Theme.control-icon-size;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.commands;
        fill: transparent;
        stroke: root.danger && touch.has-hover ? Theme.text-on-accent : Theme.text-muted;
        stroke-width: 1.5px;
        stroke-line-cap: square;
        stroke-line-join: miter;
    }

    focus := FocusScope {
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.clicked(); }

        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    if focus.has-focus: Rectangle {
        border-width: Theme.border-width * 2;
        border-color: Theme.focus-ring;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { focus.focus(); }
        }
        clicked => { root.clicked(); }
    }
}

component AppTitleBar inherits Rectangle {
    in property <bool> maximized;
    callback move-window(float, float);
    callback toggle-maximize();
    callback minimize();
    callback close();

    private property <length> drag-origin-x;
    private property <length> drag-origin-y;
    private property <bool> restoring-from-maximized: false;

    height: Theme.space-xl + Theme.space-xs;
    // No Aero a cor do vidro vai por cima do borrao, dentro do `Vidro`; pintar
    // aqui embaixo tambem somaria a mesma cor duas vezes.
    background: Theme.material-kind == 1 ? transparent : Theme.sidebar-background;
    // Um recorte so, aqui no painel: cada `clip` e uma camada inteira do
    // renderizador por quadro, e tres por painel travavam a interface.
    clip: Theme.material-kind == 1;

    // Mesma peca de vidro da barra lateral e do rodape: as tres formam a
    // moldura da janela, e moldura e onde material de fundo pertence.
    Vidro { forca: Theme.material-kind == 1 ? 1.0 : 0.7; tinta: Theme.sidebar-background; }

    // Colada no topo da janela: a base dela nao e quina, e a luz de retorno
    // apareceria como um risco no meio da interface.
    Glass { bottom: false; }

    // A area de arraste termina antes dos controles. Assim um clique nos
    // botoes nunca pode ser interpretado como movimento da janela.
    drag := TouchArea {
        width: parent.width - (Theme.space-xl + Theme.space-md) * 3;
        height: parent.height;
        mouse-cursor: MouseCursor.default;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.drag-origin-x = self.mouse-x;
                root.drag-origin-y = self.mouse-y;
                root.restoring-from-maximized = false;
            }
        }

        moved => {
            if (self.pressed) {
                if (root.maximized) {
                    root.toggle-maximize();
                    root.restoring-from-maximized = true;
                } else if (root.restoring-from-maximized) {
                    // Depois que o Windows devolve o tamanho restaurado, cria
                    // uma nova ancora para o arraste nao saltar entre monitores.
                    root.drag-origin-x = self.mouse-x;
                    root.drag-origin-y = self.mouse-y;
                    root.restoring-from-maximized = false;
                } else {
                    root.move-window(
                        (self.mouse-x - root.drag-origin-x) / 1px,
                        (self.mouse-y - root.drag-origin-y) / 1px
                    );
                }
            }
        }

        double-clicked => { root.toggle-maximize(); }
    }

    HorizontalLayout {
        // A marca ja ancora a sidebar, inclusive quando ela esta recolhida.
        // Repeti-la aqui criava dois cabecalhos para o mesmo aplicativo. A
        // title bar fica deliberadamente silenciosa: arraste a esquerda,
        // controles de janela previsiveis a direita.
        Rectangle { horizontal-stretch: 1; }

        WindowControl {
            label: "Minimizar janela";
            glyph: Icons.minimize-window;
            clicked => { root.minimize(); }
        }

        WindowControl {
            label: root.maximized ? "Restaurar janela" : "Maximizar janela";
            glyph: root.maximized ? Icons.restore-window : Icons.maximize-window;
            clicked => { root.toggle-maximize(); }
        }

        WindowControl {
            label: "Fechar janela";
            glyph: Icons.close;
            danger: true;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        y: parent.height - Theme.border-width;
        height: Theme.border-width;
        background: Theme.border;
    }
}

// Rodape da barra lateral quando ha sessao.
//
// **O que havia antes:** um `Text` solto com o identificador da conta, colado
// na borda esquerda, um nivel de recuo diferente de todo o resto da coluna e em
// cinza de texto secundario. Parecia sobra, nao informacao.
//
// Agora tem a geometria de um [`NavItem`] -- mesma altura, mesmo recuo, mesmo
// realce sob o cursor -- e o avatar ocupa exatamente o lugar do icone, de modo
// que o nome cai na mesma coluna dos rotulos de navegacao. Clicar leva as
// Configuracoes, que e onde a conta se administra: sem isso o bloco seria um
// alvo de clique que nao faz nada.
component AccountRow inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <image> avatar;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.hover : transparent;

    animate background { duration: Theme.motion-fast; easing: ease; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;
        alignment: Layout.sidebar-labels-shown ? LayoutAlignment.start : LayoutAlignment.center;

        AccountAvatar {
            initial: root.initial;
            source: root.avatar;
            size: Theme.control-icon-size-primary;
            y: (parent.height - self.height) / 2;
        }

        if Layout.sidebar-labels-shown: Text {
            text: root.name;
            color: Theme.text;
            font-size: Theme.size-md;
            font-family: Theme.font-family;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: "Conta: " + root.name;
        focus-radius: Theme.radius-md;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <IconRef> icon;
    in property <bool> active;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

    animate background { duration: Theme.motion-fast; easing: ease; }

    // Com vidro, sim -- ver a nota sobre recipiente em `Realce`.
    //
    // Fraco: item de navegacao fica aceso o tempo todo, e o que passa numa lista
    // e aceitavel num realce de passagem vira peso quando nao apaga nunca.
    Realce {
        radius: Theme.radius-md;
        aceso: root.active ? 0.45 : (touch.has-hover ? 0.30 : 0.0);
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;
        alignment: Layout.sidebar-labels-shown ? LayoutAlignment.start : LayoutAlignment.center;

        if Layout.sidebar-icons-shown: Icon {
            glyph: root.icon;
            tint: root.active ? Theme.text : Theme.text-muted;
            size: Theme.control-icon-size-primary;
            y: (parent.height - self.size) / 2;
        }

        if Layout.sidebar-labels-shown: Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.size-md;
            font-weight: root.active ? Theme.weight-medium : Theme.weight-normal;
            font-family: Theme.font-family;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    touch := PressableArea {
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        clicked => { root.clicked(); }
    }
}

component TrackListRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    callback activated();
    callback favorite-toggled();
    in property <bool> queue-actions: true;
    in property <bool> queue-management: false;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    // Numa lista que e, por definicao, de curtidas, cem coracoes cheios sao
    // informacao zero: ali o coracao volta a ser acao e so aparece no hover.
    in property <bool> quiet-favorite: false;
    // "Nao tocar no radio": so na lista que o radio alimenta (a fila).
    in property <bool> hide-action: false;
    callback hide();
    callback play-next();
    callback enqueue();
    callback remove-queued();
    callback move-up();
    callback move-down();
    private property <length> actions-width: 32px
        + (root.queue-actions ? 64px + Theme.space-md * 2 : 0px)
        + (root.queue-management ? 96px + Theme.space-md * 3 : 0px);

    height: Layout.row-height;
    border-radius: Theme.radius-sm;
    // A cor de `hover` do tema fica por baixo, fraca: e ela que sustenta o
    // realce num tema sem imagem de fundo e sem brilho, onde a folha nao entra.
    //
    // A faixa tocando tem fundo `selected` e um icone de barras no lugar do
    // numero: dois sinais que nao dependem de matiz. So a cor do titulo em
    // `accent` sumia no Aquario -- azul sobre ceu azul -- e quem volta do jogo
    // quer achar "o que esta tocando" na lista em um segundo.
    // No Bruma a linha nao tem mais chao proprio: ela mora num modulo
    // (`Prateleira` ou o quadro da lista do Detalhe), que ja e o chao. Seis
    // pastilhas empilhadas com 4 px entre elas eram o que fazia a Home parecer
    // uma pilha de barras.
    background: touch.pressed ? Theme.selected
        : (root.track.playing ? Theme.selected
            : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: Theme.motion-fast; easing: ease; }

    // A linha acende como objeto. Ver a nota em `Realce`: veu de cor sobre o
    // proprio fundo era invisivel por construcao.
    //
    // 0,45 e o mesmo valor da playlist na barra lateral e do item de navegacao.
    // Estava em 1,0 e destoava de tudo: passar o cursor numa faixa acendia mais
    // que qualquer outra coisa da tela.
    Realce {
        radius: Theme.radius-sm;
        // 0,45 tocando e o mesmo valor do item ativo da barra lateral: e o
        // "voce esta aqui" da lista. So o fundo `selected` nao bastava -- no
        // Bruma a linha forca `surface` e o destaque sumia no tema padrao.
        aceso: root.track.playing ? 0.45 : (touch.has-hover ? 0.30 : 0.0);
    }

    // **Sem vidro aqui, e a regra e das duas plataformas.** A Apple: "Don't use
    // Liquid Glass in the content layer... Instead, use standard materials for
    // elements in the content layer." A Microsoft: "Don't apply backdrop
    // material to a UI element." Linha de faixa e conteudo, e vidro sobre
    // conteudo apaga a fronteira entre o que flutua e o que esta embaixo --
    // quando tudo e vidro, nada esta acima de nada.
    //
    // O realce de hover continua existindo: e a cor de `hover` do tema, que e
    // exatamente o "low-opacity solid color" que a documentacao do Windows
    // manda usar na camada de conteudo.

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        // A capa tem `row-height - space-md`; metade da sobra em cima e metade
        // embaixo. Sem isto o `HorizontalLayout` punha a capa no topo da linha:
        // 1 px acima, 12 px abaixo (medido na captura de 22/09).
        padding-top: Theme.space-md / 2;
        padding-bottom: Theme.space-md / 2;
        spacing: Theme.space-md;

        Rectangle {
            width: 26px;
            if !root.track.playing: Text {
                text: root.index + 1;
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 100%;
                height: 100%;
            }
            // Estatico de proposito: barras que pulsam seriam um temporizador
            // vivo por linha tocando, e o orcamento do produto e nao gastar
            // nada atras de um jogo.
            if root.track.playing: Icon {
                glyph: Icons.playing;
                tint: Theme.live-accent;
                size: Theme.control-icon-size;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
            }
        }

        Artwork {
            source: root.track.cover;
            initial: root.track.initial;
            hue: root.track.hue;
            pending: root.track.cover-pending;
            // A folga em cima e embaixo e a mesma dos lados (`space-md` no
            // total, metade de cada lado). Com `space-sm` a capa de 40 px
            // ficava a 2 px da borda da linha de 44: encostada, enquanto o
            // texto ao lado respirava 12.
            width: Layout.row-height - Theme.space-md;
            height: self.width;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            // **Nao anuncia largura preferida.** Sem isto o layout entrega a
            // cada celula a largura do proprio texto **mais** a fatia do espaco
            // livre, e a coluna de album passava a comecar num x diferente em
            // cada linha -- proporcional ao tamanho do titulo. Zerado, a divisao
            // e so do espaco livre: metade para cada, sempre no mesmo lugar.
            min-width: 0px;
            preferred-width: 0px;

            Text {
                text: root.track.title;
                color: root.track.playable
                    ? (root.track.playing ? Theme.accent : Theme.text)
                    : Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                overflow: elide;
            }

            if Layout.view-mode != 2: Text {
                text: root.track.artist;
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                overflow: elide;
            }
        }

        // Coluna de album.
        //
        // **Por que ela existe:** entre o nome do artista e os icones da direita
        // havia mais de mil pixels de nada numa janela comum, e era o que mais
        // fazia a lista parecer esqueleto. O dado ja vinha pronto no `TrackRow`
        // e nao era desenhado em lugar nenhum.
        //
        // **A condicao e o modo do tema, e nao a largura da linha.** Ler
        // `root.width` aqui fecha um ciclo em `layoutinfo-h` -- a largura da
        // linha passaria a depender do que a linha decide mostrar, que depende
        // da largura -- e o Slint recusa compilar. O modo tambem e a resposta
        // certa de produto: quem escolhe lista compacta esta pedindo mais linha
        // e menos coluna.
        //
        // De quebra, `view-mode` ganha o segundo efeito. Ele declarava tres
        // modos e mudava uma coisa so, e essa e parte da razao de trocar de tema
        // quase nao mudar nada.
        //
        // **Sai so no modo compacto**, e nao "so na grade" como na primeira
        // versao. Aquilo estava errado: o album e o que faz uma lista parecer
        // indice, entao o modo lista e justamente quem mais precisa dele. Quem
        // pede compacto e que esta pedindo mais linha e menos coluna.
        // **A celula existe sempre; quem e condicional e o texto dentro dela.**
        // Um `if` no lugar da celula nao repassa `horizontal-stretch` ao
        // layout: a celula recebia a largura preferida do texto e vinha
        // centralizada, cada album comecando num x diferente. Com largura fixa
        // a coluna ficava certa mas grudada nos icones, e o vazio so mudava de
        // lugar -- passava a ficar entre o artista e o album.
        //
        // Assim titulo e album dividem o espaco livre pela metade: duas colunas
        // de verdade, cada uma comecando sempre no mesmo x, e o vazio deixa de
        // existir em vez de se mudar.
        Rectangle {
            horizontal-stretch: Layout.view-mode != 2 ? 1 : 0;
            // Pelo mesmo motivo do titulo: a celula so divide o espaco livre.
            min-width: 0px;
            preferred-width: 0px;
            if Layout.view-mode != 2: Text {
                x: 0;
                width: 100%;
                height: 100%;
                text: root.track.album;
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        Rectangle { width: root.actions-width; }

        Text {
            text: root.track.duration;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 48px;
        }
    }

    private property <length> menu-x;
    private property <length> menu-y;

    touch := PressableArea {
        accessible-label: "Tocar " + root.track.title + " de " + root.track.artist;
        clicked => { root.activated(); }
        double-clicked => { root.activated(); }
        context-menu-requested(mx, my) => {
            root.menu-x = mx;
            root.menu-y = my;
            menu-faixa.show();
        }
    }

    // Escolha da playlist. Rola quando ha muitas; o teto de oito linhas e o
    // mesmo que cabe num menu sem cobrir a tela.
    menu-playlists := PopupWindow {
        x: min(root.menu-x, root.width - self.width);
        y: root.menu-y;
        width: 260px;
        height: min(8, Acoes.playlists.length) * 34px + Theme.space-xs * 2 + 26px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-md;
            border-width: Theme.border-width;
            border-color: Theme.border;
            background: Theme.surface-raised;
            Glass { radius: Theme.radius-md; }

            VerticalLayout {
                padding: Theme.space-xs;
                Text {
                    height: 26px;
                    x: Theme.space-sm;
                    text: "Adicionar à playlist";
                    color: Theme.text-muted;
                    font-size: Theme.size-xs;
                    font-family: Theme.font-family;
                    vertical-alignment: center;
                }
                Flickable {
                    viewport-height: Acoes.playlists.length * 34px;
                    VerticalLayout {
                        alignment: start;
                        for pl in Acoes.playlists: MenuRow {
                            text: pl.title;
                            glyph: Icons.library;
                            clicked => {
                                menu-playlists.close();
                                Acoes.add-to-playlist(pl.id, root.track.id);
                            }
                        }
                    }
                }
            }
        }
    }

    // Clique direito: o que o Spotify oferece numa faixa, menos o que exige
    // escrita na conta que o Morune ainda nao faz. Mesmo desenho do menu da
    // barra lateral: `PopupWindow` so e instanciado no `show()`, entao cem
    // linhas nao custam cem menus.
    menu-faixa := PopupWindow {
        x: min(root.menu-x, root.width - self.width);
        y: root.menu-y;
        width: 232px;
        height: (root.queue-actions ? 6 : 4) * 34px + Theme.space-xs * 2;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-md;
            border-width: Theme.border-width;
            border-color: Theme.border;
            background: Theme.surface-raised;
            Glass { radius: Theme.radius-md; }

            VerticalLayout {
                padding: Theme.space-xs;
                if root.queue-actions: MenuRow {
                    text: "Tocar a seguir";
                    glyph: Icons.queue-next;
                    clicked => { menu-faixa.close(); root.play-next(); }
                }
                if root.queue-actions: MenuRow {
                    text: "Adicionar ao fim da fila";
                    glyph: Icons.queue-add;
                    clicked => { menu-faixa.close(); root.enqueue(); }
                }
                MenuRow {
                    text: root.track.favorite ? "Remover das curtidas" : "Curtir";
                    glyph: Icons.heart;
                    clicked => { menu-faixa.close(); root.favorite-toggled(); }
                }
                MenuRow {
                    text: "Adicionar à playlist";
                    glyph: Icons.plus;
                    clicked => { menu-faixa.close(); menu-playlists.show(); }
                }
                MenuRow {
                    text: "Copiar link";
                    glyph: Icons.link;
                    clicked => { menu-faixa.close(); Acoes.copy-link(root.track.id); }
                }
                MenuRow {
                    text: "Não tocar no rádio";
                    glyph: Icons.hide;
                    clicked => { menu-faixa.close(); Acoes.toggle-hidden(root.track.id); }
                }
            }
        }
    }

    // Declarado depois da area da linha para receber o clique primeiro.
    favorite-button := IconButton {
        x: root.width - Theme.space-md - 48px - Theme.space-md - self.width;
        y: (root.height - self.height) / 2;
        label: root.track.favorite
            ? "Remover " + root.track.title + " das Músicas curtidas do Spotify"
            : "Adicionar " + root.track.title + " às Músicas curtidas do Spotify";
        glyph: Icons.heart;
        filled: root.track.favorite;
        active: root.track.favorite;
        // Ativo, mas sem o fundo pintado: numa biblioteca inteira de curtidas,
        // `selected` em cem coracoes vira uma coluna de caixinhas coloridas. O
        // estado continua indo para o leitor de tela por `active`; quem mostra
        // na tela e o icone cheio.
        quiet: true;
        checkable: true;
        // Curtida cheia usa `text`, e nao `accent`. Numa biblioteca inteira de
        // curtidas, cem coracoes na cor de destaque destacam o que e a regra --
        // e o destaque passa a nao significar nada. O accent fica com a acao
        // primaria e com o que esta tocando.
        tint: root.track.favorite ? Theme.text : Theme.text-muted;
        // Nao curtida so aparece com o cursor na linha; curtida fica sempre,
        // porque ai ela e estado e nao acao.
        opacity: (root.track.favorite && !root.quiet-favorite) || touch.has-hover || self.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
        clicked => { root.favorite-toggled(); }
    }

    // Acoes de fila: aparecem no hover, nao o tempo todo.
    //
    // **O ruido que isto tira:** eram tres icones fixos em cada linha. Numa
    // lista de cem faixas, trezentos icones competindo com cem titulos -- e a
    // acao mais comum, tocar, nao e nenhum deles: e clicar na linha.
    //
    // **Opacidade e nao `visible`, e o foco entra na conta.** Elemento invisivel
    // sai da ordem do Tab, e a navegacao por teclado e um ponto forte deste
    // projeto para ser derrubado por polimento visual. Com opacidade o botao
    // continua alcancavel -- e por isso o container tambem acende quando um
    // deles recebe foco, senao o foco pousaria num botao invisivel.
    if root.queue-actions: Rectangle {
        width: fila.width * 2 + Theme.space-md;
        height: parent.height;
        x: favorite-button.x - Theme.space-md - self.width;
        opacity: touch.has-hover || fila.has-focus || proxima.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }

        proxima := IconButton {
            x: 0;
            y: (parent.height - self.height) / 2;
            label: "Tocar " + root.track.title + " a seguir";
            glyph: Icons.queue-next;
            tint: Theme.text-muted;
            clicked => { root.play-next(); }
        }

        fila := IconButton {
            x: proxima.width + Theme.space-md;
            y: proxima.y;
            label: "Adicionar " + root.track.title + " ao fim da fila";
            glyph: Icons.queue-add;
            tint: Theme.text-muted;
            clicked => { root.enqueue(); }
        }
    }

    if root.hide-action && !root.queue-actions && !root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md - self.width;
        y: favorite-button.y;
        label: "Não tocar " + root.track.title + " no rádio";
        glyph: Icons.hide;
        tint: Theme.text-muted;
        opacity: touch.has-hover || self.has-focus ? 1.0 : 0.0;
        animate opacity { duration: Theme.motion-fast; easing: ease-out; }
        clicked => { root.hide(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md - self.width;
        y: favorite-button.y;
        label: "Remover " + root.track.title + " da fila";
        glyph: Icons.close;
        tint: Theme.text-muted;
        clicked => { root.remove-queued(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md * 2 - self.width * 2;
        y: favorite-button.y;
        label: "Mover " + root.track.title + " para baixo";
        glyph: Icons.chevron-down;
        enabled: root.can-move-down;
        tint: Theme.text-muted;
        clicked => { root.move-down(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md * 3 - self.width * 3;
        y: favorite-button.y;
        label: "Mover " + root.track.title + " para cima";
        glyph: Icons.chevron-up;
        enabled: root.can-move-up;
        tint: Theme.text-muted;
        clicked => { root.move-up(); }
    }
}

component Card inherits Rectangle {
    in property <CardItem> item;
    // O gabarito da grade reserva a maior variante, mesmo com dados vazios.
    in property <bool> reserve-subtitle: false;
    // A grade estica o cartao para as colunas fecharem na borda direita.
    in property <length> largura: Layout.card-width;
    callback activated();

    width: root.largura;
    // A altura vem do conteudo, nao de um palpite. A versao anterior somava
    // 56px fixos a largura para dar conta do titulo e do subtitulo, e esses
    // 56px nao acompanhavam o tamanho de fonte nem a entrelinha do tema: em
    // Paper os descendentes do titulo ficavam serrados na base do cartao.
    height: conteudo.preferred-height;
    // **Raio concentrico, calculado e nao escolhido a dedo.**
    //
    // A regra e externo = interno + espacamento. A primeira versao disto usava
    // `radius-lg`, porque no tema embutido 6 + 8 da 14 e `radius-lg` e 14 --
    // coincidencia, nao relacao. Nos temas de fabrica o numero nao bate em
    // nenhum: Bruma pede 22 e declara 26, Cristal pede 24 e declara 28, Pulse
    // pede 24 e declara 26, Aquario pede 21 e declara 24. Um token escolhido a
    // dedo so acerta no tema em que foi escolhido.
    //
    // Somando os dois tokens, o cartao e concentrico **em qualquer tema**, e
    // continua sendo quando alguem mexer em um dos dois.
    //
    // A excecao e o tema que escolheu quina viva: com `radius-artwork` zero,
    // somar o espacamento daria um cartao arredondado em volta de uma capa
    // quadrada -- que e a mesma discordancia, ao contrario. No Paper os dois
    // ficam retos, como o tema pede.
    border-radius: Theme.radius-artwork > 0px
        ? Theme.radius-artwork + Theme.space-sm
        : 0px;
    // Capas sao conteudo, nao controles em gel. O material permanece no
    // cromo; aqui a propria imagem lidera e o hover delimita o alvo inteiro.
    // Quem chega por Tab recebe o mesmo contexto visual de quem aponta com o
    // mouse. O anel de foco continua sendo a marca precisa do alvo; este
    // realce impede que ele pareca solto numa lista longa.
    //
    // O clique responde na hora, antes de a rede voltar: pressionado, o cartao
    // pinta com `selected`, que e mais forte que `hover`. Sem isso, entre o
    // clique e a faixa comecar havia um vazio em que nada dizia "recebi".
    // Sem chao proprio no Bruma, pelo mesmo motivo da linha: o cartao mora
    // num modulo. A capa e o titulo bastam para dizer onde ele comeca.
    background: touch.pressed ? Theme.selected
        : (touch.has-hover || touch.has-focus ? Theme.hover : transparent);
    if Theme.material-kind > 0 && (touch.has-hover || touch.has-focus || touch.pressed): Rectangle {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        background: touch.pressed ? Theme.selected : Theme.hover;
    }
    animate background { duration: Theme.motion-fast; easing: ease; }
    // E o cartao inteiro afunda 3%: o unico lugar da interface onde escala
    // cabe (auditoria de 21/09, P2.5). Lista nao escala -- linha que encolhe
    // parece que vai sumir.
    transform-scale: touch.pressed ? 0.97 : 1.0;
    animate transform-scale {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    conteudo := VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-sm;

        Artwork {
            source: root.item.cover;
            initial: root.item.initial;
            hue: root.item.hue;
            pending: root.item.cover-pending;
            width: parent.width - Theme.space-sm * 2;
            height: self.width;
        }

        Text {
            text: root.item.title;
            color: Theme.text;
            font-size: Theme.size-md;
            font-weight: Theme.weight-medium;
            font-family: Theme.font-family;
            overflow: elide;
        }

        // Condicional, e nao um `Text` vazio: sem isto o cartao de playlist --
        // que passou a nao ter legenda nenhuma -- continuaria reservando a
        // altura de uma linha embaixo do titulo, e a fileira inteira ficaria com
        // um vao sem explicacao.
        if root.reserve-subtitle || root.item.subtitle != "": Text {
            text: root.item.subtitle;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: "Abrir " + root.item.title;
        focus-radius: root.border-radius;
        clicked => { root.activated(); }
    }
}

component CardCollection inherits Rectangle {
    in property <[CardItem]> items;
    // `false` quando nenhum item tem legenda (playlists): sem isto cada linha
    // reserva a altura de um subtitulo vazio, e o vao entre as linhas fica
    // maior que o vao entre as colunas.
    in property <bool> legenda: true;
    callback activated(string);

    // **As colunas saem da largura da propria grade, e o cartao estica.**
    //
    // Antes o numero de colunas vinha da janela e o cartao tinha largura fixa:
    // sobrava uma faixa vazia a direita que mudava a cada tamanho de janela.
    // Agora cabem quantas colunas de `card-width` couberem, e a sobra e
    // dividida entre elas -- a grade fecha nas duas bordas do modulo.
    //
    // Por atribuicao num handler, e nao por ligacao: a grade repassa ao layout
    // de cima o que os filhos pedem, e os filhos dependeriam da largura que o
    // layout de cima da -- o Slint recusa o ciclo. O handler le a largura fora
    // da cadeia de layout.
    property <length> vao: Theme.space-md;
    property <int> columns: 1;
    property <length> celula: Layout.card-width;
    function medir() {
        if root.width <= 0px { return; }
        root.columns = max(1, floor((root.width + root.vao) / (Layout.card-width + root.vao)));
        root.celula = (root.width - root.vao * (root.columns - 1)) / root.columns;
    }
    init => { root.medir(); }
    changed width => { root.medir(); }
    height: collection.preferred-height;

    // A grade nao anuncia largura preferida ao layout de cima, so altura.
    //
    // Sem isto, a largura que ela pediria dependeria de `columns`, e `columns`
    // e calculado a partir da largura da janela: o Slint fecha o ciclo em
    // `layoutinfo-h` e avisa que pode dar panic em tempo de execucao. A grade
    // ocupa a largura que lhe derem e decide quantas colunas cabem -- nunca o
    // contrario.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;

    // A celula precisa de altura propria, e o cartao dentro dela nao a
    // fornece: o `Card` esta atras de um `if`, e um filho condicional de um
    // Rectangle nao propaga restricao para o layout de cima. Sem isto a linha
    // inteira media zero, todas as linhas da grade caiam no mesmo y e os
    // cartoes apareciam empilhados uns por cima dos outros.
    //
    // O gabarito mede em vez de chutar: todo cartao tem a mesma altura (capa
    // quadrada, uma linha de titulo, uma de subtitulo), entao um so instante
    // invisivel responde pela grade toda e a medida acompanha a fonte do tema.
    // Medido na largura fixa do tema e somado depois: a capa e quadrada, entao
    // cada pixel a mais de largura e um pixel a mais de altura. Medir ja na
    // largura da celula fecharia um ciclo -- a largura da grade depende do que
    // os filhos pedem.
    gabarito := Card {
        visible: false;
        reserve-subtitle: root.legenda;
    }
    property <length> altura-celula: gabarito.height + root.celula - Layout.card-width;

    collection := VerticalLayout {
        spacing: root.vao;
        alignment: start;
        for row-index in ceil(root.items.length / root.columns): HorizontalLayout {
            spacing: root.vao;
            alignment: start;
            for column in root.columns: Rectangle {
                width: root.celula;
                height: root.altura-celula;
                if row-index * root.columns + column < root.items.length: Card {
                    largura: root.celula;
                    item: root.items[row-index * root.columns + column];
                    activated => { root.activated(root.items[row-index * root.columns + column].id); }
                }
            }
        }
    }
}

component TrackList inherits ListView {
    in property <[TrackRow]> tracks;
    in property <bool> has-more: false;
    in property <bool> loading: false;
    callback activated(string);
    callback favorite-toggled(string);
    in property <bool> queue-actions: true;
    in property <bool> queue-management: false;
    callback play-next(string);
    callback enqueue(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback nearing-end();
    // Vao entre as linhas. A lista de pagina usa 2px; a prateleira do Inicio
    // usa o token do tema, e antes tinha um `for` proprio so por causa disso.
    in property <length> row-gap: 2px;
    in property <bool> quiet-favorite: false;
    in property <bool> hide-action: false;
    callback hide(string);

    scrolled => {
        if root.has-more && !root.loading
            && -root.viewport-y + root.visible-height
                >= root.viewport-height - Layout.row-height * 8 {
            root.nearing-end();
        }
    }

    for track[i] in root.tracks: Rectangle {
        height: Layout.row-height + root.row-gap;

        TrackListRow {
            width: parent.width;
            height: Layout.row-height;
            track: track;
            index: i;
            queue-actions: root.queue-actions;
            queue-management: root.queue-management;
            quiet-favorite: root.quiet-favorite;
            hide-action: root.hide-action;
            hide => { root.hide(track.id); }
            can-move-up: i > 0;
            can-move-down: i + 1 < root.tracks.length;
            activated => { root.activated(track.id); }
            favorite-toggled => { root.favorite-toggled(track.id); }
            play-next => { root.play-next(track.id); }
            enqueue => { root.enqueue(track.id); }
            remove-queued => { root.remove-queued(i); }
            move-up => { root.move-queued(i, i - 1); }
            move-down => { root.move-queued(i, i + 1); }
        }
    }
}

// Uma playlist na barra lateral.
//
// Capa pequena e uma linha de texto. A capa nao e enfeite: recolhida, ela e a
// unica coisa que sobra, e e por ela que a lista continua navegavel sem
// rotulo.
// Campo de texto de uma linha, no desenho dos campos do tema.
component CampoTexto inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted(string);
    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.hover;
    border-width: Theme.border-width;
    border-color: entrada.has-focus ? Theme.focus-ring : Theme.border-highlight;

    entrada := TextInput {
        x: Theme.space-md;
        width: parent.width - Theme.space-md * 2;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.size-md;
        font-family: Theme.font-family;
        single-line: true;
        accepted => { root.accepted(self.text); }
    }
    if root.text == "": Text {
        x: Theme.space-md;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.size-md;
        font-family: Theme.font-family;
    }

    public function focar() { entrada.focus(); }
}

// Conteudo da janela que pede um nome: "Nova playlist", "Renomear". Quem usa
// poe dentro de um `PopupWindow` (um componente cuja raiz e PopupWindow nao
// pode morar em `if`/`for`) e fecha no `confirmado`.
component PainelNome inherits Rectangle {
    in property <string> titulo;
    in property <string> acao;
    in property <string> texto-inicial;
    callback confirmado(string);
    width: 280px;
    height: 132px;

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: Theme.border-width;
        border-color: Theme.border;
        background: Theme.surface-raised;
        Glass { radius: Theme.radius-md; }

        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;

            Text {
                text: root.titulo;
                color: Theme.text;
                font-size: Theme.size-md;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
            }
            campo := CampoTexto {
                text: root.texto-inicial;
                placeholder: "Nome da playlist";
                init => { self.focar(); }
                accepted(nome) => { root.confirmado(nome); }
            }
            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    label: root.acao;
                    clicked => { root.confirmado(campo.text); }
                }
            }
        }
    }
}

component PlaylistNavItem inherits Rectangle {
    in property <CardItem> item;
    // As curtidas nao sao playlist do provedor e ja moram no topo: um menu que
    // so oferece "fixar" seria um menu que nao faz nada.
    in property <bool> pinnable: true;
    callback activated();
    callback toggle-pin();

    private property <length> menu-x;
    private property <length> menu-y;

    height: Layout.sidebar-playlist-height;
    border-radius: Theme.radius-sm;
    background: transparent;

    // **Vidro dentro da barra lateral, que tambem e vidro -- e isso esta certo.**
    //
    // Havia aqui uma nota dizendo o contrario, citando "glass-on-glass stacking"
    // da lista de anti-padroes da Apple. A citacao estava pela metade. A lista
    // diz *"multiple separate glass effects **without container**"*, e a Apple
    // tem uma peca de API so para agrupar vidros justamente porque aninhar e
    // esperado -- a Central de Controle do iOS e um painel de vidro cheio de
    // botoes de vidro.
    //
    // O que e proibido e **borrar o que ja esta borrado**: cada camada refazendo
    // o desfoque da anterior, ate virar papa. Aqui isso nao acontece por
    // construcao: toda peca le a MESMA copia borrada do fundo, na posicao dela,
    // e nenhuma le o resultado da outra. Ver `Vidro`.
    Realce {
        radius: Theme.radius-sm;
        aceso: touch.has-hover || touch.has-focus ? 0.30 : 0.0;
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;
        alignment: Layout.sidebar-labels-shown ? start : center;

        Artwork {
            source: root.item.cover;
            initial: root.item.initial;
            hue: root.item.hue;
            pending: root.item.cover-pending;
            radius: Theme.radius-sm;
            width: Layout.sidebar-playlist-height - Theme.space-xs * 2;
            height: self.width;
            y: (parent.height - self.height) / 2;
        }

        if Layout.sidebar-labels-shown: Text {
            text: root.item.title;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // A marca de fixada e um icone e nao so uma posicao: numa barra em que
        // a ordem ja muda sozinha por recencia, estar no topo nao explica por
        // que aquela lista esta ali.
        if Layout.sidebar-labels-shown && root.item.pinned: Icon {
            glyph: Icons.pin;
            // Fora do accent pelo mesmo motivo do coracao: destaque gasto em
            // marca de estado nao sobra para a acao primaria.
            tint: Theme.text-muted;
            size: 14px;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := PressableArea {
        accessible-label: (root.item.pinned ? "Playlist fixada: " : "Abrir playlist ") + root.item.title;
        clicked => { root.activated(); }
        context-menu-requested(mx, my) => {
            if (root.pinnable) {
                root.menu-x = mx;
                root.menu-y = my;
                menu.show();
            }
        }
    }

    // Menu proprio, e nao `ContextMenuArea`: no Windows o `ContextMenuArea` do
    // Slint sai pelo `muda` como HMENU nativo, cinza do sistema -- o mesmo
    // motivo que fez o menu da bandeja virar janela propria. Um `PopupWindow` e
    // desenhado pelo renderizador da janela, entao cada pixel continua vindo do
    // tema; e o `close-policy` ja fecha em clique fora e no Escape, sem veu nem
    // encanamento extra.
    //
    // Declarado no corpo do componente repetido, e nao dentro do `for`: o Slint
    // so instancia a subarvore no `show()`, entao oitenta playlists nao custam
    // oitenta menus.
    // Apagar pede o segundo clique: sem desfazer do lado do Spotify, um clique
    // errado no menu nao pode levar a playlist embora.
    private property <bool> confirmar-apagar: false;

    renomear := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: PopupClosePolicy.close-on-click-outside;
        PainelNome {
            titulo: "Renomear playlist";
            acao: "Salvar";
            texto-inicial: root.item.title;
            confirmado(nome) => {
                renomear.close();
                Acoes.rename-playlist(root.item.id, nome);
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 208px;
        height: 3 * 34px + Theme.space-xs * 2;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-md;
            border-width: Theme.border-width;
            border-color: Theme.border;
            background: Theme.surface-raised;

            Glass { radius: Theme.radius-md; }

            VerticalLayout {
                padding: Theme.space-xs;

                MenuRow {
                    text: root.item.pinned ? "Desafixar do topo" : "Fixar no topo";
                    glyph: Icons.pin;
                    clicked => {
                        menu.close();
                        root.toggle-pin();
                    }
                }
                MenuRow {
                    text: "Renomear";
                    glyph: Icons.library;
                    clicked => {
                        menu.close();
                        renomear.show();
                    }
                }
                MenuRow {
                    text: root.confirmar-apagar ? "Clique de novo para apagar" : "Apagar da biblioteca";
                    glyph: Icons.close;
                    tint: root.confirmar-apagar ? Theme.danger : Theme.text;
                    clicked => {
                        if (root.confirmar-apagar) {
                            root.confirmar-apagar = false;
                            menu.close();
                            Acoes.delete-playlist(root.item.id);
                        } else {
                            root.confirmar-apagar = true;
                        }
                    }
                }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <int> page;
    in property <bool> logged-in;
    in property <string> account-name;
    in property <string> account-initial;
    in property <string> auth-url;
    in property <image> account-avatar;
    in property <[CardItem]> playlists;
    callback navigate(int);
    callback toggle-sidebar();
    callback login();
    callback cancel-login();
    callback copy-auth-url();
    callback filter-playlists(string);
    callback open-playlist(string);
    callback toggle-pin-playlist(string);

    VerticalLayout {
        padding: Layout.sidebar-collapsed ? Theme.space-sm : Theme.space-md;
        spacing: Theme.space-xs;

        // Cabecalho: a marca e o botao de recolher.
        //
        // Sem rotulos a barra fica so com icones, e a marca passa a ser a unica
        // identificacao visivel do aplicativo -- por isso ela aparece nos dois
        // estados, e nao so ao lado do nome.
        //
        // Recolhida, porem, a largura e a de um icone: marca e botao nao cabem
        // lado a lado e empilham. Insistir na mesma linha era o que estourava a
        // caixa.
        if !Layout.sidebar-collapsed: HorizontalLayout {
            height: 48px;
            padding-left: Theme.space-sm;
            spacing: Theme.space-sm;
            alignment: Layout.sidebar-labels-shown ? start : center;

            Logo {
                y: (parent.height - self.height) / 2;
            }

            if Layout.sidebar-labels-shown: Text {
                text: "Morune";
                color: Theme.text;
                font-size: Theme.size-lg;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if Layout.sidebar-collapsible: IconButton {
                label: "Recolher barra lateral";
                glyph: Icons.chevron-left;
                tint: Theme.text-muted;
                button-size: 28px;
                y: (parent.height - self.height) / 2;
                clicked => { root.toggle-sidebar(); }
            }
        }

        if Layout.sidebar-collapsed: VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;
            // Sem isto o cabecalho fica com a sobra vertical da barra e empurra
            // a navegacao para o meio da tela. O cabecalho expandido nao
            // precisa porque tem altura fixa.
            vertical-stretch: 0;

            // A marca **e** o botao de expandir.
            //
            // Antes havia um chevron separado logo abaixo dela, e ele trazia
            // dois problemas. O visual: duas coisas empilhadas numa coluna de
            // 44 px, onde a marca sozinha ja ocupa o lugar todo. E um defeito
            // de verdade: o rotulo de ajuda daquele botao nascia mais largo que
            // a barra recolhida, comecava em `x` negativo e era cortado pela
            // borda esquerda -- na tela aparecia "ndir barra lateral".
            //
            // A marca continua sendo a unica identificacao visivel do
            // aplicativo quando recolhida, entao ela nao some. Expandir passa a
            // ser clicar nela, que e o gesto que o usuario ja tentava.
            //
            // Sem rotulo de ajuda de proposito: qualquer caixa mais larga que
            // 44 px repetiria o corte. O realce sob o cursor diz que e
            // clicavel, e o nome acessivel diz o que faz.
            HorizontalLayout {
                alignment: center;

                marca := Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Theme.radius-md;
                    background: marca-touch.has-hover ? Theme.hover : transparent;

                    animate background { duration: Theme.motion-fast; easing: ease; }

                    Logo {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    marca-touch := PressableArea {
                        accessible-label: "Expandir barra lateral";
                        focus-radius: Theme.radius-md;
                        clicked => { root.toggle-sidebar(); }
                    }
                }
            }
        }

        NavItem {
            label: "Início";
            icon: Icons.home;
            active: root.page == 0;
            clicked => { root.navigate(0); }
        }

        NavItem {
            label: "Buscar";
            icon: Icons.search;
            active: root.page == 1;
            clicked => { root.navigate(1); }
        }

        NavItem {
            label: "Biblioteca";
            icon: Icons.library;
            active: root.page == 2;
            clicked => { root.navigate(2); }
        }

        // As playlists vivem aqui porque e o que elas sao: o `rootlist` do
        // Spotify e a barra lateral dele, arrumada pelo proprio usuario.
        // Desenha-las como prateleira do Inicio era tratar navegacao como
        // descoberta.
        //
        // O filtro so aparece quando ha rotulo: recolhida, nao ha onde digitar
        // -- e nem faria sentido, porque a barra vira uma coluna de capas.
        if Layout.sidebar-playlists && Layout.sidebar-labels-shown && root.playlists.length > 0: Rectangle {
            // Separacao entre navegacao principal e colecao pessoal.
            height: Theme.space-sm;
        }

        if Layout.sidebar-playlists && Layout.sidebar-labels-shown && root.playlists.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            SearchField {
                horizontal-stretch: 1;
                placeholder: "Filtrar playlists";
                edited(q) => { root.filter-playlists(q); }
            }
            Rectangle {
                width: nova-botao.width;
                nova-botao := IconButton {
                    y: (parent.height - self.height) / 2;
                    label: "Nova playlist";
                    glyph: Icons.plus;
                    tint: Theme.text-muted;
                    clicked => { nova.show(); }
                }
                nova := PopupWindow {
                    x: 0;
                    y: parent.height + Theme.space-xs;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    PainelNome {
                        titulo: "Nova playlist";
                        acao: "Criar";
                        texto-inicial: "";
                        confirmado(nome) => {
                            nova.close();
                            Acoes.create-playlist(nome);
                        }
                    }
                }
            }
        }

        if !Layout.sidebar-playlists: Rectangle { vertical-stretch: 1; }

        // A lista termina sempre numa linha inteira, nunca no meio de uma.
        //
        // Antes ela recebia o que sobrasse de altura e a ultima playlist
        // aparecia partida ao meio -- um retangulo orfao com meia capa e meio
        // nome, que foi um dos tres motivos de a tela parecer trabalho de
        // iniciante. Aqui a area util e arredondada para baixo, para o maior
        // multiplo do passo da linha que caiba; o resto fica de fundo da barra.
        //
        // O `+ space-xs` no numerador existe porque n linhas tem n-1 vaos.
        area-playlists := Rectangle {
            vertical-stretch: 1;

            // A altura desta area vem do que o layout de cima der, e nunca do
            // conteudo: e o que permite o filho abaixo ler `parent.height` sem
            // realimentar o proprio layout.
            min-height: 0px;
            preferred-height: 0px;

            property <length> passo: Layout.sidebar-playlist-height + Theme.space-xs;
            property <int> linhas-inteiras: max(1, floor((self.height + Theme.space-xs) / self.passo));

            Rectangle {
                height: min(parent.height, area-playlists.linhas-inteiras * area-playlists.passo - Theme.space-xs);
                y: 0;
                clip: true;

                Flickable {
                    height: 100%;
                    viewport-height: lista.preferred-height;

                    lista := VerticalLayout {
                        alignment: start;
                        spacing: Theme.space-xs;
                        width: 100%;

                        for item in root.playlists: PlaylistNavItem {
                            item: item;
                            pinnable: item.id != "liked";
                            activated => { root.open-playlist(item.id); }
                            toggle-pin => { root.toggle-pin-playlist(item.id); }
                        }
                    }
                }

                // A barra lateral tem fundo proprio: o degrade morre nele, nao
                // no fundo da pagina.
                ScrollFade {
                    base: Theme.sidebar-background;
                    active: lista.preferred-height > parent.height;
                }
            }
        }

        NavItem {
            label: "Configurações";
            icon: Icons.settings;
            active: root.page == 3;
            clicked => { root.navigate(3); }
        }

        if Layout.sidebar-labels-shown && !root.logged-in: GhostButton {
            label: "Entrar no Spotify";
            clicked => { root.login(); }
        }

        // Recolhida, sobra so o avatar -- que continua identificando a conta e
        // continua sendo o caminho para as Configuracoes.
        if root.logged-in: AccountRow {
            name: root.account-name;
            initial: root.account-initial;
            avatar: root.account-avatar;
            clicked => { root.navigate(3); }
        }
    }
}

component PlayerBar inherits Rectangle {
    // Timer para dormir: vazio quando desligado, senao o que falta.
    in property <string> sleep-label;
    callback set-sleep(int);
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <float> volume;
    in property <bool> has-track;
    in property <bool> favorite;
    in property <bool> mini-player: false;
    // A Fila e uma pagina sem item na barra lateral; o botao que a abre e o
    // unico lugar que pode dizer "voce esta nela" -- e o que a fecha.
    in property <bool> queue-open: false;
    // Capa da faixa tocando. Vazia enquanto o cache nao a entrega, e o bloco
    // neutro do `Artwork` ocupa o lugar sem mudar o layout.
    in property <image> cover;
    in property <string> cover-initial;
    in property <float> cover-hue;
    in property <bool> cover-pending;

    callback toggle-play();
    callback stop();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback nudge-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();
    callback toggle-favorite();
    callback toggle-mini-player();

    height: Layout.player-height;
    background: Theme.material-kind == 0 ? Theme.player-background : transparent;
    border-radius: Theme.material-kind == 1 ? Theme.radius-lg : 0px;
    clip: Theme.material-kind == 1;

    if Theme.material-kind == 2: SceneGlass {
        x: Theme.space-sm; y: Theme.space-xs;
        width: parent.width - Theme.space-sm * 2;
        height: parent.height - Theme.space-xs * 2;
        tint: Theme.player-background;
    }

    // A barra muda quando o conteudo deixa de caber, nao por classe de
    // dispositivo. No piso normal de 720px, duas colunas iguais de 26%
    // apertavam titulo/capa a esquerda e ainda deixavam fila/volume transbordar
    // a direita. O centro preserva todos os comandos de reproducao.
    // A global recebe uma atribuicao quando a janela muda de tamanho. Isso
    // evita ligar a largura preferida da barra de volta a `root.width`, o que
    // formaria um ciclo no resolvedor de layout do Slint.
    private property <bool> compact-player: !root.mini-player && Theme.window-width < 900px;

    // A cor da capa vazando para dentro da barra.
    //
    // Degrade horizontal em vez de tingir a barra inteira: a cor sai de onde a
    // capa esta e some antes dos controles, entao ela ambienta sem competir com
    // o botao de play nem mudar o contraste do texto do centro. Um `Rectangle`
    // com preenchimento -- nao ha nada a recalcular por quadro.
    if Theme.artwork-tint && root.has-track: Rectangle {
        width: 100%;
        height: 100%;
        opacity: Theme.artwork-tint-strength;
        background: @linear-gradient(90deg,
            Theme.artwork-color 0%,
            Theme.artwork-color 12%,
            transparent 62%);
    }

    // A outra peca grande de vidro. Fica no rodape, onde o fundo do tema quase
    // sempre chega no seu trecho mais forte de cor -- e a faixa que mais mostra
    // que ha uma imagem atras da interface.
    Vidro {
        forca: Theme.material-kind == 1 ? 1.0 : 0.7;
        radius: parent.border-radius;
        tinta: Theme.player-background;
    }

    // No rodape da janela: a quina de baixo e o proprio limite da janela.
    // No Aero a barra e uma peca solta, com moldura em volta toda.
    if Theme.material-kind != 2: Glass { bottom: Theme.material-kind == 1; radius: parent.border-radius; }

    VerticalLayout {
        padding-left: Layout.player-progress-edge ? 0px : Theme.space-lg;
        padding-right: Layout.player-progress-edge ? 0px : Theme.space-lg;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-xs;

        if Layout.player-progress && Layout.player-progress-edge: Slider {
            label: "Progresso da faixa";
            value: root.progress;
            enabled: root.has-track;
            thickness: Theme.progress-thickness;
            fill-color: Theme.live-accent;
            committed(v) => { root.seek(v); }
        }

        HorizontalLayout {
            spacing: root.compact-player ? Theme.space-sm : Theme.space-md;
            padding-left: Layout.player-progress-edge ? Theme.space-lg : 0px;
            padding-right: Layout.player-progress-edge ? Theme.space-lg : 0px;

            HorizontalLayout {
                // Constante nos dois lados do breakpoint: mudar de `space-sm`
                // para `space-md` em 900px ainda fazia o titulo perder 12px
                // justamente quando a janela crescia.
                spacing: Theme.space-sm;
                // Limites continuos: crescer um pixel nunca pode diminuir o
                // titulo, como acontecia na passagem brusca de 33% para 26%.
                // O piso comporta capa/texto/favorito e o teto devolve espaco
                // ao transporte em monitores largos.
                width: root.mini-player
                    ? Theme.window-width * 0.36
                    : min(300px, max(228px, Theme.window-width * 0.33));

                // A capa abre o "Tocando agora" (o topo da Fila), como no
                // Spotify. Caixa propria para a area de toque nao entrar no
                // layout como um filho a mais.
                if Layout.player-artwork: Rectangle {
                    width: Layout.player-artwork-size;
                    height: Layout.player-artwork-size;
                    y: (parent.height - self.height) / 2;

                    Artwork {
                        source: root.cover;
                        initial: root.cover-initial;
                        hue: root.cover-hue;
                        pending: root.cover-pending;
                        width: 100%;
                        height: 100%;
                    }
                    capa-toque := TouchArea {
                        enabled: root.has-track && !root.queue-open;
                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.open-queue(); }
                    }
                }

                // O minimo zero e o que torna `overflow: elide` efetivo. Sem
                // ele, o tamanho preferido de um titulo longo alargava o grupo
                // e expulsava o favorito. O teto evita que o texto domine uma
                // barra larga; dentro da coluna, o coracao permanece associado
                // a faixa e em posicao estavel.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    max-width: 280px;

                    Text {
                        text: root.has-track ? root.title : "Nada tocando";
                        color: Theme.text;
                        font-size: Theme.size-md;
                        font-weight: Theme.weight-medium;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }

                    Text {
                        text: root.artist;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }
                }

                IconButton {
                    label: root.favorite
                        ? "Remover faixa atual das Músicas curtidas do Spotify"
                        : "Adicionar faixa atual às Músicas curtidas do Spotify";
                    glyph: Icons.heart;
                    filled: root.favorite;
                    active: root.favorite;
                    checkable: true;
                    enabled: root.has-track;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-favorite(); }
                }

            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-xs;

                HorizontalLayout {
                    alignment: Layout.player-center-controls
                        ? LayoutAlignment.center
                        : LayoutAlignment.start;
                    spacing: root.compact-player ? Theme.space-xs : Theme.space-sm;

                    if Layout.player-shuffle-repeat: VerticalLayout {
                        // Centrado na altura do botao principal: solto no layout, o
                        // botao menor ficava colado no topo, 4,5 px acima do play.
                        alignment: center;
                        IconButton {
                            label: root.shuffle ? "Desligar modo aleatório" : "Ligar modo aleatório";
                            glyph: Icons.shuffle;
                            active: root.shuffle;
                            checkable: true;
                            tint: Theme.text-muted;
                            clicked => { root.toggle-shuffle(); }
                        }
                    }

                    VerticalLayout {
                        // Centrado na altura do botao principal: solto no layout, o
                        // botao menor ficava colado no topo, 4,5 px acima do play.
                        alignment: center;
                        IconButton {
                            label: "Faixa anterior";
                            glyph: Icons.previous;
                            filled: true;
                            enabled: root.has-track;
                            clicked => { root.previous(); }
                        }
                    }

                    Rectangle {
                        width: Theme.control-primary-size;
                        height: self.width;
                        border-radius: self.width / 2;
                        // Aero: a esfera do Windows 7 -- clara em cima, azul
                        // embaixo, com a luz ciano subindo da base. O brilho em
                        // volta e a sombra do proprio elemento, na cor do accent.
                        background: Theme.material-kind == 1
                            ? @linear-gradient(180deg, #f3fbff 0%, #dff1fb 48%, #a9d6f0 52%, #5fa9d8 100%)
                            : Theme.accent;
                        border-width: Theme.material-kind == 1 ? 1px : 0px;
                        border-color: Theme.accent.darker(0.45);
                        drop-shadow-color: Theme.material-kind == 1 && root.has-track
                            ? Theme.selected.with-alpha(play-touch.has-hover ? 0.95 : 0.6) : transparent;
                        drop-shadow-blur: 9px;
                        opacity: !root.has-track ? 0.45
                            : (Theme.material-kind > 0 && play-touch.pressed ? 0.82 : 1.0);
                        clip: true;

                        if Theme.material-kind == 1: Rectangle {
                            // A luz ciano que sobe da base: um circulo radial
                            // com o centro abaixo da borda, cortado pela esfera.
                            width: parent.width * 1.3;
                            height: self.width;
                            x: (parent.width - self.width) / 2;
                            y: parent.height * 0.55;
                            border-radius: self.width / 2;
                            background: @radial-gradient(circle, #35e2f0 0%, #35e2f0b0 22%, #35e2f000 58%);
                        }
                        if Theme.material-kind == 1: Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: self.width / 2;
                            border-width: 1px;
                            border-color: #ffffffe0;
                        }

                        MaterialRedondo { }

                        IconSwap {
                            off: Icons.play;
                            on: Icons.pause;
                            state: root.playing;
                            tint: Theme.material-kind == 1 ? Theme.text : Theme.text-on-accent;
                            filled: true;
                            size: Theme.control-icon-size-primary;
                            transform-scale: play-touch.pressed ? 0.84 : 1.0;
                            animate transform-scale {
                                duration: Theme.motion-normal;
                                easing: cubic-bezier(0.34, 1.56, 0.64, 1);
                            }
                        }

                        play-touch := PressableArea {
                            enabled-input: root.has-track;
                            accessible-label: root.playing ? "Pausar" : "Reproduzir";
                            focus-radius: Theme.control-primary-size / 2;
                            clicked => { root.toggle-play(); }
                        }
                    }

                    if Layout.player-stop-button: VerticalLayout {
                        // Centrado na altura do botao principal: solto no layout, o
                        // botao menor ficava colado no topo, 4,5 px acima do play.
                        alignment: center;
                        IconButton {
                            label: "Parar";
                            glyph: Icons.stop;
                            filled: true;
                            enabled: root.has-track;
                            clicked => { root.stop(); }
                        }
                    }

                    VerticalLayout {
                        // Centrado na altura do botao principal: solto no layout, o
                        // botao menor ficava colado no topo, 4,5 px acima do play.
                        alignment: center;
                        IconButton {
                            label: "Próxima faixa";
                            glyph: Icons.next;
                            filled: true;
                            enabled: root.has-track;
                            clicked => { root.next(); }
                        }
                    }

                    if Layout.player-shuffle-repeat: VerticalLayout {
                        // Centrado na altura do botao principal: solto no layout, o
                        // botao menor ficava colado no topo, 4,5 px acima do play.
                        alignment: center;
                        IconButton {
                            label: root.repeat == 0
                                ? "Ligar repetição da fila"
                                : (root.repeat == 1 ? "Repetir esta faixa" : "Desligar repetição");
                            glyph: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                            active: root.repeat != 0;
                            checkable: true;
                            tint: Theme.text-muted;
                            clicked => { root.cycle-repeat(); }
                        }
                    }
                }

                // Com a barra colada na borda nao ha onde por os tempos ao lado
                // dela, e antes disto o `show_times` do tema era simplesmente
                // ignorado: nao havia nenhuma indicacao de posicao na tela.
                if Layout.player-progress && Layout.player-progress-edge && Layout.player-times: Text {
                    text: root.elapsed + " / " + root.total;
                    color: Theme.text-muted;
                    font-size: Theme.size-xs;
                    font-family: Theme.font-family;
                    horizontal-alignment: Layout.player-center-controls ? center : left;
                }

                if Layout.player-progress && !Layout.player-progress-edge: HorizontalLayout {
                    spacing: Theme.space-sm;

                    if Layout.player-times: Text {
                        text: root.elapsed;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                        width: root.compact-player ? 36px : 40px;
                        horizontal-alignment: right;
                    }

                    Slider {
                        label: "Progresso da faixa";
                        horizontal-stretch: 1;
                        fill-color: Theme.live-accent;
                        value: root.progress;
                        enabled: root.has-track;
                        committed(v) => { root.seek(v); }
                    }

                    if Layout.player-times: Text {
                        text: root.total;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                        width: root.compact-player ? 36px : 40px;
                    }
                }
            }

            HorizontalLayout {
                // Tambem cresce continuamente: nunca fica menor que os dois
                // botoes, icone, intervalos e trilho compacto, nem maior que a
                // coluna de metadados. Em largura comum, 26% preserva o
                // equilibrio visual anterior.
                width: root.mini-player
                    ? Theme.window-width * 0.12
                    : max(
                        Theme.control-button-size * 2
                            + Theme.control-icon-size
                            + Theme.space-sm * 3
                            + 64px,
                        min(300px, Theme.window-width * 0.26));
                alignment: end;
                spacing: Theme.space-sm;

                IconButton {
                    label: root.mini-player ? "Sair do mini-player" : "Abrir mini-player";
                    glyph: Icons.mini-player;
                    active: root.mini-player;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-mini-player(); }
                }

                // Timer para dormir. O botao acende quando ligado, e o menu
                // abre para cima, porque o rodape esta na borda da janela.
                if !root.mini-player: Rectangle {
                    width: sono-botao.width;
                    height: sono-botao.height;
                    y: (parent.height - self.height) / 2;

                    sono-botao := IconButton {
                        label: root.sleep-label == ""
                            ? "Timer para dormir"
                            : "Timer para dormir: " + root.sleep-label;
                        glyph: Icons.sleep;
                        active: root.sleep-label != "";
                        checkable: true;
                        tint: Theme.text-muted;
                        clicked => { sono-menu.show(); }
                    }

                    sono-menu := PopupWindow {
                        width: 200px;
                        height: 6 * 34px + Theme.space-xs * 2;
                        x: parent.width - self.width;
                        y: -self.height - Theme.space-sm;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        Rectangle {
                            border-radius: Theme.radius-md;
                            border-width: Theme.border-width;
                            border-color: Theme.border;
                            background: Theme.surface-raised;
                            Glass { radius: Theme.radius-md; }

                            VerticalLayout {
                                padding: Theme.space-xs;
                                MenuRow { text: "15 minutos"; glyph: Icons.sleep; clicked => { sono-menu.close(); root.set-sleep(15); } }
                                MenuRow { text: "30 minutos"; glyph: Icons.sleep; clicked => { sono-menu.close(); root.set-sleep(30); } }
                                MenuRow { text: "45 minutos"; glyph: Icons.sleep; clicked => { sono-menu.close(); root.set-sleep(45); } }
                                MenuRow { text: "1 hora"; glyph: Icons.sleep; clicked => { sono-menu.close(); root.set-sleep(60); } }
                                MenuRow { text: "No fim desta faixa"; glyph: Icons.sleep; clicked => { sono-menu.close(); root.set-sleep(-1); } }
                                MenuRow { text: "Desligar o timer"; glyph: Icons.close; clicked => { sono-menu.close(); root.set-sleep(0); } }
                            }
                        }
                    }
                }

                if !root.mini-player && Layout.player-queue-button: IconButton {
                    label: root.queue-open ? "Fechar fila" : "Abrir fila";
                    glyph: Icons.queue;
                    active: root.queue-open;
                    checkable: true;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-queue(); }
                }

                // O icone e botao: silenciar e reflexo de quem esta no chat de
                // voz, e arrastar um knob de 12 px que so aparece no hover nao
                // e reflexo.
                if !root.mini-player && Layout.player-volume: IconButton {
                    label: root.volume == 0 ? "Ativar som" : "Silenciar";
                    glyph: root.volume == 0 ? Icons.volume-muted : Icons.volume;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-mute(); }
                }

                if !root.mini-player && Layout.player-volume: Slider {
                    label: "Volume";
                    width: root.compact-player ? 64px : 96px;
                    value: root.volume;
                    y: (parent.height - self.height) / 2;
                    changed(v) => { root.set-volume(v); }
                    committed(v) => { root.set-volume(v); }
                    stepped(d) => { root.nudge-volume(d); }
                }
            }
        }
    }
}

// Faixa horizontal de cards.
//
// Rola de lado, e nao quebra em varias linhas: uma prateleira com trinta itens
// empurraria tudo que vem depois para fora da tela. O gesto nao briga com o do
// Inicio porque os eixos sao diferentes -- a pagina rola na vertical, a
// prateleira na horizontal.
// Um grupo do conteudo -- titulo e o que vem embaixo -- dentro de uma moldura.
//
// **So no Aero.** La cada grupo e uma peca de vidro solta sobre a foto, com a
// mesma moldura dupla e a mesma aurora das barras: e a foto aparece entre os
// grupos, em vez de sumir atras de um painel unico. Foi o pedido: "uma moldura
// para cada grupo, nao cobrindo completamente o fundo". Nos outros materiais
// e um `VerticalLayout` comum, sem pintar nada.
//
// O recorte e um so, aqui: `Vidro` e `Aurora` nao recortam por conta propria.
// Um grupo da pagina: titulo e o que ele organiza.
//
// No Aero e no Bruma o grupo e um MODULO -- uma peca de vidro com tudo dentro,
// como os blocos da Central de Controle do iPhone. No Bruma isso substitui as
// pastilhas por item: o texto continua sobre a mesma `surface` de antes (o
// contraste medido nao muda), so que uma por grupo em vez de uma por linha.
component Prateleira inherits Rectangle {
    in property <length> spacing: Theme.space-sm;
    private property <bool> modulo: Theme.material-kind == 1 || Theme.material-kind == 2;
    vertical-stretch: 0;
    border-radius: root.modulo ? Theme.radius-lg : 0px;
    clip: root.modulo;
    background: Theme.material-kind == 2 ? Theme.surface : transparent;

    if Theme.material-kind == 1: Vidro { radius: parent.border-radius; tinta: Theme.surface; }
    if root.modulo: Glass { radius: parent.border-radius; }

    VerticalLayout {
        padding: root.modulo ? Theme.space-md : 0px;
        // Mais ar embaixo: a legenda do cartao e a ultima linha do grupo, e
        // com o mesmo recuo dos outros lados ficava colada na moldura.
        // No Bruma o cartao ja traz o proprio recuo interno (`space-sm`), e
        // `space-lg` somado a ele deixava 37 px embaixo contra 25 em cima.
        padding-bottom: Theme.material-kind == 1 ? Theme.space-lg
            : (root.modulo ? Theme.space-md : 0px);
        spacing: root.spacing;
        @children
    }
}

component ScrollableCardShelf inherits Prateleira {
    in property <string> title;
    in property <[CardItem]> items;
    callback activated(string);

    SectionTitle { text: root.title; }

    Flickable {
        height: cards.preferred-height;
        viewport-width: cards.preferred-width;
        viewport-height: self.height;

        cards := HorizontalLayout {
            // Folga pequena para o anel de foco, sem reservar uma sombra
            // que os cartoes de conteudo nao usam mais.
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            spacing: Theme.space-md;
            alignment: start;
            for item in root.items: Card {
                item: item;
                activated => { root.activated(item.id); }
            }
        }
    }
}

// Uma secao do Inicio feita de faixas, para o que se ouve e nao se navega.
//
// Rola por dentro, com altura fixa. A alternativa -- listar tudo e deixar o
// Inicio crescer -- empurraria as prateleiras de cards para muito abaixo da
// dobra so para mostrar musicas curtidas.
component TrackShelf inherits Prateleira {
    in property <string> title;
    in property <[TrackRow]> tracks;
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    in property <bool> queue-actions: true;
    in property <bool> quiet-favorite: false;
    in property <bool> hide-action: false;
    callback hide(string);
    // Oito linhas: o bastante para procurar sem tomar a tela inteira. Sai do
    // token de altura de linha para acompanhar a densidade do tema.
    //
    // O espacamento entre as linhas entra na conta: sao oito linhas e sete
    // vaos. Sem os vaos, a caixa fica curta pelo tanto exato que faltava e a
    // oitava faixa aparece serrada no meio do texto.
    in property <length> visible-height: Layout.row-height * 8 + Theme.space-xs * 7;


    SectionTitle { text: root.title; }

    Rectangle {
        // Lista curta nao ganha area vazia: o bloco encolhe para caber nela.
        //
        // A altura sai da CONTA, nao de `lista.viewport-height`: o visor do
        // `ListView` deriva da propria altura, e ler um do outro fecha laco.
        private property <length> altura-das-linhas:
            root.tracks.length * (Layout.row-height + Theme.space-xs) - Theme.space-xs;
        height: min(root.visible-height, self.altura-das-linhas);

        // A base da lista era um corte reto: a ultima linha terminava numa quina
        // viva no meio da tela, e nada mais na interface termina assim. Com o
        // raio do tema e o recorte, a lista fecha como as outras pecas fecham.
        border-radius: Theme.radius-md;
        clip: true;

        // `TrackList` e um `ListView`, e o `ListView` so instancia as linhas que
        // estao na janela. O `for` num `Flickable` que havia aqui instanciava
        // as curtidas INTEIRAS -- milhares de linhas, cada uma com capa, menu
        // e ligacoes -- para mostrar oito. Era o que fazia a Home demorar a
        // abrir, e era memoria viva mesmo com a Home escondida.
        lista := TrackList {
            width: 100%;
            height: 100%;
            tracks: root.tracks;
            row-gap: Theme.space-xs;
            queue-actions: root.queue-actions;
            quiet-favorite: root.quiet-favorite;
            hide-action: root.hide-action;
            hide(id) => { root.hide(id); }
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            play-next(id) => { root.play-next(id); }
            enqueue(id) => { root.enqueue(id); }
        }

        // So quando ha o que rolar: numa lista de tres faixas nao ha nada
        // alem da borda, e o degrade estaria mentindo.
        ScrollFade {
            base: Theme.background;
            active: parent.altura-das-linhas > parent.height;
        }
    }
}

// As tres paginas roladas por dentro -- Inicio, Biblioteca e Fila -- sao
// `Rectangle` com um `Flickable` dentro, e nao um `Flickable` direto. O motivo
// e o degrade de borda: um filho declarado dentro do Flickable rola junto com
// o conteudo e some, entao o aviso de "há mais abaixo" precisa de um pai que
// nao role. Sem ele, a grade de cartoes terminava cortada na base nos quatro
// temas sem nada dizendo que havia mais.
component HomePage inherits Rectangle {
    // O Inicio do Spotify, secao por secao. Quando existe, substitui as quatro
    // prateleiras abaixo, que ficam como reserva.
    in property <[FeedShelf]> feed;
    in property <[CardItem]> made-for-you;
    in property <[CardItem]> stations;
    in property <[CardItem]> retrospectives;
    in property <[CardItem]> playlists;
    in property <[TrackRow]> liked;
    // Tocadas recentemente: historico local, porque o Spotify nao tem rota
    // conhecida para isso no protocolo interno.
    in property <[TrackRow]> recent;
    in property <bool> logged-in;
    in property <bool> loaded;
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback login();
    callback cancel-login();
    callback copy-auth-url();

    // Verdadeiro enquanto nenhuma secao tem conteudo: antes do login, e nos
    // segundos entre entrar e as listas chegarem.
    property <bool> empty: root.feed.length == 0
        && root.made-for-you.length == 0 && root.stations.length == 0
        && root.retrospectives.length == 0 && root.liked.length == 0
        && root.playlists.length == 0;

    background: transparent;

    // A pagina ocupa a altura que lhe derem e rola por dentro. Sem cortar a
    // altura preferida aqui, o Rectangle repassa ao layout de cima a altura do
    // conteudo inteiro: a pagina cresce alem da area util, o conteudo fica
    // cortado na base e o Flickable nunca chega a rolar.
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;

    rolagem := Flickable {
        // **So a roda rola a pagina; o arraste fica com quem esta dentro.**
        //
        // O Flickable de fora filtra o mouse antes dos de dentro e captura
        // qualquer arraste que passe de 8 px na vertical -- mesmo quando a
        // horizontal e muito maior. Na pratica, arrastar uma prateleira de
        // cartoes para o lado virava rolagem da pagina "as vezes", conforme o
        // angulo da mao. Numa interface de mouse ninguem arrasta a pagina; a
        // roda continua funcionando com `interactive: false`.
        interactive: false;
        width: 100%;
        height: 100%;
        viewport-height: sections.preferred-height;

        sections := VerticalLayout {
            spacing: Theme.space-lg;
            alignment: start;
            // O ar que o conteiner perdeu, agora rolando junto.
            padding-bottom: Theme.space-lg;

        if root.empty && !root.logged-in: EmptyState {
            altura-util: rolagem.height;
            title: "Nada por aqui ainda";
            hint: "Entre na sua conta para ver suas músicas curtidas, o que você mais ouve e suas playlists.";
            action-label: "Entrar no Spotify";
            action => { root.login(); }
        }

        if root.empty && root.logged-in && !root.loaded: EmptyState {
            altura-util: rolagem.height;
            title: "Carregando sua conta";
            hint: "Suas listas aparecem aqui em instantes.";
        }

        if root.empty && root.logged-in && root.loaded: EmptyState {
            altura-util: rolagem.height;
            title: "Sua Home está vazia";
            hint: "Ainda não há recomendações ou músicas curtidas para mostrar.";
        }

        if root.liked.length > 0: TrackShelf {
            title: "Músicas curtidas";
            tracks: root.liked;
            quiet-favorite: true;
            // A Home apresenta uma amostra; o restante continua rolando nesta
            // lista. Reserva espaco para as playlists tambem em janela menor.
            visible-height: (Layout.row-height + Theme.space-xs)
                * max(3, min(6, floor(rolagem.height * 0.45
                    / (Layout.row-height + Theme.space-xs)))) - Theme.space-xs;
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            play-next(id) => { root.play-next(id); }
            enqueue(id) => { root.enqueue(id); }
        }

        if root.recent.length > 0: TrackShelf {
            title: "Tocadas recentemente";
            tracks: root.recent;
            // Quatro linhas: e lembrete do que tocou, nao uma lista para ler.
            visible-height: (Layout.row-height + Theme.space-xs) * 4 - Theme.space-xs;
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            play-next(id) => { root.play-next(id); }
            enqueue(id) => { root.enqueue(id); }
        }

        // Na ordem que o Spotify escolheu para esta conta.
        for secao in root.feed: ScrollableCardShelf {
            title: secao.title;
            items: secao.items;
            activated(id) => { root.activated(id); }
        }

        // Antes das prateleiras recomendadas: o que o usuario montou vem antes
        // do que o Spotify sugeriu.
        if root.feed.length == 0 && root.playlists.length > 0: ScrollableCardShelf {
            title: "Suas playlists";
            items: root.playlists;
            activated(id) => { root.activated(id); }
        }

        if root.feed.length == 0 && root.made-for-you.length > 0: ScrollableCardShelf {
            title: "Feito para você";
            items: root.made-for-you;
            activated(id) => { root.activated(id); }
        }

        if root.feed.length == 0 && root.stations.length > 0: ScrollableCardShelf {
            title: "Estações recomendadas";
            items: root.stations;
            activated(id) => { root.activated(id); }
        }

        if root.feed.length == 0 && root.retrospectives.length > 0: ScrollableCardShelf {
            title: "Seus mais ouvidos";
            items: root.retrospectives;
            activated(id) => { root.activated(id); }
        }
        }
    }

    ScrollFade {
        base: Theme.background;
        active: sections.preferred-height > rolagem.height;
    }
}

// Um criterio de ordenacao da tela de detalhe.
//
// Chip e nao cabecalho de coluna de proposito: a linha de faixa mostra numero,
// titulo com artista e duracao, entao um cabecalho alinhado nao teria onde
// pendurar "artista" nem "album". O chip diz o que ordena sem fingir uma
// tabela que nao existe.
component SortChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    // Pilula sempre visivel, mesmo inativa: para a lista de buscas recentes,
    // onde cada chip e um botao e nao um criterio escolhido entre cinco.
    in property <bool> filled: false;
    callback clicked();

    height: 28px;
    width: rotulo.preferred-width + Theme.space-md * 2;
    // Pilula, como os outros controles pequenos. O ativo usa `selected` com a
    // aresta clara: `surface-raised` era quase o mesmo cinza do modulo no
    // Bruma, e o criterio escolhido nao se distinguia dos outros quatro.
    border-radius: self.height / 2;
    background: root.active
        ? Theme.selected
        : (toque.has-hover ? Theme.selected : (root.filled ? Theme.hover : transparent));
    border-width: root.active || root.filled ? Theme.border-width : 0px;
    border-color: Theme.border-highlight;
    animate background { duration: Theme.motion-fast; easing: ease; }

    rotulo := Text {
        // A seta so aparece no criterio ativo: repetida em todos, viraria
        // ruido, e num criterio inativo ela nao significa nada.
        text: root.active
            ? (root.descending ? root.label + " \u{2193}" : root.label + " \u{2191}")
            : root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.size-sm;
        font-weight: root.active ? Theme.weight-medium : Theme.weight-normal;
        font-family: Theme.font-family;
        x: Theme.space-md;
        y: (parent.height - self.height) / 2;
    }

    toque := PressableArea {
        accessible-label: "Ordenar por " + root.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        clicked => { root.clicked(); }
    }
}

component SearchPage inherits VerticalLayout {
    in property <[TrackRow]> tracks;
    in property <[CardItem]> items;
    in property <string> query;
    in property <bool> searching;
    in property <bool> logged-in;
    in property <[string]> recent-searches;
    callback clear-recent();
    callback search(string);
    callback login();
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    private property <string> pending-query;
    // Cada Ctrl+K incrementa isto na raiz; a pagina reage e poe o cursor no
    // campo. E um contador, e nao uma chamada direta, porque a instancia da
    // pagina vive dentro de um `if` da janela e nao tem id alcancavel de fora.
    in property <int> foco-pedido: 0;
    changed foco-pedido => { campo.focar(); }

    debounce := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.search(root.pending-query);
        }
    }

    spacing: Theme.space-md;

    // O `VerticalLayout` estica o filho na largura inteira e ignora o
    // `max-width` dele; numa linha propria com `alignment: start` o teto vale.
    HorizontalLayout {
        alignment: start;
        campo := SearchField {
            // Campo de 1300 px numa janela maximizada e uma faixa, nao um campo:
            // o olho nao acha onde escrever. O teto e o de uma linha de busca
            // confortavel; o resto da largura fica para os resultados.
            preferred-width: 640px;
            max-width: 640px;
            horizontal-stretch: 1;
            placeholder: "O que você quer ouvir?";
            text: root.query;
            edited(q) => {
                root.pending-query = q;
                debounce.running = false;
                if q.is-empty { root.search(""); }
                else { debounce.running = true; }
            }
            accepted(q) => {
                debounce.running = false;
                root.search(q);
            }
        }
    }

    if root.searching: EmptyState {
        vertical-stretch: 1;
        title: "Buscando";
        hint: "Procurando faixas, álbuns, artistas e playlists para você.";
    }

    // Buscas recentes: um clique repete a busca. So o que levou a um clique
    // num resultado entra aqui (ver `play_track`), nao cada letra digitada.
    if !root.searching && root.query == "" && root.recent-searches.length > 0: Prateleira {
        HorizontalLayout {
            SectionTitle { text: "Buscas recentes"; horizontal-stretch: 1; }
            GhostButton {
                label: "Limpar";
                clicked => { root.clear-recent(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;
            // Mesmo recuo do titulo (`SectionTitle` recua `space-sm`).
            padding-left: Theme.space-sm;
            for termo in root.recent-searches: SortChip {
                label: termo;
                filled: true;
                clicked => { root.search(termo); }
            }
        }
    }

    if !root.searching && root.query == "" && root.recent-searches.length > 0: Rectangle {
        vertical-stretch: 1;
    }

    if !root.searching && root.tracks.length == 0 && root.items.length == 0 && root.query == "" && root.recent-searches.length == 0: EmptyState {
        vertical-stretch: 1;
        title: "Busque por música";
        hint: "Digite uma faixa, álbum, artista ou playlist. A busca começa enquanto você escreve.";
    }

    // Sem sessao, nao existe uma consulta ao catalogo para falhar. Dizer que
    // nao houve resultado escondia a causa e mandava a pessoa revisar um termo
    // que ainda nem pode ser pesquisado.
    if !root.searching && !root.logged-in && root.tracks.length == 0 && root.items.length == 0 && root.query != "": EmptyState {
        vertical-stretch: 1;
        title: "Entre para buscar";
        hint: "Conecte sua conta do Spotify para pesquisar faixas, álbuns, artistas e playlists.";
        action-label: "Entrar no Spotify";
        action => { root.login(); }
    }

    if !root.searching && root.logged-in && root.tracks.length == 0 && root.items.length == 0 && root.query != "": EmptyState {
        vertical-stretch: 1;
        title: "Nenhum resultado";
        hint: "Tente outro termo ou confira a escrita de \"" + root.query + "\".";
    }

    // Os resultados vao dentro de um Rectangle, e nao soltos no layout.
    //
    // Um Flickable como filho direto de layout nao tem largura propria para
    // oferecer, e o layout de cima passa a resolver a pagina pela largura
    // PREFERIDA do conteudo -- que numa lista de faixas e o talo do texto
    // elidido. A pagina inteira encolhia junto, campo de busca incluido, e o
    // resto da janela ficava vazio. Com o estado vazio isso nao aparecia,
    // porque ali nao ha Flickable nenhum.
    //
    // E o mesmo arranjo da pagina de biblioteca, que nunca teve o defeito:
    // caixa que ocupa o que lhe derem, Flickable colado nela por dentro.
    if !root.searching && (root.tracks.length > 0 || root.items.length > 0): Rectangle {
        background: transparent;
        min-height: 0px;
        preferred-height: 0px;
        vertical-stretch: 1;

        Flickable {
            // Roda, nao arraste: ver a nota na Home.
            interactive: false;
        width: 100%;
        height: 100%;
        viewport-height: results.preferred-height;

        results := VerticalLayout {
            spacing: Theme.space-lg;
            alignment: start;
            padding-bottom: Theme.space-lg;

            if root.tracks.length > 0: TrackShelf {
                title: "Faixas";
                tracks: root.tracks;
                activated(id) => { root.activated(id); }
                favorite-toggled(id) => { root.favorite-toggled(id); }
                play-next(id) => { root.play-next(id); }
                enqueue(id) => { root.enqueue(id); }
            }

            if root.items.length > 0: Prateleira {
                SectionTitle { text: "Álbuns, artistas e playlists"; }
                CardCollection {
                    items: root.items;
                    activated(id) => { root.activated(id); }
                }
            }
        }
        }
    }
}

component LibraryPage inherits Rectangle {
    in property <[CardItem]> items;
    // Playlists da conta, as mesmas da barra lateral. O Spotify mostra as
    // tres coisas juntas na biblioteca; sem elas, quem nao salva album via uma
    // biblioteca so de artistas.
    in property <[CardItem]> playlists;
    property <bool> tem-algo: root.items.length > 0 || root.playlists.length > 0;
    in property <bool> logged-in;
    in property <bool> loaded;
    callback login();
    callback cancel-login();
    callback copy-auth-url();
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback explore();

    background: transparent;

    // A pagina ocupa a altura que lhe derem e rola por dentro. Sem cortar a
    // altura preferida aqui, o Rectangle repassa ao layout de cima a altura do
    // conteudo inteiro: a pagina cresce alem da area util, o conteudo fica
    // cortado na base e o Flickable nunca chega a rolar.
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;

    rolagem := Flickable {
        // Roda, nao arraste: ver a nota na Home.
        interactive: false;
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;

        content := VerticalLayout {
        spacing: Theme.space-lg;
        alignment: start;
        padding-bottom: Theme.space-lg;

        // O titulo so aparece quando ha o que listar. Com ele, o estado vazio
        // recebe a altura da pagina INTEIRA e o viewport passa a ser maior que
        // a area visivel: a tela vazia rolava. E o proprio estado vazio ja diz
        // onde voce esta -- "Sua biblioteca comeca aqui".
        if root.tem-algo: PageTitle { text: "Biblioteca"; }

        if !root.tem-algo && !root.logged-in: EmptyState {
            altura-util: rolagem.height;
            title: "Sua biblioteca começa aqui";
            hint: "Entre no Spotify para ver sua biblioteca e suas Músicas curtidas.";
            action-label: "Entrar no Spotify";
            action => { root.login(); }
        }

        if !root.tem-algo && root.logged-in && !root.loaded: EmptyState {
            altura-util: rolagem.height;
            title: "Carregando sua biblioteca";
            hint: "Suas músicas salvas aparecem aqui em instantes.";
        }

        if !root.tem-algo && root.logged-in && root.loaded: EmptyState {
            altura-util: rolagem.height;
            title: "Sua biblioteca está vazia";
            hint: "Use o coração para salvar no Spotify. Suas Músicas curtidas ficam na barra lateral.";
            action-label: "Explorar músicas";
            action => { root.explore(); }
        }

        if root.playlists.length > 0: Prateleira {
            SectionTitle { text: "Playlists"; }
            CardCollection {
                items: root.playlists;
                legenda: false;
                activated(id) => { root.activated(id); }
            }
        }

        if root.items.length > 0: Prateleira {
            SectionTitle { text: "Álbuns e artistas"; }
            CardCollection {
                items: root.items;
                activated(id) => { root.activated(id); }
            }
        }

        }
    }

    ScrollFade {
        base: Theme.background;
        active: content.preferred-height > rolagem.height;
    }
}


// Uma lista aberta: playlist, album, artista ou as curtidas.
//
// Existe porque ativar um card tocava direto, e isso tira da pessoa a escolha
// mais basica -- qual faixa ela quer. Aqui ela le antes de tocar, procura, e
// ordena do jeito que preferir.
component DetailPage inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    in property <image> cover;
    in property <string> cover-initial;
    in property <float> cover-hue;
    in property <bool> cover-pending;
    in property <[TrackRow]> tracks;
    in property <[CardItem]> items;
    in property <int> sort;
    in property <bool> descending;
    in property <bool> filtered;
    in property <bool> has-more;
    in property <bool> loading;
    in property <int> loaded-count;

    // "Salvar"/"Seguir" ao lado de Tocar; vazio = sem botao (playlist, curtidas).
    in property <string> save-label;
    callback toggle-save();
    callback back();
    callback play();
    callback filter(string);
    callback sort-by(int);
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback load-more();

    // Entrada da tela.
    //
    // **Por que ha movimento aqui e quase em lugar nenhum.** Abrir uma lista e
    // o gesto de navegacao principal do aplicativo, e ate agora era um corte
    // seco: a tela inteira trocava de conteudo entre dois quadros. Um fade
    // curto e o que separa "navegou" de "piscou".
    //
    // **Nao ha portao de tela cheia a acrescentar aqui:** a duracao vem de
    // `motion-slow`, e um tema que quer movimento zero ja zera os tokens de
    // movimento -- e ai isto vira a troca instantanea de antes, sem nenhum
    // caminho de codigo novo. `motion-slow` estava declarado com zero usos.
    // **A entrada mora no cabecalho, e nao na raiz.** Opacidade parcial num pai
    // faz o renderizador compor a subarvore inteira numa camada: com ela aqui,
    // eram o cabecalho, o filtro, os chips e as cem linhas da lista, com capa em
    // cada uma, compostos a cada quadro por 320 ms. A lista aparecer pronta nao
    // e perda -- o que precisava de transicao era a troca de contexto, e quem
    // conta isso e o cabecalho.
    private property <bool> entrou: false;
    init => { root.entrou = true; }

    // **Esta pagina nao tinha `spacing`, e as outras quatro tinham.**
    //
    // `VerticalLayout` sem `spacing` empilha com zero, e o respiro que sobrava
    // vinha do recheio de cada peca -- que nao existe em todas. Medido na captura
    // do detalhe de "Musicas curtidas": entre a base da capa e o campo de filtro
    // havia **1px**, e entre o campo e a linha do "Mostrando" havia **0**. As
    // tres pecas encostavam umas nas outras, e logo abaixo vinha um vao de 59px
    // ate os chips de ordenacao. Nao era ritmo apertado, era ritmo nenhum.
    spacing: Theme.space-md;

    // **Dois modulos, e nao cinco faixas soltas.** Voltar, capa, filtro, a
    // contagem e a ordenacao eram cinco bandas empilhadas sobre o fundo, cada
    // uma com o seu vao -- e no Bruma, sobre um papel de parede claro, o
    // titulo e os chips perdiam contraste por nao terem chao. Agora: o
    // cabecalho num modulo, e tudo o que mexe na lista dentro do modulo da
    // lista. Nos temas sem material os modulos nao pintam nada.
    private property <bool> modulo: Theme.material-kind == 2;

    Rectangle {
        vertical-stretch: 0;
        border-radius: root.modulo ? Theme.radius-lg : 0px;
        clip: root.modulo;
        background: root.modulo ? Theme.surface : transparent;
        if root.modulo: Glass { radius: parent.border-radius; }

        VerticalLayout {
            padding: root.modulo ? Theme.space-md : 0px;
            spacing: Theme.space-md;

            HorizontalLayout {
                alignment: start;
                GhostButton {
                    label: "\u{2190} Voltar";
                    clicked => { root.back(); }
                }
            }

            // Cabecalho: capa grande, tipo, nome e o que ha dentro.
            //
            // **`show-hero` e `hero-height` passam a valer aqui.** Os dois estavam
            // declarados no tema com zero usos em qualquer linha de interface, e era
            // parte da razao de trocar de tema quase nao mudar nada. Agora o portao
            // escolhe entre um cabecalho de vitrine -- capa no tamanho do token, nome em
            // `size-display` -- e um compacto, para quem quer mais lista na tela.
            //
            // A capa tambem parou de ser cortada em 128px: o tema pedia 160 e o
            // `min(...)` embutido no codigo mandava mais que o tema.
            HorizontalLayout {
                spacing: Theme.space-lg;
                vertical-stretch: 0;
                // O hero acompanha a capa. O token continua sendo o teto de altura,
                // sem deixar uma faixa vazia entre o botao Voltar e o album/artista.
                min-height: Layout.show-hero
                    ? min(Layout.hero-height, Layout.detail-cover-size)
                    : 0px;

                opacity: root.entrou ? 1.0 : 0.0;
                animate opacity {
                    duration: Theme.motion-slow;
                    // Rapida no comeco e assentando no fim: e como a tela chega, e nao
                    // como ela e empurrada.
                    easing: ease-out;
                }

                Artwork {
                    source: root.cover;
                    initial: root.cover-initial;
                    hue: root.cover-hue;
                    pending: root.cover-pending;
                    width: Layout.show-hero ? Layout.detail-cover-size : 96px;
                    height: self.width;
                    // Pela base, e nao pelo centro. O bloco de texto ao lado e
                    // `alignment: end`, entao centralizar a capa deixava a capa
                    // terminando 40px acima do botao Tocar -- duas coisas do mesmo
                    // cabecalho apoiadas em linhas diferentes.
                    //
                    // Os 8px somados na entrada sao a fisicalidade que faltava: nada no
                    // mundo real aparece por transparencia, aparece chegando de algum
                    // lugar. Poucos de proposito -- o bastante para o olho ler
                    // "chegou", pouco para nao virar animacao de apresentacao. Vai no
                    // `y` dos filhos porque num `HorizontalLayout` quem e gerenciado e
                    // o `x`; o `y` do proprio cabecalho seria engolido pelo layout de
                    // cima.
                    y: parent.height - self.height + (root.entrou ? 0px : 8px);
                    animate y { duration: Theme.motion-slow; easing: ease-out; }
                }

                VerticalLayout {
                    alignment: end;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    y: root.entrou ? 0px : 8px;
                    animate y { duration: Theme.motion-slow; easing: ease-out; }

                    Text {
                        text: root.kind;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }

                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Layout.show-hero ? Theme.size-display : Theme.size-xl;
                        font-weight: Theme.weight-bold;
                        // O unico lugar da interface com `display-family`: e o titulo
                        // grande, que e onde uma serifa acrescenta e onde ela nao
                        // atrapalha a leitura de rotulo pequeno. Tema de uma familia so
                        // recebe a mesma de sempre.
                        font-family: Theme.display-family;
                        overflow: elide;
                    }

                    Text {
                        text: root.subtitle;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        alignment: start;
                        padding-top: Theme.space-sm;
                        spacing: Theme.space-sm;

                        tocar := PrimaryButton {
                            label: "Tocar";
                            clicked => { root.play(); }
                        }

                        // Mesma altura do Tocar: dois botoes lado a lado com
                        // alturas diferentes parecem de duas familias.
                        if root.save-label != "": GhostButton {
                            label: root.save-label;
                            height: tocar.height;
                            clicked => { root.toggle-save(); }
                        }
                    }
                }
            }
        }
    }

    if root.items.length > 0: ScrollableCardShelf {
        title: "Discografia";
        items: root.items;
        activated(id) => { root.activated(id); }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: root.modulo ? Theme.radius-lg : 0px;
        clip: root.modulo;
        background: root.modulo ? Theme.surface : transparent;
        if root.modulo: Glass { radius: parent.border-radius; }

        VerticalLayout {
            padding: root.modulo ? Theme.space-md : 0px;
            spacing: Theme.space-sm;

            // Barra da lista: filtrar e quantas ha, numa linha; ordenar, na
            // outra. Duas linhas e nao uma porque os chips nao encolhem, e numa
            // janela estreita uma linha so estouraria para fora do modulo.
            HorizontalLayout {
                spacing: Theme.space-md;
                vertical-stretch: 0;

                SearchField {
                    placeholder: "Filtrar nesta lista";
                    preferred-width: 360px;
                    max-width: 360px;
                    edited(q) => { root.filter(q); }
                }

                Rectangle { horizontal-stretch: 1; }

                if root.has-more || root.loading: Text {
                    // "Mostrando", e nao "carregadas": quem le quer saber o que
                    // esta vendo, nao o que o programa terminou de fazer.
                    text: root.loading
                        ? "Carregando..."
                        : root.loaded-count == 1
                            ? "Mostrando 1 faixa"
                            : "Mostrando " + root.loaded-count + " faixas";
                    color: Theme.text-muted;
                    font-size: Theme.size-sm;
                    font-family: Theme.font-family;
                    vertical-alignment: center;
                }

                if root.has-more && !root.loading: GhostButton {
                    label: "Mostrar mais";
                    y: (parent.height - self.height) / 2;
                    clicked => { root.load-more(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;
                vertical-stretch: 0;

                Text {
                    text: "Ordenar por";
                    color: Theme.text-muted;
                    font-size: Theme.size-sm;
                    font-family: Theme.font-family;
                    vertical-alignment: center;
                }

                SortChip {
                    label: "Ordem da lista";
                    active: root.sort == 0;
                    descending: root.descending;
                    clicked => { root.sort-by(0); }
                }
                SortChip {
                    label: "Título";
                    active: root.sort == 1;
                    descending: root.descending;
                    clicked => { root.sort-by(1); }
                }
                SortChip {
                    label: "Artista";
                    active: root.sort == 2;
                    descending: root.descending;
                    clicked => { root.sort-by(2); }
                }
                SortChip {
                    label: "Álbum";
                    active: root.sort == 3;
                    descending: root.descending;
                    clicked => { root.sort-by(3); }
                }
                SortChip {
                    label: "Duração";
                    active: root.sort == 4;
                    descending: root.descending;
                    clicked => { root.sort-by(4); }
                }
            }

            // Lista vazia com filtro e outra coisa de lista vazia sem: uma diz
            // que a busca nao achou, a outra que nao ha nada.
            if root.tracks.length == 0 && root.filtered: EmptyState {
                vertical-stretch: 1;
                title: "Nada com esse texto";
                hint: "Nenhuma faixa desta lista combina com o que você digitou.";
            }

            if root.kind == "Artista" && root.tracks.length > 0: SectionTitle {
                text: "Faixas populares";
            }

            if root.tracks.length > 0: TrackList {
                vertical-stretch: 1;
                tracks: root.tracks;
                has-more: root.has-more;
                loading: root.loading;
                nearing-end => { root.load-more(); }
                activated(id) => { root.activated(id); }
                favorite-toggled(id) => { root.favorite-toggled(id); }
                play-next(id) => { root.play-next(id); }
                enqueue(id) => { root.enqueue(id); }
            }
        }
    }
}

component ManagedQueueShelf inherits Prateleira {
    in property <[TrackRow]> tracks;
    callback activated(int);
    callback favorite-toggled(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback clear();

    spacing: Theme.space-xs;

    HorizontalLayout {
        SectionTitle { text: "Tocará a seguir"; horizontal-stretch: 1; }
        GhostButton {
            label: "Limpar";
            clicked => { root.clear(); }
        }
    }

    for track[i] in root.tracks: TrackListRow {
        track: track;
        index: i;
        queue-actions: false;
        queue-management: true;
        can-move-up: i > 0;
        can-move-down: i + 1 < root.tracks.length;
        activated => { root.activated(i); }
        favorite-toggled => { root.favorite-toggled(track.id); }
        remove-queued => { root.remove-queued(i); }
        move-up => { root.move-queued(i, i - 1); }
        move-down => { root.move-queued(i, i + 1); }
    }
}

component QueuePage inherits Rectangle {
    in property <[TrackRow]> manual-tracks;
    in property <[TrackRow]> context-tracks;
    // A faixa tocando, para a Fila comecar por ela. "Da lista atual" sem a
    // atual e uma lista de proximas sem o ponto de partida.
    in property <bool> has-track;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-cover;
    in property <string> now-cover-initial;
    in property <float> now-cover-hue;
    in property <bool> now-cover-pending;
    callback activated(string);
    callback activate-manual(int);
    callback favorite-toggled(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback clear();
    callback explore();
    callback hide(string);

    background: transparent;

    // A pagina ocupa a altura que lhe derem e rola por dentro. Sem cortar a
    // altura preferida aqui, o Rectangle repassa ao layout de cima a altura do
    // conteudo inteiro: a pagina cresce alem da area util, o conteudo fica
    // cortado na base e o Flickable nunca chega a rolar.
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;

    rolagem := Flickable {
        // Roda, nao arraste: ver a nota na Home.
        interactive: false;
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;

        content := VerticalLayout {
        spacing: Theme.space-lg;
        alignment: start;
        padding-bottom: Theme.space-lg;

        // Como na Biblioteca: o titulo so aparece quando ha o que listar. Com
        // ele, o estado vazio nao podia ocupar a altura inteira e ficava colado
        // no topo -- enquanto o da Busca, sem titulo, ficava no meio.
        if root.has-track || root.manual-tracks.length > 0 || root.context-tracks.length > 0: PageTitle { text: "Fila"; }

        // **Tocando agora.** A vitrine da faixa atual: capa grande, titulo no
        // tamanho de destaque. E o que o Spotify chama de "Now Playing" -- aqui
        // no topo da Fila, que e onde o "a seguir" ja mora, em vez de um painel
        // a mais disputando largura com a pagina.
        if root.has-track: Prateleira {
            HorizontalLayout {
                spacing: Theme.space-lg;
                // Recuo do titulo de secao, para a capa alinhar com o
                // "Da lista atual" logo abaixo.
                padding-left: Theme.space-sm;

                Artwork {
                    source: root.now-cover;
                    initial: root.now-cover-initial;
                    hue: root.now-cover-hue;
                    pending: root.now-cover-pending;
                    width: Layout.detail-cover-size;
                    height: self.width;
                }

                VerticalLayout {
                    alignment: end;
                    spacing: Theme.space-xs;
                    horizontal-stretch: 1;
                    min-width: 0px;

                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        alignment: start;
                        Icon {
                            glyph: Icons.playing;
                            tint: Theme.live-accent;
                            size: Theme.size-sm;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Tocando agora";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.now-title;
                        color: Theme.text;
                        font-size: Theme.size-display;
                        font-weight: Theme.weight-bold;
                        font-family: Theme.display-family;
                        overflow: elide;
                    }

                    Text {
                        text: root.now-artist;
                        color: Theme.text-muted;
                        font-size: Theme.size-md;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }
                }
            }
        }

        if !root.has-track && root.manual-tracks.length == 0 && root.context-tracks.length == 0: EmptyState {
            altura-util: rolagem.height;
            title: "Fila vazia";
            hint: "Use os controles de uma faixa para tocá-la a seguir ou adicionar ao fim.";
            action-label: "Buscar música";
            action => { root.explore(); }
        }

        if root.manual-tracks.length > 0: ManagedQueueShelf {
            tracks: root.manual-tracks;
            activated(i) => { root.activate-manual(i); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            remove-queued(i) => { root.remove-queued(i); }
            move-queued(from, to) => { root.move-queued(from, to); }
            clear => { root.clear(); }
        }

        if root.context-tracks.length > 0: TrackShelf {
            title: root.manual-tracks.length > 0 ? "Depois, da lista atual" : "Da lista atual";
            tracks: root.context-tracks;
            queue-actions: false;
            hide-action: true;
            hide(id) => { root.hide(id); }
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
        }
        }
    }

    ScrollFade {
        base: Theme.background;
        active: content.preferred-height > rolagem.height;
    }
}

// Previa de um tema: uma janela do Morune em miniatura, pintada com as cores
// do proprio tema.
//
// **Nao e uma captura de tela.** Renderizar cada tema fora da tela exigiria o
// codificador de PNG no executavel -- deliberadamente fora do build de release
// para nao engordar o instalador -- e uma janela por tema na abertura. Este
// desenho custa cinco retangulos, esta sempre atualizado (inclusive logo depois
// de a pessoa salvar o TOML) e mostra o que importa na hora de escolher: a
// relacao entre fundo, painel, barra e destaque.
component ThemePreviewChip inherits Rectangle {
    in property <ThemeItem> item;

    width: 56px;
    height: 38px;
    border-radius: Theme.radius-sm;
    border-width: Theme.border-width;
    border-color: Theme.border;
    background: root.item.preview-background;
    clip: true;

    // Barra lateral, com um fio a separar.
    //
    // O fio existe porque quase todo tema usa fundo e barra lateral em tons
    // vizinhos: sem ele a previa vira um retangulo chapado e nao se ve que ha
    // uma barra ali. E o mesmo recurso que a interface de verdade usa -- linha
    // em vez de sombra.
    Rectangle {
        x: 0;
        y: 0;
        width: 16px;
        height: 100%;
        background: root.item.preview-sidebar;
    }

    Rectangle {
        x: 16px;
        y: 0;
        width: 1px;
        height: 100%;
        background: root.item.preview-text;
        opacity: 0.18;
    }

    // Duas linhas de conteudo, para a cor de superficie aparecer.
    Rectangle {
        x: 21px;
        y: 7px;
        width: 28px;
        height: 6px;
        border-radius: 2px;
        background: root.item.preview-surface;
    }

    Rectangle {
        x: 21px;
        y: 16px;
        width: 18px;
        height: 6px;
        border-radius: 2px;
        background: root.item.preview-text;
        opacity: 0.55;
    }

    // Barra de reproducao, com o botao primario em destaque.
    Rectangle {
        x: 0;
        y: parent.height - 11px;
        width: 100%;
        height: 11px;
        background: root.item.preview-player;
    }

    Rectangle {
        x: 0;
        y: parent.height - 11px;
        width: 100%;
        height: 1px;
        background: root.item.preview-text;
        opacity: 0.18;
    }

    Rectangle {
        x: 25px;
        y: parent.height - 9px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.item.preview-accent;
    }
}

// Uma opcao de dispositivo de saida.
//
// Mesma anatomia de `ThemeRow`, sem a previa: a linha inteira e o alvo, o
// estado ativo vem do tema e o rotulo elide quando o nome do dispositivo e
// longo -- o Windows entrega nomes como "Alto-falantes (Realtek(R) Audio)".
component OutputDeviceRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.motion-fast; easing: ease; }

    touch := PressableArea {
        accessible-label: root.active
            ? "Saída " + root.label + ", em uso"
            : "Usar a saída " + root.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        focus-radius: Theme.radius-sm;
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.size-sm;
            font-weight: root.active ? Theme.weight-medium : Theme.weight-normal;
            font-family: Theme.font-family;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // `text`, e nao `accent`: a linha ativa ja tem `selected` de fundo, que
        // agora e o proprio accent diluido. Accent sobre accent nao le.
        if root.active: Text {
            text: "Em uso";
            color: Theme.text;
            font-size: Theme.size-xs;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
    }
}

component ThemeRow inherits Rectangle {
    in property <ThemeItem> item;
    callback selected();
    callback export-pack();
    callback duplicate();

    height: 56px;
    border-radius: Theme.radius-md;
    background: root.item.active ? Theme.selected : (touch.has-hover ? Theme.hover : Theme.surface);
    border-width: Theme.border-width;
    border-color: Theme.border;
    animate background { duration: Theme.motion-fast; easing: ease; }

    // Abre sob o cursor, como o cartao de playlist.
    Vidro {
        radius: parent.border-radius;
        forca: root.item.active ? 0.6 : (touch.has-hover ? 0.6 : 0.45);
    }

    // Fica atras do conteudo: os botoes Duplicar e Exportar continuam com
    // alvos independentes, em vez de o clique ser roubado pela linha inteira.
    touch := PressableArea {
        accessible-label: root.item.active
            ? "Tema " + root.item.name + ", ativo"
            : "Usar tema " + root.item.name;
        accessible-checkable: true;
        accessible-checked: root.item.active;
        focus-radius: Theme.radius-md;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;

        ThemePreviewChip {
            item: root.item;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.size-md;
                font-weight: root.item.active ? Theme.weight-medium : Theme.weight-normal;
                font-family: Theme.font-family;
                overflow: elide;
            }

            Text {
                text: root.item.builtin
                    ? "Embutido"
                    : (root.item.author == "" ? root.item.id : root.item.author);
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
            }
        }

        // Mesmo motivo do "Em uso" da saida de audio: o fundo da linha ativa e
        // `selected`, que deriva do accent.
        if root.item.active: Text {
            text: "Ativo";
            color: Theme.text;
            font-size: Theme.size-sm;
            font-weight: Theme.weight-medium;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }

        GhostButton {
            label: "Duplicar";
            y: (parent.height - self.height) / 2;
            clicked => { root.duplicate(); }
        }

        if !root.item.builtin: GhostButton {
            label: "Exportar";
            y: (parent.height - self.height) / 2;
            clicked => { root.export-pack(); }
        }
    }
}

// Titulo de grupo das Configuracoes.
//
// **Mais ar em cima do que embaixo.** Com o `spacing` da pagina valendo igual
// para os dois lados, "Comportamento" ficava a 20 px da dica do grupo de cima e
// a 20 px do primeiro ajuste do proprio grupo -- o olho nao sabia a qual dos
// dois o titulo pertencia. Proximidade e o que diz "isto e de baixo".
component SettingsGroupTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: Theme.space-lg;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.size-md;
        font-weight: Theme.weight-bold;
        font-family: Theme.font-family;
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);

    height: 44px;

    touch := PressableArea {
        accessible-role: switch;
        accessible-label: root.label;
        accessible-description: root.hint;
        accessible-checkable: true;
        accessible-checked: root.checked;
        clicked => { root.toggled(!root.checked); }
    }

    HorizontalLayout {
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                overflow: elide;
            }

            Text {
                text: root.hint;
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
                overflow: elide;
            }
        }

        Toggle {
            label: root.label;
            checked: root.checked;
            interactive: false;
            y: (parent.height - self.height) / 2;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// Ajuste continuo, no mesmo molde do `SettingRow`: rotulo, explicacao e o
// controle a direita. O valor aparece escrito porque um slider sozinho nao diz
// onde esta -- e estes mexem em aparencia, que a pessoa vai querer repetir.
component SettingSlider inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> value-text;
    in property <float> value;
    /// Aplica so ao soltar o controle. Para ajustes que refazem a imagem.
    in property <bool> pesado: false;
    callback changed(float);

    height: 44px;

    HorizontalLayout {
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                overflow: elide;
            }

            Text {
                text: root.hint;
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
                overflow: elide;
            }
        }

        Text {
            text: root.value-text;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            width: 44px;
            horizontal-alignment: right;
        }

        Slider {
            label: root.label;
            width: 140px;
            value: root.value;
            y: (parent.height - self.height) / 2;
            // `pesado`: so ao soltar. Um ajuste que refaz a imagem de fundo
            // custa centenas de milissegundos; aplicado a cada pixel de
            // arraste, travava a tela.
            changed(v) => { if !root.pesado { root.changed(v); } }
            committed(v) => { root.changed(v); }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <[ThemeItem]> themes;
    in property <[Diagnostic]> diagnostics;
    in property <bool> dev-mode;
    in property <bool> logged-in;
    in property <string> account-name;
    in property <string> account-initial;
    in property <string> auth-url;
    in property <image> account-avatar;
    in property <bool> close-to-tray;
    in property <bool> autoplay;
    in property <int> bitrate;
    in property <bool> normalize;
    in property <[string]> output-devices;
    in property <string> output-device;
    in property <bool> start-with-windows;

    in property <bool> has-background;
    in property <string> background-name;
    // 0 = cover, 1 = contain, 2 = center, 3 = stretch
    in property <int> background-fit;
    in property <float> background-opacity;
    in property <float> background-tint;
    in property <float> background-blur;
    in property <float> glass-blur;
    in property <float> font-scale;
    in property <float> window-opacity;
    in property <bool> reduce-motion;
    in property <bool> hot-reload;

    in property <int> update-phase;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress;

    callback choose-background();
    callback clear-background();
    callback set-background-fit(int);
    callback set-background-opacity(float);
    callback set-background-tint(float);
    callback set-background-blur(float);
    callback set-glass-blur(float);
    callback set-font-scale(float);
    callback set-window-opacity(float);
    callback set-reduce-motion(bool);
    callback set-hot-reload(bool);

    callback check-update();
    callback download-update();
    callback install-update();
    callback open-releases-page();

    callback set-close-to-tray(bool);
    callback set-autoplay(bool);
    callback set-bitrate(int);
    callback set-normalize(bool);
    callback set-output-device(string);
    callback set-start-with-windows(bool);
    callback select-theme(string);
    callback import-theme();
    callback export-theme(string);
    callback duplicate-theme(string);
    callback reset-theme();
    callback open-theme-folder();
    callback reload-theme();
    callback login();
    callback cancel-login();
    callback copy-auth-url();
    callback logout();

    spacing: Theme.space-md;

    // A pagina inteira rola.
    //
    // Antes eram duas areas: um bloco fixo em cima e a lista de temas rolando
    // embaixo. Com a secao de Aparencia o bloco fixo passou a pedir mais altura
    // que a janela tem, comeu a lista inteira e nao havia como chegar nela --
    // dois visores de rolagem na mesma tela tambem deixavam ambiguo qual deles
    // a roda do mouse move. Um visor so resolve as duas coisas.
    Flickable {
        // Roda, nao arraste: ver a nota na Home.
        interactive: false;
        viewport-height: pagina.preferred-height;
        // **Formulario tem largura de formulario.** Em janela larga, o rotulo
        // ficava na esquerda e o interruptor a 1500 px dele, na direita: a
        // linha era uma so, mas o olho nao ligava "Nivelar o volume" ao
        // controle. 960 px e o bastante para o texto de ajuda numa linha e
        // curto o bastante para rotulo e controle serem lidos juntos. Fica
        // alinhado a esquerda, com o titulo da pagina.
        private property <length> largura-do-formulario: min(self.width, 960px);

        // Formulario: protecao local para os textos pequenos sobre a fotografia.
        // Nao altera o campo central das demais paginas nem os temas legados.
        Rectangle {
            x: 0; y: 0;
            width: parent.largura-do-formulario;
            height: pagina.preferred-height;
            border-radius: Theme.material-kind == 1 ? Theme.radius-lg : Theme.radius-md;
            background: Theme.material-kind == 2 ? Theme.surface : transparent;
            clip: Theme.material-kind == 1;

            // No Aero as Configuracoes sao um grupo so, e ganham a mesma
            // moldura de vidro dos grupos do Inicio. Sem ela a pagina era
            // texto solto sobre a foto: "nao da para ver nada".
            if Theme.material-kind == 1: Vidro { radius: parent.border-radius; tinta: Theme.surface; }
            if Theme.material-kind == 1: Glass { radius: parent.border-radius; }
        }

        pagina := VerticalLayout {
            // `x: 0` explicito: filho com largura propria e sem `x` o Slint
            // centraliza, e o formulario saia do meio da moldura de vidro.
            x: 0;
            width: parent.largura-do-formulario;
            spacing: Theme.space-md;
            alignment: start;
            padding-left: Theme.material-kind > 0 ? Theme.space-md : 0px;
            padding-right: Theme.material-kind > 0 ? Theme.space-md : 0px;
            padding-top: Theme.material-kind > 0 ? Theme.space-md : 0px;
            padding-bottom: Theme.space-lg;

            // Ja esta dentro do painel do formulario: pastilha aqui seria caixa
            // dentro de caixa.
            PageTitle { text: "Configurações"; chip: false; }

            // Cartao da conta.
            //
            // Era uma linha de texto secundario com um botao ao lado, do mesmo
            // peso visual de um ajuste qualquer -- e a conta e a primeira coisa
            // da tela, nao um ajuste. Aqui ela ganha avatar, o nome em texto
            // primario e uma segunda linha dizendo o que aquilo e.
            Rectangle {
                height: 64px;
                border-radius: Theme.radius-md;
                background: Theme.surface;
                border-width: Theme.border-width;
                border-color: Theme.border;

                // Painel de conteudo sobre o fundo da janela: vidro aqui nao
                // empilha com nada. Mais fraco que a moldura porque tem texto
                // pequeno em cima, e texto pequeno pede fundo calmo.
                Vidro { radius: parent.border-radius; forca: 0.45; }

                HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-right: Theme.space-md;
                    spacing: Theme.space-md;

                    if root.logged-in: AccountAvatar {
                        initial: root.account-initial;
                        source: root.account-avatar;
                        size: 40px;
                        y: (parent.height - self.height) / 2;
                    }

                    // Sem sessao o avatar seria um circulo com "?" -- a marca
                    // diz melhor que ali ainda nao ha ninguem.
                    if !root.logged-in: Logo {
                        size: 40px;
                        tint: Theme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: root.logged-in ? root.account-name : "Não conectado";
                            color: Theme.text;
                            font-size: Theme.size-lg;
                            font-weight: Theme.weight-medium;
                            font-family: Theme.font-family;
                            overflow: elide;
                        }

                        Text {
                            text: root.logged-in
                                ? "Conectado ao Spotify"
                                : "Entre para ouvir sua biblioteca.";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                            overflow: elide;
                        }
                    }

                    if !root.logged-in && root.auth-url == "": PrimaryButton {
                        label: "Entrar no Spotify";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.login(); }
                    }

                    // Enquanto ha login em andamento, entrar de novo nao e o
                    // que ajuda -- desistir e levar o link para outro navegador
                    // sao.
                    if root.auth-url != "": GhostButton {
                        label: "Cancelar";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.cancel-login(); }
                    }

                    if root.logged-in: GhostButton {
                        label: "Sair";
                        danger: true;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.logout(); }
                    }
                }
            }

            // O link do login, enquanto ele existe.
            //
            // So aparece durante uma tentativa: um endereco de OAuth ocupa duas
            // linhas e nao tem por que estar na tela no caminho que funciona. E
            // a saida de quem tem mais de um navegador -- o Morune abre o padrao
            // do sistema, que pode ser o perfil errado.
            if root.auth-url != "": Rectangle {
                height: login.preferred-height + Theme.space-md * 2;
                border-radius: Theme.radius-md;
                background: Theme.surface;
                border-width: Theme.border-width;
                border-color: Theme.border;

                Vidro { radius: parent.border-radius; forca: 0.45; }

                login := VerticalLayout {
                    x: Theme.space-md;
                    y: Theme.space-md;
                    width: parent.width - Theme.space-md * 2;
                    spacing: Theme.space-sm;

                    Text {
                        text: "Abriu no navegador errado? Copie o link e cole no navegador da sua conta.";
                        color: Theme.text;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.auth-url;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        height: 34px;

                        PrimaryButton {
                            label: "Copiar link";
                            clicked => { root.copy-auth-url(); }
                        }
                    }
                }
            }

            SettingsGroupTitle { text: "Atualizações"; }

            // A altura vem do conteudo porque o bloco muda de tamanho com a
            // fase: parado sao duas linhas, com versao nova sao as notas do
            // lancamento inteiras. Uma altura fixa cortaria o texto justamente
            // no estado que a pessoa precisa ler antes de decidir.
            Rectangle {
                height: atualizacao.preferred-height;

                atualizacao := VerticalLayout {
                    width: parent.width;
                    spacing: Theme.space-sm;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        height: 34px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.update-title;
                                color: Theme.text;
                                font-size: Theme.size-md;
                                font-family: Theme.font-family;
                                overflow: elide;
                            }
                        }

                        // Um botao por vez, e o texto dele diz o que o proximo
                        // clique faz -- nao "Atualizar" em toda fase, que
                        // esconderia que baixar e instalar sao coisas
                        // diferentes (instalar fecha o aplicativo).
                        if root.update-phase == 3: PrimaryButton {
                            label: "Baixar";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.download-update(); }
                        }

                        if root.update-phase == 5: PrimaryButton {
                            label: "Instalar e reiniciar";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.install-update(); }
                        }

                        if root.update-phase != 3 && root.update-phase != 5: PrimaryButton {
                            label: root.update-phase == 1
                                ? "Procurando..."
                                : (root.update-phase == 4 ? "Baixando..." : "Procurar atualizações");
                            // Clicar de novo no meio da rede nao faz nada util,
                            // e o botao apagado e o que diz isso sem texto.
                            enabled: root.update-phase != 1 && root.update-phase != 4;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.check-update(); }
                        }
                    }

                    if root.update-detail != "": Text {
                        text: root.update-detail;
                        color: root.update-phase == 6 ? Theme.danger : Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                    }

                    if root.update-phase == 4: Rectangle {
                        height: 6px;
                        border-radius: Theme.radius-sm;
                        background: Theme.border;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.update-progress;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }

                    // Saida manual: enquanto nao houver assinatura de codigo, o
                    // SmartScreen pode barrar o instalador baixado aqui, e a
                    // pessoa precisa de um caminho que nao dependa deste botao.
                    if root.update-phase == 3 || root.update-phase == 6: HorizontalLayout {
                        alignment: start;
                        height: 32px;

                        GhostButton {
                            label: "Abrir a página de lançamentos";
                            clicked => { root.open-releases-page(); }
                        }
                    }
                }
            }

            SettingsGroupTitle { text: "Comportamento"; }

            SettingRow {
                label: "Continuar com rádio";
                hint: "Quando a fila acabar, toca uma estação baseada na última faixa.";
                checked: root.autoplay;
                toggled(v) => { root.set-autoplay(v); }
            }

            SettingRow {
                label: "Continuar tocando ao fechar";
                hint: "Fechar a janela esconde o Morune na bandeja em vez de encerrar.";
                checked: root.close-to-tray;
                toggled(v) => { root.set-close-to-tray(v); }
            }

            SettingRow {
                label: "Iniciar com o Windows";
                hint: "Abre em segundo plano na bandeja quando você entra no Windows.";
                checked: root.start-with-windows;
                toggled(v) => { root.set-start-with-windows(v); }
            }

            SettingsGroupTitle { text: "Áudio"; }

            Rectangle {
                height: 44px;
                HorizontalLayout {
                    spacing: Theme.space-sm;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Qualidade";
                            color: Theme.text;
                            font-size: Theme.size-md;
                            font-family: Theme.font-family;
                        }
                        Text {
                            // Diz quando vale porque nao vale agora: a
                            // configuracao do reprodutor e congelada quando ele
                            // nasce, e refazer o motor pararia a musica.
                            text: "Vale a partir da próxima vez que o Morune abrir.";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                        }
                    }

                    for option[index] in ["96 kbps", "160 kbps", "320 kbps"]: GhostButton {
                        label: option;
                        active: root.bitrate == index;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.set-bitrate(index); }
                    }
                }
            }

            SettingRow {
                label: "Nivelar o volume entre faixas";
                hint: "Deixa músicas gravadas em volumes diferentes no mesmo nível. Vale ao reabrir.";
                checked: root.normalize;
                toggled(v) => { root.set-normalize(v); }
            }

            Rectangle {
                height: 44px;
                HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: "Saída de áudio"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                        Text {
                            text: "Vale a partir da próxima vez que o Morune abrir.";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                        }
                    }
                    Text {
                        text: root.output-device == "" ? "Padrão do Windows" : root.output-device;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-alignment: right;
                        max-width: 220px;
                    }
                }
            }

            // Lista em vez de menu suspenso: sao poucos dispositivos, o Slint
            // aqui e construido so com primitivas (sem `std-widgets`), e uma
            // lista mostra a escolha atual sem exigir um clique para abrir.
            VerticalLayout {
                spacing: 2px;

                OutputDeviceRow {
                    label: "Padrão do Windows";
                    active: root.output-device == "";
                    chosen => { root.set-output-device(""); }
                }

                for device in root.output-devices: OutputDeviceRow {
                    label: device;
                    active: root.output-device == device;
                    chosen => { root.set-output-device(device); }
                }
            }

            SettingsGroupTitle { text: "Aparência"; }

            Text {
                text: "Estes ajustes são seus, não do tema: trocar de tema não desfaz nenhum deles.";
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
            }

            Rectangle {
                height: 44px;
                HorizontalLayout {
                    spacing: Theme.space-md;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Imagem de fundo";
                            color: Theme.text;
                            font-size: Theme.size-md;
                            font-family: Theme.font-family;
                        }
                        Text {
                            text: root.has-background
                                ? root.background-name
                                : "Nenhuma. O tema decide o fundo da janela.";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                            overflow: elide;
                        }
                    }

                    if root.has-background: GhostButton {
                        label: "Remover";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.clear-background(); }
                    }

                    GhostButton {
                        label: root.has-background ? "Trocar..." : "Escolher...";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.choose-background(); }
                    }
                }
            }

            // Os ajustes da imagem so aparecem quando ha imagem: quatro sliders
            // inertes seriam quatro perguntas sem resposta possivel.
            if root.has-background: Rectangle {
                height: 44px;
                HorizontalLayout {
                    spacing: Theme.space-sm;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Encaixe";
                            color: Theme.text;
                            font-size: Theme.size-md;
                            font-family: Theme.font-family;
                        }
                        Text {
                            text: "Como a imagem preenche a janela.";
                            color: Theme.text-muted;
                            font-size: Theme.size-xs;
                            font-family: Theme.font-family;
                        }
                    }

                    for option[index] in ["Cobrir", "Caber", "Centro", "Esticar"]: GhostButton {
                        label: option;
                        active: root.background-fit == index;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.set-background-fit(index); }
                    }
                }
            }

            if root.has-background: SettingSlider {
                label: "Opacidade da imagem";
                pesado: true;
                hint: "Quanto da imagem aparece sobre a cor de fundo do tema.";
                value: root.background-opacity;
                value-text: round(root.background-opacity * 100) + "%";
                changed(v) => { root.set-background-opacity(v); }
            }

            if root.has-background: SettingSlider {
                label: "Escurecer o fundo";
                pesado: true;
                hint: "Véu sobre a imagem. Sem ele, uma foto clara apaga o texto.";
                value: root.background-tint;
                value-text: round(root.background-tint * 100) + "%";
                changed(v) => { root.set-background-tint(v); }
            }

            if root.has-background: SettingSlider {
                label: "Desfoque";
                pesado: true;
                hint: "Aplicado uma vez ao carregar; não custa nada enquanto você joga.";
                value: root.background-blur;
                value-text: round(root.background-blur * 64) + "px";
                changed(v) => { root.set-background-blur(v); }
            }

            // So faz sentido onde ha vidro sobre o fundo: o material Aero.
            if Theme.material-kind == 1: SettingSlider {
                label: "Desfoque do vidro";
                pesado: true;
                hint: "Quanto os painéis borram o que está atrás. Zero mostra o fundo nítido.";
                value: root.glass-blur;
                value-text: round(root.glass-blur * 24) + "px";
                changed(v) => { root.set-glass-blur(v); }
            }

            SettingSlider {
                label: "Transparência da janela";
                hint: "Deixa ver o que está atrás. Vale para qualquer tema, e o tema não desfaz.";
                value: root.window-opacity;
                value-text: round(root.window-opacity * 80) + "%";
                changed(v) => { root.set-window-opacity(v); }
            }

            SettingSlider {
                label: "Tamanho da interface";
                hint: "Multiplica todos os textos. A escala do Windows continua valendo por cima.";
                value: root.font-scale;
                value-text: round(80 + root.font-scale * 80) + "%";
                changed(v) => { root.set-font-scale(v); }
            }

            SettingRow {
                label: "Reduzir animações";
                hint: "Desliga as transições, mesmo que o tema peça por elas.";
                checked: root.reduce-motion;
                toggled(v) => { root.set-reduce-motion(v); }
            }

            Text {
                text: "Temas";
                color: Theme.text;
                font-size: Theme.size-md;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
            }

            SettingRow {
                label: "Recarregar tema ao salvar";
                hint: "Observa a pasta de temas e aplica assim que você salva o arquivo.";
                checked: root.hot-reload;
                toggled(v) => { root.set-hot-reload(v); }
            }

            Text {
                text: "A troca é imediata. Você pode voltar ao tema padrão a qualquer momento.";
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
            }

            VerticalLayout {
                spacing: Theme.space-sm;
                height: 76px;
                alignment: start;

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    height: 34px;
                    alignment: start;

                    PrimaryButton {
                        label: "Importar tema";
                        clicked => { root.import-theme(); }
                    }

                    GhostButton {
                        label: "Abrir pasta de temas";
                        clicked => { root.open-theme-folder(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    height: 34px;
                    alignment: start;

                    GhostButton {
                        label: "Recarregar temas";
                        clicked => { root.reload-theme(); }
                    }

                    GhostButton {
                        label: "Usar tema padrão";
                        clicked => { root.reset-theme(); }
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.space-xs;
                padding-top: Theme.space-sm;
                alignment: start;

                for item in root.themes: ThemeRow {
                    item: item;
                    selected => { root.select-theme(item.id); }
                    export-pack => { root.export-theme(item.id); }
                    duplicate => { root.duplicate-theme(item.id); }
                }

                if root.diagnostics.length > 0: Text {
                    text: "Diagnósticos do tema";
                    color: Theme.text;
                    font-size: Theme.size-md;
                    font-weight: Theme.weight-bold;
                    font-family: Theme.font-family;
                }

                for d in root.diagnostics: Rectangle {
                    height: diag.preferred-height + Theme.space-sm * 2;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface;
                    border-width: Theme.border-width;
                    border-color: Theme.border;

                    diag := Text {
                        text: d.field + ": " + d.message;
                        color: d.level == "error" ? Theme.danger : Theme.warning;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                        x: Theme.space-md;
                        y: Theme.space-sm;
                        width: parent.width - Theme.space-md * 2;
                    }
                }
            }
        }
    }
}

// A caixa da barra lateral, sem o conteudo dela.
//
// Existe porque a barra aparece em dois ramos -- `sidebar-position` 0 e 1 -- e
// as cinco linhas da caixa estavam duplicadas nos dois. Duplicar valor de
// movimento e o tipo de coisa que diverge na primeira vez que alguem ajusta um
// lado e esquece o outro.
//
// A alternativa seria um componente que recebesse as vinte ligacoes do
// `Sidebar` como propriedades, o que so trocaria uma duplicacao por outra.
// `@children` deixa a caixa ser caixa e o conteudo continuar onde estava.
//
// Sobre o `animate width`: ele **fica**. Recolher a barra tem de refazer o
// layout da area de conteudo, porque e isso que o gesto significa; nao ha
// arranjo que evite o relayout sem quebrar a promessa. O custo e uma passada de
// layout por quadro, por doze quadros, num gesto raro. Ver `plans/002`.
component SidebarShell inherits Rectangle {
    width: Layout.sidebar-collapsed
        ? Layout.sidebar-collapsed-width
        : Layout.sidebar-width;
    background: Theme.material-kind == 1 ? transparent : Theme.sidebar-background;
    border-radius: Theme.material-kind > 0 ? Theme.radius-lg : 0px;
    clip: Theme.material-kind == 1;
    // A lente acompanha geometria; o colapso nao deve gerar uma imagem por frame.
    animate width { duration: Theme.material-kind == 2 ? 0ms : Theme.motion-normal; easing: ease-in-out; }

    if Theme.material-kind == 2: SceneGlass { }

    // **A barra lateral e a maior peca de vidro da tela.**
    //
    // Ela e uma coluna alta e sem capa por cima, entao e onde o efeito mais
    // aparece. E e a unica peca de vidro desta regiao: os itens dentro dela se
    // distinguem por cor de superficie, nunca por um segundo material -- vidro
    // sobre vidro esta na lista de anti-padroes das duas plataformas.
    //
    // O `Vidro` vem antes do `Glass`: primeiro o que se ve atraves, depois a luz
    // que cai sobre a superficie.
    if Theme.material-kind != 2: Vidro {
        forca: Theme.material-kind == 1 ? 1.0 : 0.7;
        radius: parent.border-radius;
        tinta: Theme.sidebar-background;
    }

    // Coluna de altura inteira: a base encosta na barra de reproducao, e a luz
    // de retorno viraria um risco entre as duas.
    if Theme.material-kind != 2: Glass {
        bottom: Theme.material-kind > 0;
        radius: parent.border-radius;
    }

    @children

    // **A linha que separa a barra lateral do conteudo.**
    //
    // Sem tom proprio, a barra e a home passaram a ter exatamente o mesmo escuro
    // -- medido na fronteira, +0,004 de diferenca. E o que se queria, mas com
    // isso a divisao entre as duas deixou de existir: viravam uma superficie so.
    //
    // Ela vai DEPOIS de `@children` para ficar por cima do conteudo da barra, e
    // do lado de dentro da borda -- assim nao depende de quem hospeda desenhar
    // nada, e some junto com a barra quando ela recolhe.
    //
    // `border-highlight` e a mesma cor das outras linhas de vidro da interface:
    // a divisao entre regioes e uma so, desenhada do mesmo jeito em todo lugar.
    Rectangle {
        x: parent.width - self.width;
        visible: Theme.material-kind == 0;
        width: Theme.border-width;
        height: 100%;
        background: Theme.border-highlight;
    }
}

// Uma linha do painel de atalhos: a combinacao numa pastilha de largura fixa,
// a acao ao lado. Coluna de verdade, e nao espacos no meio do texto -- com
// fonte proporcional os espacos nunca alinhavam.
component ShortcutRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    spacing: Theme.space-md;

    Rectangle {
        width: 176px;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                border-radius: Theme.radius-sm;
                background: Theme.hover;
                border-width: Theme.border-width;
                border-color: Theme.border-highlight;
                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: root.keys;
                        color: Theme.text;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                    }
                }
            }
        }
    }

    Text {
        text: root.action;
        color: Theme.text-muted;
        font-size: Theme.size-md;
        font-family: Theme.font-family;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Titulo de grupo do painel de atalhos, com mais ar em cima do que embaixo
// pelo mesmo motivo do `SettingsGroupTitle`.
component ShortcutGroup inherits VerticalLayout {
    in property <string> text;
    padding-top: Theme.space-sm;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.size-sm;
        font-weight: Theme.weight-bold;
        font-family: Theme.font-family;
    }
}

export component AppWindow inherits Window {
    // O relogio da aurora: uma volta (791 px) a cada 40 s, em passos de 100 ms.
    // Cada passo desenha a janela inteira de novo -- e o que a animacao custa
    // --, entao o passo e o mais largo que ainda passa por continuo: 2 px a
    // dez quadros por segundo. Medido em 13/09/2026: a 20 quadros a GPU ficava
    // em 16%; a dez, na metade. Para com a janela escondida (`aurora-viva`,
    // escrito pelo Rust), com animacao reduzida e com o portao de tela cheia
    // (`motion-normal` chega zerado nos dois casos).
    aurora-relogio := Timer {
        interval: 100ms;
        running: Theme.material-kind == 1 && Theme.aurora-viva && Theme.motion-normal > 0ms;
        triggered => {
            Theme.aurora-fase = Theme.aurora-fase + 0.1 / 40 >= 1.0
                ? Theme.aurora-fase + 0.1 / 40 - 1.0
                : Theme.aurora-fase + 0.1 / 40;
        }
    }
    in property <bool> native-backdrop-active: false;
    // --- estado vindo do Rust ---
    in property <int> page: 0;
    in property <string> status-message;
    in property <bool> undo-available: false;
    in property <bool> retry-available: false;
    in property <bool> logged-in: false;
    in property <string> account-name;
    in property <string> account-initial;
    in property <string> auth-url;
    in property <image> account-avatar;

    in property <[FeedShelf]> home-feed;
    // Musicas curtidas e as playlists da conta, na ordem da barra lateral.
    in property <[CardItem]> library-playlists;
    in property <[CardItem]> home-made-for-you;
    in property <[CardItem]> home-stations;
    in property <[CardItem]> home-retrospectives;
    in property <[CardItem]> home-playlists;
    in property <[TrackRow]> home-liked;
    in property <[TrackRow]> home-recent;
    in property <string> sleep-label;
    callback set-sleep(int);
    in property <[string]> recent-searches;
    callback clear-recent-searches();
    callback toggle-hidden(string);
    in property <bool> home-loaded: false;
    in property <[TrackRow]> search-tracks;
    in property <[CardItem]> search-items;
    in property <string> search-query;
    in property <bool> searching;
    in property <[CardItem]> library-items;
    in property <bool> library-loaded: false;
    in property <[TrackRow]> queue-manual-tracks;
    in property <[TrackRow]> queue-context-tracks;
    in property <[ThemeItem]> themes;
    in property <[Diagnostic]> diagnostics;

    in property <string> now-title;
    in property <string> now-id;
    in property <image> now-cover;
    // Ficha gerada da faixa tocando e do cabecalho de detalhe. Ver `Artwork`.
    in property <string> now-cover-initial;
    in property <float> now-cover-hue;
    in property <bool> now-cover-pending;
    in property <[CardItem]> sidebar-playlists;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-kind;
    in property <string> detail-save-label;
    callback toggle-detail-save();
    in property <image> detail-cover;
    in property <string> detail-cover-initial;
    in property <float> detail-cover-hue;
    in property <bool> detail-cover-pending;
    in property <[TrackRow]> detail-tracks;
    in property <[CardItem]> detail-items;
    in property <int> detail-sort;
    in property <bool> detail-descending;
    in property <bool> detail-filtered;
    in property <bool> detail-has-more;
    in property <bool> detail-loading;
    in property <int> detail-loaded-count;
    in property <string> now-artist;
    in property <bool> playing;
    in property <bool> has-track;
    in property <bool> now-favorite;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <float> volume: 0.7;
    in property <bool> shuffle;
    in property <int> repeat;

    in property <bool> dev-mode: false;
    in property <string> perf-text;
    in property <bool> close-to-tray: true;
    in property <bool> autoplay: true;
    in property <int> bitrate;
    in property <bool> normalize;
    in property <[string]> output-devices;
    in property <string> output-device;
    in property <bool> start-with-windows: false;
    in-out property <bool> shortcuts-visible: false;
    private property <int> busca-foco-pedido: 0;
    in-out property <bool> mini-player: false;
    // O tamanho da janela vai para a global do tema.
    //
    // Quem precisa e o `Vidro`: para achar o pedaco do fundo que cai atras de um
    // painel, ele refaz a conta que o `image-fit: cover` fez, e essa conta
    // depende do tamanho da area onde a imagem foi desenhada. Um componente la
    // no meio da arvore nao tem como perguntar isso a janela, entao a janela
    // conta. Por atribuicao, e nao por ligacao: global nao aceita ligacao vinda
    // de um componente.
    init => {
        Theme.window-width = root.width;
        Theme.window-height = root.height;
    }
    changed width => { Theme.window-width = root.width; }
    changed height => { Theme.window-height = root.height; }

    // --- eventos para o Rust ---
    callback navigate(int);
    callback search(string);
    callback play-track(string);
    in property <bool> has-background;
    in property <string> background-name;
    in property <int> background-fit;
    in property <float> background-opacity;
    in property <float> background-tint;
    in property <float> background-blur;
    in property <float> glass-blur;
    in property <float> font-scale;
    in property <float> window-opacity;
    in property <bool> reduce-motion;
    in property <bool> hot-reload;

    callback choose-background();
    callback clear-background();
    callback set-background-fit(int);
    callback set-background-opacity(float);
    callback set-background-tint(float);
    callback set-background-blur(float);
    callback set-glass-blur(float);
    callback set-font-scale(float);
    callback set-window-opacity(float);
    callback set-reduce-motion(bool);
    callback set-hot-reload(bool);

    // Atualizacao. A fase decide qual botao aparece, e vem pronta do Rust:
    // 0 parado, 1 verificando, 2 em dia, 3 disponivel, 4 baixando, 5 pronto
    // para instalar, 6 falhou. Ver `AppState::update_status`.
    in property <int> update-phase: 0;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress;

    callback check-update();
    callback download-update();
    callback install-update();
    callback open-releases-page();

    callback toggle-play();
    callback stop-playback();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback nudge-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite(string);
    callback queue-play-next(string);
    callback queue-enqueue(string);
    callback queue-remove(int);
    callback queue-play-manual(int);
    callback queue-move(int, int);
    callback queue-clear();
    callback select-theme(string);
    callback import-theme();
    callback export-theme(string);
    callback duplicate-theme(string);
    callback reset-theme();
    callback open-theme-folder();
    callback reload-theme();
    callback toggle-sidebar();
    callback filter-playlists(string);
    callback toggle-pin-playlist(string);
    callback detail-back();
    // Volta da Fila para a pagina de onde ela foi aberta.
    callback close-queue();
    callback detail-play();
    callback detail-filter(string);
    callback detail-sort-by(int);
    callback detail-activate(string);
    callback detail-load-more();
    callback set-close-to-tray(bool);
    callback set-autoplay(bool);
    callback set-bitrate(int);
    callback set-normalize(bool);
    callback set-output-device(string);
    callback set-start-with-windows(bool);
    callback login();
    callback cancel-login();
    callback copy-auth-url();
    callback logout();
    callback dismiss-status();
    callback undo-last();
    callback retry-last();
    callback dismiss-undo();
    callback move-window(float, float);
    callback toggle-mini-player();

    // Icone da janela e da barra de tarefas. O Slint embute o arquivo no
    // binario e o decodifica ao abrir; o desenho de 128 px e o maior tamanho
    // com hinting proprio, e o suficiente para o Windows escalar.
    //
    // Nao adianta montar este icone em codigo: o backend so reaplica o icone
    // quando a chave de cache da imagem muda, e imagens criadas em tempo de
    // execucao nao tem chave -- a janela ficaria sem icone nenhum.
    icon: @image-url("../../../assets/brand/morune-logo-system/morune-symbol-128.png");

    title: "Morune";
    no-frame: true;
    resize-border-width: root.maximized ? 0px : Theme.border-width * 6;
    background: root.native-backdrop-active && Theme.material-kind == 2
        ? Theme.background.with-alpha(0.12) : Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-md;
    min-width: root.mini-player ? 600px : 720px;
    min-height: root.mini-player ? 120px : 480px;
    preferred-width: 1180px;
    preferred-height: 760px;
    forward-focus: keys;

    // Fundo da janela, atras de tudo.
    //
    // Para ele aparecer, as cores de superficie do tema precisam ter alfa --
    // `sidebar_background = "#0d1016cc"` e assim por diante. Nao ha modo
    // "transparencia" separado: um tema opaco simplesmente cobre a imagem, que
    // e o comportamento certo para quem nao pediu fundo nenhum.
    if Theme.background-image.width > 0: Image {
        // Tamanho amarrado a raiz, e nao `100%`: como filha direta da janela
        // esta imagem nao participa de layout nenhum, entao `100%` nao tem a
        // que se referir e ela nasce com tamanho zero.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: Theme.background-image;
        opacity: Theme.background-opacity;
        image-fit: Theme.background-fit == 1
            ? ImageFit.contain
            : (Theme.background-fit == 2
                ? ImageFit.preserve
                : (Theme.background-fit == 3 ? ImageFit.fill : ImageFit.cover));
    }

    // Veu de legibilidade. Sem ele, uma foto clara apaga o texto de um tema
    // escuro -- e quem escolheu a foto nao tem como saber disso antes.
    if Theme.background-image.width > 0 && Theme.background-tint-strength > 0: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.background-tint;
        opacity: Theme.background-tint-strength;
    }

    VerticalLayout {
        AppTitleBar {
            maximized: root.maximized;
            move-window(dx, dy) => { root.move-window(dx, dy); }
            toggle-maximize => { root.maximized = !root.maximized; }
            minimize => { root.minimized = true; }
            close => { root.close(); }
        }

        if Layout.player-position == 1: PlayerBar {
            mini-player: root.mini-player;
            title: root.now-title;
            artist: root.now-artist;
            cover: root.now-cover;
            cover-initial: root.now-cover-initial;
            cover-hue: root.now-cover-hue;
            cover-pending: root.now-cover-pending;
            playing: root.playing;
            has-track: root.has-track;
            favorite: root.now-favorite;
            progress: root.progress;
            elapsed: root.elapsed;
            total: root.total;
            volume: root.volume;
            queue-open: root.page == 4;
            shuffle: root.shuffle;
            repeat: root.repeat;
            toggle-play => { root.toggle-play(); }
            stop => { root.stop-playback(); }
            next => { root.next-track(); }
            previous => { root.previous-track(); }
            seek(v) => { root.seek(v); }
            set-volume(v) => { root.set-volume(v); }
            toggle-mute => { root.toggle-mute(); }
            nudge-volume(d) => { root.nudge-volume(d); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-favorite => { root.toggle-favorite(root.now-id); }
            open-queue => { if (root.page == 4) { root.close-queue(); } else { root.navigate(4); } }
            toggle-mini-player => { root.toggle-mini-player(); }
            sleep-label: root.sleep-label;
            set-sleep(m) => { root.set-sleep(m); }
        }

        if !root.mini-player: HorizontalLayout {
            vertical-stretch: 1;
            padding: Theme.material-kind > 0 ? Theme.space-sm : 0px;
            // No Aero a barra de reproducao e uma peca solta com o mesmo ar em
            // volta; o ar de baixo fica com ela, para nao dobrar.
            padding-bottom: Theme.material-kind == 1 ? 0px : (Theme.material-kind > 0 ? Theme.space-sm : 0px);
            spacing: Theme.material-kind > 0 ? Theme.space-sm : 0px;

            if Layout.sidebar-position == 0: SidebarShell {
                Sidebar {
                    width: 100%;
                    height: 100%;
                    page: root.page;
                    logged-in: root.logged-in;
                    account-name: root.account-name;
                    account-initial: root.account-initial;
                    auth-url: root.auth-url;
                    account-avatar: root.account-avatar;
                    playlists: root.sidebar-playlists;
                    navigate(p) => { root.navigate(p); }
                    toggle-sidebar => { root.toggle-sidebar(); }
                    login => { root.login(); }
                    cancel-login => { root.cancel-login(); }
                    copy-auth-url => { root.copy-auth-url(); }
                    filter-playlists(q) => { root.filter-playlists(q); }
                    open-playlist(id) => { root.play-track(id); }
                    toggle-pin-playlist(id) => { root.toggle-pin-playlist(id); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.material-kind > 0 ? Theme.radius-lg : 0px;
                // Sem fundo proprio: a janela ja pinta `Theme.background` atras
                // de tudo, e a area de conteudo e o CAMPO -- o escuro contra o
                // qual as pecas claras existem.
                //
                // Houve aqui um veu branco de 12%, para a home clarear como as
                // barras. A ideia era manter uma direcao so, e estava errada de
                // partida: se tudo clareia, nao sobra escuro para nada se
                // destacar contra. Quem clareia e o que se pode tocar -- linha
                // sob o cursor, cartao, item escolhido do menu. O resto cobre.
                background: transparent;

                paginas := Rectangle {
                    // **Sem recuo embaixo, e o de baixo era o unico errado.**
                    //
                    // O recuo punha `space-lg` nos quatro lados. Nos tres
                    // primeiros isso e ar; no quarto e uma faixa morta entre a
                    // pagina e a barra de reproducao, larga o bastante para
                    // aparecer -- 24px no Aquario, 22 no Bruma. Como toda pagina
                    // aqui rola por dentro, o efeito era a lista terminar cortada
                    // e ainda sobrar campo vazio: nenhuma delas conseguia encostar
                    // na barra, por mais que se rolasse.
                    //
                    // O ar continua existindo, so que DENTRO do visor de rolagem:
                    // cada pagina ganhou `padding-bottom` no proprio conteudo
                    // rolado, entao o ultimo item ainda sobe livre da barra -- a
                    // diferenca e que agora ele PODE chegar ate ela.
                    //
                    // **As paginas de dados ficam vivas, escondidas por
                    // `visible`, e nao atras de `if`.** Com `if`, cada troca de
                    // pagina destruia a arvore inteira da pagina que saia e
                    // instanciava a que entrava -- prateleiras, grade de cartoes,
                    // fila -- e a posicao de rolagem morria junto. Elemento
                    // invisivel nao desenha, nao recebe mouse e nao tem as
                    // ligacoes reavaliadas ate voltar; o que custa e a memoria
                    // dos itens, e as listas grandes sao virtualizadas. Detalhe
                    // e Ajustes continuam em `if`: o Detalhe troca de conteudo
                    // inteiro a cada abertura e deve mesmo comecar do topo.
                    private property <length> recuo: Theme.space-lg;
                    private property <length> largura: self.width - self.recuo * 2;
                    private property <length> altura: self.height - self.recuo;
                    // **A transicao de pagina.** A que entra sobe 6 px e aparece
                    // em `motion-fast`; a que sai some na hora. E o minimo que
                    // diz "mudou de lugar" sem pedir que se espere: trocar de
                    // pagina e gesto de toda hora, e gesto de toda hora nao
                    // ganha coreografia -- nem deslizar lateral, que custa uma
                    // camada por quadro e parece aplicativo de celular. Sai dos
                    // tokens do tema, entao movimento reduzido e jogo em tela
                    // cheia zeram isto junto com o resto.
                    private property <length> subida: 6px;

                    HomePage {
                        visible: root.page == 0;
                        x: paginas.recuo;
                        y: paginas.recuo + (self.visible ? 0px : paginas.subida);
                        opacity: self.visible ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        feed: root.home-feed;
                        made-for-you: root.home-made-for-you;
                        stations: root.home-stations;
                        retrospectives: root.home-retrospectives;
                        playlists: root.home-playlists;
                        liked: root.home-liked;
                        recent: root.home-recent;
                        logged-in: root.logged-in;
                        loaded: root.home-loaded;
                        login => { root.login(); }
                        cancel-login => { root.cancel-login(); }
                        copy-auth-url => { root.copy-auth-url(); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    SearchPage {
                        visible: root.page == 1;
                        foco-pedido: root.busca-foco-pedido;
                        x: paginas.recuo;
                        y: paginas.recuo + (self.visible ? 0px : paginas.subida);
                        opacity: self.visible ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        tracks: root.search-tracks;
                        items: root.search-items;
                        query: root.search-query;
                        searching: root.searching;
                        logged-in: root.logged-in;
                        recent-searches: root.recent-searches;
                        clear-recent => { root.clear-recent-searches(); }
                        search(q) => { root.search(q); }
                        login => { root.login(); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    LibraryPage {
                        visible: root.page == 2;
                        x: paginas.recuo;
                        y: paginas.recuo + (self.visible ? 0px : paginas.subida);
                        opacity: self.visible ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        items: root.library-items;
                        playlists: root.library-playlists;
                        logged-in: root.logged-in;
                        loaded: root.library-loaded;
                        login => { root.login(); }
                        cancel-login => { root.cancel-login(); }
                        copy-auth-url => { root.copy-auth-url(); }
                        explore => { root.navigate(1); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    if root.page == 3: SettingsPage {
                        private property <bool> apareceu: false;
                        init => { self.apareceu = true; }
                        x: paginas.recuo;
                        y: paginas.recuo + (self.apareceu ? 0px : paginas.subida);
                        opacity: self.apareceu ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        themes: root.themes;
                        diagnostics: root.diagnostics;
                        dev-mode: root.dev-mode;
                        logged-in: root.logged-in;
                        account-name: root.account-name;
                        account-initial: root.account-initial;
                        auth-url: root.auth-url;
                        account-avatar: root.account-avatar;
                        close-to-tray: root.close-to-tray;
                        autoplay: root.autoplay;
                        bitrate: root.bitrate;
                        normalize: root.normalize;
                        output-devices: root.output-devices;
                        output-device: root.output-device;
                        start-with-windows: root.start-with-windows;
                        has-background: root.has-background;
                        background-name: root.background-name;
                        background-fit: root.background-fit;
                        background-opacity: root.background-opacity;
                        background-tint: root.background-tint;
                        background-blur: root.background-blur;
                        glass-blur: root.glass-blur;
                        font-scale: root.font-scale;
                        window-opacity: root.window-opacity;
                        reduce-motion: root.reduce-motion;
                        hot-reload: root.hot-reload;
                        update-phase: root.update-phase;
                        update-title: root.update-title;
                        update-detail: root.update-detail;
                        update-progress: root.update-progress;
                        check-update => { root.check-update(); }
                        download-update => { root.download-update(); }
                        install-update => { root.install-update(); }
                        open-releases-page => { root.open-releases-page(); }
                        choose-background => { root.choose-background(); }
                        clear-background => { root.clear-background(); }
                        set-background-fit(v) => { root.set-background-fit(v); }
                        set-background-opacity(v) => { root.set-background-opacity(v); }
                        set-background-tint(v) => { root.set-background-tint(v); }
                        set-background-blur(v) => { root.set-background-blur(v); }
                        set-glass-blur(v) => { root.set-glass-blur(v); }
                        set-font-scale(v) => { root.set-font-scale(v); }
                        set-window-opacity(v) => { root.set-window-opacity(v); }
                        set-reduce-motion(v) => { root.set-reduce-motion(v); }
                        set-hot-reload(v) => { root.set-hot-reload(v); }
                        set-close-to-tray(v) => { root.set-close-to-tray(v); }
                        set-autoplay(v) => { root.set-autoplay(v); }
                        set-bitrate(v) => { root.set-bitrate(v); }
                        set-normalize(v) => { root.set-normalize(v); }
                        set-output-device(v) => { root.set-output-device(v); }
                        set-start-with-windows(v) => { root.set-start-with-windows(v); }
                        select-theme(id) => { root.select-theme(id); }
                        import-theme => { root.import-theme(); }
                        export-theme(id) => { root.export-theme(id); }
                        duplicate-theme(id) => { root.duplicate-theme(id); }
                        reset-theme => { root.reset-theme(); }
                        open-theme-folder => { root.open-theme-folder(); }
                        reload-theme => { root.reload-theme(); }
                        login => { root.login(); }
                        cancel-login => { root.cancel-login(); }
                        copy-auth-url => { root.copy-auth-url(); }
                        logout => { root.logout(); }
                    }

                    if root.page == 5: DetailPage {
                        private property <bool> apareceu: false;
                        init => { self.apareceu = true; }
                        x: paginas.recuo;
                        y: paginas.recuo + (self.apareceu ? 0px : paginas.subida);
                        opacity: self.apareceu ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        title: root.detail-title;
                        subtitle: root.detail-subtitle;
                        kind: root.detail-kind;
                        save-label: root.detail-save-label;
                        toggle-save => { root.toggle-detail-save(); }
                        cover: root.detail-cover;
                        cover-initial: root.detail-cover-initial;
                        cover-hue: root.detail-cover-hue;
                        cover-pending: root.detail-cover-pending;
                        tracks: root.detail-tracks;
                        items: root.detail-items;
                        sort: root.detail-sort;
                        descending: root.detail-descending;
                        filtered: root.detail-filtered;
                        has-more: root.detail-has-more;
                        loading: root.detail-loading;
                        loaded-count: root.detail-loaded-count;
                        back => { root.detail-back(); }
                        play => { root.detail-play(); }
                        filter(q) => { root.detail-filter(q); }
                        sort-by(c) => { root.detail-sort-by(c); }
                        activated(id) => { root.detail-activate(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                        load-more => { root.detail-load-more(); }
                    }

                    QueuePage {
                        visible: root.page == 4;
                        has-track: root.has-track;
                        now-title: root.now-title;
                        now-artist: root.now-artist;
                        now-cover: root.now-cover;
                        now-cover-initial: root.now-cover-initial;
                        now-cover-hue: root.now-cover-hue;
                        now-cover-pending: root.now-cover-pending;
                        x: paginas.recuo;
                        y: paginas.recuo + (self.visible ? 0px : paginas.subida);
                        opacity: self.visible ? 1.0 : 0.0;
                        animate opacity, y { duration: Theme.motion-fast; easing: ease-out; }
                        width: paginas.largura; height: paginas.altura;
                        manual-tracks: root.queue-manual-tracks;
                        context-tracks: root.queue-context-tracks;
                        explore => { root.navigate(1); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        activate-manual(i) => { root.queue-play-manual(i); }
                        remove-queued(i) => { root.queue-remove(i); }
                        move-queued(from, to) => { root.queue-move(from, to); }
                        clear => { root.queue-clear(); }
                        hide(id) => { root.toggle-hidden(id); }
                    }
                }

                if root.status-message != "": Rectangle {
                    // Entrada da mensagem.
                    //
                    // Mensagem que pisca na periferia da tela e o caso classico
                    // do que a pessoa nao le porque nao percebeu chegar. Oito
                    // pixels vindo de baixo dizem "isto acabou de chegar" sem
                    // roubar o olho de onde ele estava.
                    //
                    // **So a entrada.** A caixa some por `if`, e elemento
                    // removido da arvore nao anima a saida. Mante-la viva com
                    // opacidade zero daria a saida, mas deixaria um retangulo
                    // invisivel de 420px interceptando clique no canto da tela
                    // -- caro demais pelo que se ganha.
                    private property <bool> entrou: false;
                    init => { self.entrou = true; }
                    opacity: self.entrou ? 1.0 : 0.0;
                    animate opacity { duration: Theme.motion-normal; easing: ease-out; }

                    x: parent.width - self.width - Theme.space-lg;
                    y: parent.height - self.height - Theme.space-lg
                        + (self.entrou ? 0px : 8px);
                    animate y { duration: Theme.motion-normal; easing: ease-out; }
                    width: min(420px, parent.width - Theme.space-lg * 2);
                    height: max(40px, status-text.preferred-height + Theme.space-md * 2);
                    border-radius: Theme.radius-md;
                    background: Theme.surface-raised;
                    border-width: Theme.border-width;
                    border-color: Theme.border;
                    clip: true;

                    Glass { radius: Theme.radius-md; }

                    status-text := Text {
                        text: root.status-message;
                        color: Theme.text;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                        width: parent.width - Theme.space-md * 2 - 32px - ((root.undo-available || root.retry-available) ? 128px : 0px);
                        x: Theme.space-md;
                        y: Theme.space-md;
                    }

                    if root.undo-available: GhostButton {
                        label: "Desfazer";
                        width: 80px;
                        x: parent.width - self.width - 40px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.undo-last(); }
                    }

                    if !root.undo-available && root.retry-available: GhostButton {
                        label: "Tentar novamente";
                        width: 120px;
                        x: parent.width - self.width - 40px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.retry-last(); }
                    }

                    IconButton {
                        label: "Dispensar mensagem";
                        glyph: Icons.close;
                        tint: Theme.text-muted;
                        button-size: 28px;
                        x: parent.width - self.width - Theme.space-sm;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            if root.undo-available || root.retry-available { root.dismiss-undo(); }
                            else { root.dismiss-status(); }
                        }
                    }
                }

                if root.dev-mode: Rectangle {
                    x: Theme.space-md;
                    y: Theme.space-md;
                    width: perf.preferred-width + Theme.space-md * 2;
                    height: perf.preferred-height + Theme.space-sm * 2;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface-raised;
                    opacity: 0.92;

                    Glass { radius: Theme.radius-sm; }

                    perf := Text {
                        text: root.perf-text;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        x: Theme.space-md;
                        y: Theme.space-sm;
                    }
                }
            }

            if Layout.sidebar-position == 1: SidebarShell {
                Sidebar {
                    width: 100%;
                    height: 100%;
                    page: root.page;
                    logged-in: root.logged-in;
                    account-name: root.account-name;
                    account-initial: root.account-initial;
                    auth-url: root.auth-url;
                    account-avatar: root.account-avatar;
                    playlists: root.sidebar-playlists;
                    navigate(p) => { root.navigate(p); }
                    toggle-sidebar => { root.toggle-sidebar(); }
                    login => { root.login(); }
                    cancel-login => { root.cancel-login(); }
                    copy-auth-url => { root.copy-auth-url(); }
                    filter-playlists(q) => { root.filter-playlists(q); }
                    open-playlist(id) => { root.play-track(id); }
                    toggle-pin-playlist(id) => { root.toggle-pin-playlist(id); }
                }
            }
        }

        // No Aero os paineis sao pecas soltas sobre a foto limpa, e a barra de
        // reproducao tambem: o ar em volta dela e o que deixa a foto aparecer
        // entre as pecas, como no mockup aprovado.
        if Layout.player-position != 1: Rectangle {
            height: player-de-baixo.height + (Theme.material-kind == 1 ? Theme.space-sm : 0px);
            player-de-baixo := PlayerBar {
                x: Theme.material-kind == 1 ? Theme.space-sm : 0px;
                y: 0;
                width: parent.width - self.x * 2;
                mini-player: root.mini-player;
                title: root.now-title;
                artist: root.now-artist;
                cover: root.now-cover;
                cover-initial: root.now-cover-initial;
                cover-hue: root.now-cover-hue;
                cover-pending: root.now-cover-pending;
                playing: root.playing;
                has-track: root.has-track;
                favorite: root.now-favorite;
                progress: root.progress;
                elapsed: root.elapsed;
                total: root.total;
                volume: root.volume;
                shuffle: root.shuffle;
                repeat: root.repeat;
                toggle-play => { root.toggle-play(); }
                stop => { root.stop-playback(); }
                next => { root.next-track(); }
                previous => { root.previous-track(); }
                seek(v) => { root.seek(v); }
                set-volume(v) => { root.set-volume(v); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-favorite => { root.toggle-favorite(root.now-id); }
                open-queue => { root.navigate(4); }
                toggle-mini-player => { root.toggle-mini-player(); }
                sleep-label: root.sleep-label;
                set-sleep(m) => { root.set-sleep(m); }
            }
        }
    }

    if root.shortcuts-visible: Rectangle {
        z: 100;
        background: #00000099;

        TouchArea { clicked => { root.shortcuts-visible = false; } }

        Rectangle {
            width: min(520px, parent.width - Theme.space-xl * 2);
            // Altura do conteudo, e nao 360 fixos: com a secao de atalhos
            // globais a lista passou do quadro. Teto na janela, para nao vazar.
            height: min(atalhos-conteudo.preferred-height, parent.height - Theme.space-xl * 2);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-lg;
            background: Theme.surface-raised;
            border-width: Theme.border-width;
            border-color: Theme.border;

            Glass { radius: Theme.radius-lg; }

            atalhos-conteudo := VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;

                HorizontalLayout {
                    Text {
                        text: "Atalhos de teclado";
                        color: Theme.text;
                        font-size: Theme.size-xl;
                        font-weight: Theme.weight-bold;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                    }
                    IconButton {
                        label: "Fechar atalhos";
                        glyph: Icons.close;
                        clicked => { root.shortcuts-visible = false; }
                    }
                }

                ShortcutGroup { text: "Na janela"; }
                ShortcutRow { keys: "Ctrl + K"; action: "Buscar"; }
                ShortcutRow { keys: "Ctrl + ,"; action: "Configurações"; }
                ShortcutRow { keys: "Espaço"; action: "Tocar ou pausar"; }
                ShortcutRow { keys: "Ctrl + → / ←"; action: "Próxima / anterior"; }
                ShortcutRow { keys: "Ctrl + ↑ / ↓"; action: "Volume"; }
                ShortcutRow { keys: "Ctrl + M"; action: "Silenciar"; }
                ShortcutRow { keys: "Ctrl + L"; action: "Curtir a faixa"; }
                ShortcutRow { keys: "Alt + ←"; action: "Voltar"; }

                // Espelha `ATALHOS` em `hotkeys.rs`.
                ShortcutGroup { text: "Em qualquer lugar, até dentro do jogo"; }
                ShortcutRow { keys: "Ctrl + Alt + Espaço"; action: "Tocar ou pausar (ou Ctrl + Alt + Z)"; }
                ShortcutRow { keys: "Ctrl + Alt + → / ←"; action: "Próxima / anterior"; }
                ShortcutRow { keys: "Ctrl + Alt + ↑ / ↓"; action: "Volume"; }
                ShortcutRow { keys: "Ctrl + Alt + L"; action: "Curtir a faixa"; }
            }
        }
    }

    // Atalhos globais. As teclas de midia sao tratadas no Rust, porque precisam
    // funcionar com a janela sem foco.
    keys := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == "/" && event.modifiers.control) {
                root.shortcuts-visible = !root.shortcuts-visible;
                return EventResult.accept;
            }
            if (root.shortcuts-visible && event.text == Key.Escape) {
                root.shortcuts-visible = false;
                return EventResult.accept;
            }
            if (event.text == Key.K && event.modifiers.control) {
                root.navigate(1);
                root.busca-foco-pedido += 1;
                return EventResult.accept;
            }
            if (event.text == Key.Comma && event.modifiers.control) {
                root.navigate(3);
                return EventResult.accept;
            }
            if (root.page == 5 && (event.text == Key.Escape
                    || (event.text == Key.LeftArrow && event.modifiers.alt))) {
                root.detail-back();
                return EventResult.accept;
            }
            if (root.page == 4 && (event.text == Key.Escape
                    || (event.text == Key.LeftArrow && event.modifiers.alt))) {
                root.close-queue();
                return EventResult.accept;
            }
            if (event.text == Key.UpArrow && event.modifiers.control) {
                root.nudge-volume(0.05);
                return EventResult.accept;
            }
            if (event.text == Key.DownArrow && event.modifiers.control) {
                root.nudge-volume(-0.05);
                return EventResult.accept;
            }
            if (event.text == Key.M && event.modifiers.control) {
                root.toggle-mute();
                return EventResult.accept;
            }
            if (event.text == Key.L && event.modifiers.control && root.has-track) {
                root.toggle-favorite(root.now-id);
                return EventResult.accept;
            }
            if (event.text == " ") {
                root.toggle-play();
                return EventResult.accept;
            }
            if (event.text == Key.RightArrow && event.modifiers.control) {
                root.next-track();
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow && event.modifiers.control) {
                root.previous-track();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

// --- menu da bandeja ---

// Menu da bandeja, no lugar do menu nativo do Windows.
//
// Existe so enquanto esta aberto: o Rust cria a janela ao clique com o botao
// direito e a descarta ao fechar. Manter viva custaria um segundo contexto
// OpenGL em repouso, e o orcamento do aplicativo e justamente nao pesar na
// maquina de quem esta fazendo outra coisa.
export component TrayMenuWindow inherits Window {
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-cover;
    in property <string> now-cover-initial;
    in property <float> now-cover-hue;
    in property <bool> playing: false;
    in property <bool> has-track: false;
    in property <float> volume: 0.7;

    callback show-window();
    callback toggle-play();
    callback next();
    callback previous();
    callback set-volume(float);
    callback quit();
    callback dismiss();

    no-frame: true;
    always-on-top: true;
    // A janela e do tamanho do cartao: sem moldura, o Windows nao acrescenta
    // nada em volta, e a sombra fica por conta do proprio Windows.
    width: 272px;
    height: root.has-track ? 240px : 184px;
    // **Opaca, e nao transparente.** `transparent` aqui parecia certo -- deixar
    // o cartao arredondado desenhar sozinho --, mas esta janela nao tem canal
    // alfa por pixel: o Windows compoe o que nao foi pintado como **preto**, e
    // o resultado eram quatro cantos pretos em volta do cartao.
    //
    // Transparencia de verdade exigiria `UpdateLayeredWindow` ou uma regiao
    // recortada, e as duas trocam o canto suavizado do compositor por um canto
    // serrilhado. O caminho barato e melhor: a janela pinta o mesmo piso que o
    // cartao ja usa, e quem arredonda a silhueta e o proprio Windows, pelo
    // `DWMWCP_ROUND` que `ensure_rounded_corners` aplica.
    background: Theme.background.with-alpha(1.0);
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-md;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    Rectangle {
        // **Sem raio proprio.** Quem arredonda esta janela e o compositor do
        // Windows, pelo `DWMWCP_ROUND` que `ensure_rounded_corners` aplica.
        //
        // Duas tentativas antes desta erraram pelo mesmo motivo. `radius-lg`
        // deixou o cartao mais curvo que a janela, e o que sobrava fora dele
        // aparecia -- como a janela era transparente e nao ha alfa por pixel
        // aqui, "o que sobrava" era **preto**. Baixar para `radius-md` e pintar
        // a janela tirou o preto, mas as duas curvas ainda nao coincidem
        // exatamente, e restava uma meia-lua do piso em cada canto.
        //
        // Com o cartao quadrado, a cor vai ate onde o compositor corta, e a
        // unica curva e a dele. A borda some nos cantos, cortada junto -- e a
        // troca certa: uma linha que morre na curva incomoda menos que quatro
        // meias-luas escuras.
        border-radius: 0;
        border-width: Theme.border-width;
        border-color: Theme.border;
        // Piso opaco, e nao o `surface-raised` direto.
        //
        // Os temas de vidro descrevem as superficies com alfa baixo -- na
        // Bruma, `surface-raised` e branco a 18% -- contando com o fundo da
        // janela por tras. A janela principal tem esse piso; o menu da
        // bandeja nao tinha nenhum, e o cartao saia branco: texto claro sobre
        // branco, ilegivel. Aqui o piso e o proprio fundo do tema, sem alfa,
        // e a superficie de vidro vem por cima dele como em qualquer painel.
        background: Theme.background.with-alpha(1.0);

        // Acompanha o cartao: qualquer raio aqui reintroduz a meia-lua.
        Rectangle {
            border-radius: 0;
            background: Theme.surface-raised;
        }

        // No Aero o cartao e o mesmo vidro azul da janela: a cor, a aurora e a
        // moldura dupla. O borrao de verdade quem faz e o acrilico do Windows,
        // que este menu ja pede.
        if Theme.material-kind == 1: Rectangle {
            border-radius: 0;
            background: Theme.sidebar-background;
        }
        if Theme.material-kind == 1: Aurora { forca: 0.8; }
        if Theme.material-kind == 1: MolduraAero { }
        aurora-relogio := Timer {
            interval: 100ms;
            running: Theme.material-kind == 1 && Theme.motion-normal > 0ms;
            triggered => {
                Theme.aurora-fase = Theme.aurora-fase + 0.1 / 40 >= 1.0
                    ? Theme.aurora-fase + 0.1 / 40 - 1.0
                    : Theme.aurora-fase + 0.1 / 40;
            }
        }

        // Vidro aqui e a aresta, sem o brilho.
        //
        // O `Gloss` desenha a luz caindo na quina de cima e morre em 62% da
        // altura de quem hospeda. Num painel da janela isso e uma faixa
        // estreita bem acima do texto; num cartao de 240 px o degrade cobre o
        // titulo, e branco sobre branco e exatamente o defeito que este menu
        // tinha. Confinar o brilho a uma faixa nao resolve: a faixa cai em
        // cima da primeira linha, que e onde o nome da faixa vive.
        if Theme.material-kind != 1: GlassEdge { radius: 0; }

        VerticalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-xs;

            if root.has-track: HorizontalLayout {
                padding: Theme.space-xs;
                spacing: Theme.space-sm;

                Artwork {
                    width: 44px;
                    height: 44px;
                    source: root.now-cover;
                    initial: root.now-cover-initial;
                    hue: root.now-cover-hue;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.now-title;
                        color: Theme.text;
                        font-size: Theme.size-md;
                        font-weight: Theme.weight-medium;
                        overflow: elide;
                    }

                    Text {
                        text: root.now-artist;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        overflow: elide;
                    }
                }
            }

            // Sem faixa nao ha o que controlar, e uma linha de botoes apagados
            // so ocuparia espaco dizendo que nada funciona.
            if root.has-track: HorizontalLayout {
                alignment: center;
                spacing: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                IconButton {
                    label: "Faixa anterior";
                    glyph: Icons.previous;
                    filled: true;
                    clicked => { root.previous(); }
                }

                Rectangle {
                    width: Theme.control-primary-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.material-kind == 1
                        ? @linear-gradient(180deg, #f3fbff 0%, #dff1fb 48%, #a9d6f0 52%, #5fa9d8 100%)
                        : Theme.accent;
                    border-width: Theme.material-kind == 1 ? 1px : 0px;
                    border-color: Theme.accent.darker(0.45);
                    drop-shadow-color: Theme.material-kind == 1 ? Theme.selected.with-alpha(0.6) : transparent;
                    drop-shadow-blur: 9px;
                    clip: true;

                    if Theme.material-kind == 1: Rectangle {
                        width: parent.width * 1.3;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.55;
                        border-radius: self.width / 2;
                        background: @radial-gradient(circle, #35e2f0 0%, #35e2f0b0 22%, #35e2f000 58%);
                    }
                    if Theme.material-kind == 1: Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: self.width / 2;
                        border-width: 1px;
                        border-color: #ffffffe0;
                    }

                    MaterialRedondo { }

                    IconSwap {
                        off: Icons.play;
                        on: Icons.pause;
                        state: root.playing;
                        tint: Theme.material-kind == 1 ? Theme.text : Theme.text-on-accent;
                        filled: true;
                        size: Theme.control-icon-size-primary;
                        transform-scale: bandeja-play.pressed ? 0.84 : 1.0;
                        animate transform-scale {
                            duration: Theme.motion-normal;
                            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
                        }
                    }

                    bandeja-play := PressableArea {
                        accessible-label: root.playing ? "Pausar" : "Reproduzir";
                        focus-radius: Theme.control-primary-size / 2;
                        clicked => { root.toggle-play(); }
                    }
                }

                IconButton {
                    label: "Próxima faixa";
                    glyph: Icons.next;
                    filled: true;
                    clicked => { root.next(); }
                }
            }

            if !root.has-track: Text {
                text: "Nada tocando";
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 44px;
            }

            // O volume vale com ou sem faixa: e a razao mais comum de abrir a
            // bandeja com o jogo em primeiro plano, e mexer nele nao depende de
            // haver algo tocando agora.
            HorizontalLayout {
                padding-left: Theme.space-xs;
                padding-right: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                spacing: Theme.space-sm;

                Icon {
                    glyph: Icons.volume;
                    tint: Theme.text-muted;
                    size: Theme.control-icon-size;
                    y: (parent.height - self.size) / 2;
                }

                volume-slider := Slider {
                    label: "Volume";
                    value: root.volume;
                    y: (parent.height - self.height) / 2;
                    changed(v) => { root.set-volume(v); }
                    committed(v) => { root.set-volume(v); }
                }
            }

            Rectangle {
                height: Theme.border-width;
                background: Theme.border;
            }

            MenuRow {
                text: "Abrir Morune";
                glyph: Icons.home;
                clicked => { root.show-window(); }
            }

            MenuRow {
                text: "Sair do Morune";
                glyph: Icons.close;
                tint: Theme.danger;
                clicked => { root.quit(); }
            }
        }
    }
}

// Reexportados para que o Rust consiga aplicar o tema em tempo de execucao.
export { Theme, Layout }

