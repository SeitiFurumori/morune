import { Theme, Layout } from "theme.slint";
import { Icon, IconButton, PrimaryButton, GhostButton, SearchField, Slider, Artwork, PressableArea, Toggle, Logo } from "components.slint";
import { ListView } from "std-widgets.slint";

// O Slint exige que um componente esteja declarado antes de ser usado, entao
// este arquivo vai do menor para o maior: dados, icones, pecas, paginas e por
// ultimo a janela.

// Dados que o Rust envia para a interface. Structs achatadas de proposito: a
// interface nunca navega o modelo de dominio, so exibe o que ja veio pronto.
export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    cover: image,
    duration: string,
    playable: bool,
    playing: bool,
    favorite: bool,
}

export struct CardItem {
    id: string,
    title: string,
    subtitle: string,
    // Capa ja em disco. Vazia enquanto o cache nao a entrega.
    cover: image,
}

export struct ThemeItem {
    id: string,
    name: string,
    author: string,
    builtin: bool,
    active: bool,
}

export struct Diagnostic {
    level: string,
    field: string,
    message: string,
}

