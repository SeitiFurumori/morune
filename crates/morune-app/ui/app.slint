}

component SectionTitle inherits Text {
    font-size: Theme.size-lg;
    font-weight: Theme.weight-bold;
    font-family: Theme.font-family;
    color: Theme.text;
}

component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <string> action-label;
    callback action();

    alignment: center;
    spacing: Theme.space-sm;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.size-lg;
        font-family: Theme.font-family;
        horizontal-alignment: center;
    }

    Text {
        text: root.hint;
        color: Theme.text-muted;
        font-size: Theme.size-md;
        font-family: Theme.font-family;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.action-label != "": PrimaryButton {
        label: root.action-label;
        clicked => { root.action(); }
    }
}

// Controle da janela com a mesma semantica dos botoes nativos do Windows, mas
// integrado ao tema do Morune. O alvo ocupa toda a altura da title bar: alem de
// ser mais facil de acertar, permite levar o ponteiro ate a borda superior sem
// perder o botao (Lei de Fitts).
component WindowControl inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <bool> danger: false;
    callback clicked();

    width: Theme.space-xl + Theme.space-md;
    height: Theme.space-xl + Theme.space-xs;
    background: root.danger && touch.has-hover
        ? Theme.danger
        : (touch.pressed ? Theme.selected : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: Theme.motion-fast; }

    Path {
        width: Theme.size-md;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: transparent;
        stroke: root.danger && touch.has-hover ? Theme.text-on-accent : Theme.text-muted;
        stroke-width: 1.5px;
        stroke-line-cap: square;
        stroke-line-join: miter;
    }

    focus := FocusScope {
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.clicked(); }

        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    if focus.has-focus: Rectangle {
        border-width: Theme.border-width * 2;
        border-color: Theme.focus-ring;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { focus.focus(); }
        }
        clicked => { root.clicked(); }
    }
}

component AppTitleBar inherits Rectangle {
    in property <bool> maximized;
    callback move-window(float, float);
    callback toggle-maximize();
    callback minimize();
    callback close();

    private property <length> drag-origin-x;
    private property <length> drag-origin-y;
    private property <bool> restoring-from-maximized: false;

    height: Theme.space-xl + Theme.space-xs;
    background: Theme.sidebar-background;

    // A area de arraste termina antes dos controles. Assim um clique nos
    // botoes nunca pode ser interpretado como movimento da janela.
    drag := TouchArea {
        width: parent.width - (Theme.space-xl + Theme.space-md) * 3;
        height: parent.height;
        mouse-cursor: MouseCursor.default;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.drag-origin-x = self.mouse-x;
                root.drag-origin-y = self.mouse-y;
                root.restoring-from-maximized = false;
            }
        }

        moved => {
            if (self.pressed) {
                if (root.maximized) {
                    root.toggle-maximize();
                    root.restoring-from-maximized = true;
                } else if (root.restoring-from-maximized) {
                    // Depois que o Windows devolve o tamanho restaurado, cria
                    // uma nova ancora para o arraste nao saltar entre monitores.
                    root.drag-origin-x = self.mouse-x;
                    root.drag-origin-y = self.mouse-y;
                    root.restoring-from-maximized = false;
                } else {
                    root.move-window(
                        (self.mouse-x - root.drag-origin-x) / 1px,
                        (self.mouse-y - root.drag-origin-y) / 1px
                    );
                }
            }
        }

        double-clicked => { root.toggle-maximize(); }
    }

    HorizontalLayout {
        // A marca ja ancora a sidebar, inclusive quando ela esta recolhida.
        // Repeti-la aqui criava dois cabecalhos para o mesmo aplicativo. A
        // title bar fica deliberadamente silenciosa: arraste a esquerda,
        // controles de janela previsiveis a direita.
        Rectangle { horizontal-stretch: 1; }

        WindowControl {
            label: "Minimizar janela";
            path: Icons.minimize-window;
            clicked => { root.minimize(); }
        }

        WindowControl {
            label: root.maximized ? "Restaurar janela" : "Maximizar janela";
            path: root.maximized ? Icons.restore-window : Icons.maximize-window;
            clicked => { root.toggle-maximize(); }
        }

        WindowControl {
            label: "Fechar janela";
            path: Icons.close;
            danger: true;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        y: parent.height - Theme.border-width;
        height: Theme.border-width;
        background: Theme.border;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;
        alignment: Layout.sidebar-labels-shown ? LayoutAlignment.start : LayoutAlignment.center;

        if Layout.sidebar-icons-shown: Icon {
            path: root.icon;
            tint: root.active ? Theme.text : Theme.text-muted;
            size: 18px;
            y: (parent.height - self.size) / 2;
        }

        if Layout.sidebar-labels-shown: Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.size-md;
            font-weight: root.active ? Theme.weight-medium : Theme.weight-normal;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
    }

    touch := PressableArea {
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        clicked => { root.clicked(); }
    }
}

component TrackListRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    callback activated();
    callback favorite-toggled();
    in property <bool> queue-actions: true;
    in property <bool> queue-management: false;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    callback play-next();
    callback enqueue();
    callback remove-queued();
    callback move-up();
    callback move-down();
    private property <length> actions-width: 32px
        + (root.queue-actions ? 64px + Theme.space-md * 2 : 0px)
        + (root.queue-management ? 96px + Theme.space-md * 3 : 0px);

    height: Layout.row-height;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;

        Text {
            text: root.index + 1;
            color: root.track.playing ? Theme.accent : Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 26px;
        }

        Artwork {
            source: root.track.cover;
            seed: root.track.title;
            width: Layout.row-height - Theme.space-sm;
            height: self.width;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.track.title;
                color: root.track.playable
                    ? (root.track.playing ? Theme.accent : Theme.text)
                    : Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                overflow: elide;
            }

            if Layout.view-mode != 2: Text {
                text: root.track.artist;
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                overflow: elide;
            }
        }

        Rectangle { width: root.actions-width; }

        Text {
            text: root.track.duration;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 48px;
        }
    }

    touch := PressableArea {
        accessible-label: "Tocar " + root.track.title + " de " + root.track.artist;
        clicked => { root.activated(); }
        double-clicked => { root.activated(); }
    }

    // Declarado depois da area da linha para receber o clique primeiro.
    favorite-button := IconButton {
        x: root.width - Theme.space-md - 48px - Theme.space-md - self.width;
        y: (root.height - self.height) / 2;
        label: root.track.favorite
            ? "Remover " + root.track.title + " das Musicas curtidas do Spotify"
            : "Adicionar " + root.track.title + " as Musicas curtidas do Spotify";
        path: Icons.heart;
        filled: root.track.favorite;
        active: root.track.favorite;
        checkable: true;
        tint: Theme.text-muted;
        clicked => { root.favorite-toggled(); }
    }

    if root.queue-actions: IconButton {
        x: favorite-button.x - Theme.space-md - self.width;
        y: favorite-button.y;
        label: "Adicionar " + root.track.title + " ao fim da fila";
        path: Icons.queue-add;
        tint: Theme.text-muted;
        clicked => { root.enqueue(); }
    }

    if root.queue-actions: IconButton {
        x: favorite-button.x - Theme.space-md * 2 - self.width * 2;
        y: favorite-button.y;
        label: "Tocar " + root.track.title + " a seguir";
        path: Icons.queue-next;
        tint: Theme.text-muted;
        clicked => { root.play-next(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md - self.width;
        y: favorite-button.y;
        label: "Remover " + root.track.title + " da fila";
        path: Icons.close;
        tint: Theme.text-muted;
        clicked => { root.remove-queued(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md * 2 - self.width * 2;
        y: favorite-button.y;
        label: "Mover " + root.track.title + " para baixo";
        path: Icons.chevron-down;
        enabled: root.can-move-down;
        tint: Theme.text-muted;
        clicked => { root.move-down(); }
    }

    if root.queue-management: IconButton {
        x: favorite-button.x - Theme.space-md * 3 - self.width * 3;
        y: favorite-button.y;
        label: "Mover " + root.track.title + " para cima";
        path: Icons.chevron-up;
        enabled: root.can-move-up;
        tint: Theme.text-muted;
        clicked => { root.move-up(); }
    }
}

component Card inherits Rectangle {
    in property <CardItem> item;
    callback activated();

    width: Layout.card-width;
    height: Layout.card-width + 56px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.surface-raised : Theme.surface;
    animate background { duration: Theme.motion-fast; }

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-sm;

        Artwork {
            seed: root.item.title;
            source: root.item.cover;
            width: parent.width - Theme.space-sm * 2;
            height: self.width;
        }

        Text {
            text: root.item.title;
            color: Theme.text;
            font-size: Theme.size-md;
            font-weight: Theme.weight-medium;
            font-family: Theme.font-family;
            overflow: elide;
        }

        Text {
            text: root.item.subtitle;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: "Abrir " + root.item.title;
        clicked => { root.activated(); }
    }
}

component CardCollection inherits Rectangle {
    in property <[CardItem]> items;
    in property <int> columns: 5;
    callback activated(string);
    height: collection.preferred-height;

    collection := VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;
        for row-index in ceil(root.items.length / root.columns): HorizontalLayout {
            spacing: Theme.space-md;
            alignment: start;
            for column in root.columns: Rectangle {
                width: Layout.card-width;
                height: Layout.card-width + 56px;
                if row-index * root.columns + column < root.items.length: Card {
                    item: root.items[row-index * root.columns + column];
                    activated => { root.activated(root.items[row-index * root.columns + column].id); }
                }
            }
        }
    }
}

component TrackList inherits ListView {
    in property <[TrackRow]> tracks;
    in property <bool> has-more: false;
    in property <bool> loading: false;
    callback activated(string);
    callback favorite-toggled(string);
    in property <bool> queue-actions: true;
    in property <bool> queue-management: false;
    callback play-next(string);
    callback enqueue(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback nearing-end();

    scrolled => {
        if root.has-more && !root.loading
            && -root.viewport-y + root.visible-height
                >= root.viewport-height - Layout.row-height * 8 {
            root.nearing-end();
        }
    }

    for track[i] in root.tracks: Rectangle {
        height: Layout.row-height + 2px;

        TrackListRow {
            width: parent.width;
            height: Layout.row-height;
            track: track;
            index: i;
            queue-actions: root.queue-actions;
            queue-management: root.queue-management;
            can-move-up: i > 0;
            can-move-down: i + 1 < root.tracks.length;
            activated => { root.activated(track.id); }
            favorite-toggled => { root.favorite-toggled(track.id); }
            play-next => { root.play-next(track.id); }
            enqueue => { root.enqueue(track.id); }
            remove-queued => { root.remove-queued(i); }
            move-up => { root.move-queued(i, i - 1); }
            move-down => { root.move-queued(i, i + 1); }
        }
    }
}

// Uma playlist na barra lateral.
//
// Capa pequena e uma linha de texto. A capa nao e enfeite: recolhida, ela e a
// unica coisa que sobra, e e por ela que a lista continua navegavel sem
// rotulo.
component PlaylistNavItem inherits Rectangle {
    in property <CardItem> item;
    callback activated();

    height: Layout.sidebar-playlist-height;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface-raised : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;
        alignment: Layout.sidebar-labels-shown ? start : center;

        Artwork {
            source: root.item.cover;
            seed: root.item.title;
            radius: Theme.radius-sm;
            width: Layout.sidebar-playlist-height - Theme.space-xs * 2;
            height: self.width;
            y: (parent.height - self.height) / 2;
        }

        if Layout.sidebar-labels-shown: Text {
            text: root.item.title;
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := PressableArea {
        accessible-label: "Abrir playlist " + root.item.title;
        clicked => { root.activated(); }
    }
}

component Sidebar inherits Rectangle {
    in property <int> page;
    in property <bool> logged-in;
    in property <string> account-name;
    in property <[CardItem]> playlists;
    callback navigate(int);
    callback toggle-sidebar();
    callback login();
    callback filter-playlists(string);
    callback open-playlist(string);

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;

        // Cabecalho: a marca e o botao de recolher.
        //
        // Sem rotulos a barra fica so com icones, e a marca passa a ser a unica
        // identificacao visivel do aplicativo -- por isso ela aparece nos dois
        // estados, e nao so ao lado do nome.
        //
        // Recolhida, porem, a largura e a de um icone: marca e botao nao cabem
        // lado a lado e empilham. Insistir na mesma linha era o que estourava a
        // caixa.
        if !Layout.sidebar-collapsed: HorizontalLayout {
            height: 48px;
            padding-left: Theme.space-sm;
            spacing: Theme.space-sm;
            alignment: Layout.sidebar-labels-shown ? start : center;

            Logo {
                y: (parent.height - self.height) / 2;
            }

            if Layout.sidebar-labels-shown: Text {
                text: "Morune";
                color: Theme.text;
                font-size: Theme.size-lg;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if Layout.sidebar-collapsible: IconButton {
                label: "Recolher barra lateral";
                path: Icons.chevron-left;
                tint: Theme.text-muted;
                button-size: 28px;
                y: (parent.height - self.height) / 2;
                clicked => { root.toggle-sidebar(); }
            }
        }

        if Layout.sidebar-collapsed: VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;
            // Sem isto o cabecalho fica com a sobra vertical da barra e empurra
            // a navegacao para o meio da tela. O cabecalho expandido nao
            // precisa porque tem altura fixa.
            vertical-stretch: 0;

            HorizontalLayout {
                alignment: center;
                Logo { }
            }

            // Sempre presente quando recolhida, mesmo que o tema desligue
            // `collapsible`: sem ele nao haveria como voltar, e o usuario
            // ficaria preso numa barra de icones.
            HorizontalLayout {
                alignment: center;
                IconButton {
                    label: "Expandir barra lateral";
                    path: Icons.chevron-right;
                    tint: Theme.text-muted;
                    button-size: 28px;
                    clicked => { root.toggle-sidebar(); }
                }
            }
        }

        NavItem {
            label: "Inicio";
            icon: Icons.home;
            active: root.page == 0;
            clicked => { root.navigate(0); }
        }

        NavItem {
            label: "Buscar";
            icon: Icons.search;
            active: root.page == 1;
            clicked => { root.navigate(1); }
        }

        NavItem {
            label: "Biblioteca";
            icon: Icons.library;
            active: root.page == 2;
            clicked => { root.navigate(2); }
        }

        // As playlists vivem aqui porque e o que elas sao: o `rootlist` do
        // Spotify e a barra lateral dele, arrumada pelo proprio usuario.
        // Desenha-las como prateleira do Inicio era tratar navegacao como
        // descoberta.
        //
        // O filtro so aparece quando ha rotulo: recolhida, nao ha onde digitar
        // -- e nem faria sentido, porque a barra vira uma coluna de capas.
        if Layout.sidebar-playlists && Layout.sidebar-labels-shown && root.playlists.length > 0: Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }

        if Layout.sidebar-playlists && Layout.sidebar-labels-shown && root.playlists.length > 0: SearchField {
            placeholder: "Filtrar playlists";
            edited(q) => { root.filter-playlists(q); }
        }

        if !Layout.sidebar-playlists: Rectangle { vertical-stretch: 1; }

        if Layout.sidebar-playlists: Flickable {
            vertical-stretch: 1;
            viewport-height: lista.preferred-height;

            lista := VerticalLayout {
                alignment: start;
                spacing: Theme.space-xs;
                width: 100%;

                for item in root.playlists: PlaylistNavItem {
                    item: item;
                    activated => { root.open-playlist(item.id); }
                }
            }
        }

        NavItem {
            label: "Configuracoes";
            icon: Icons.settings;
            active: root.page == 3;
            clicked => { root.navigate(3); }
        }

        if Layout.sidebar-labels-shown && !root.logged-in: GhostButton {
            label: "Entrar no Spotify";
            clicked => { root.login(); }
        }

        if Layout.sidebar-labels-shown && root.logged-in: Text {
            text: root.account-name;
            color: Theme.text-muted;
            font-size: Theme.size-xs;
            font-family: Theme.font-family;
            overflow: elide;
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <float> volume;
    in property <bool> has-track;
    in property <bool> favorite;
    in property <bool> mini-player: false;
    // Capa da faixa tocando. Vazia enquanto o cache nao a entrega, e o bloco
    // neutro do `Artwork` ocupa o lugar sem mudar o layout.
    in property <image> cover;

    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();
    callback toggle-favorite();
    callback toggle-mini-player();

    height: Layout.player-height;
    background: Theme.player-background;

    Rectangle {
        y: 0;
        height: Theme.border-width;
        width: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding-left: Layout.player-progress-edge ? 0px : Theme.space-lg;
        padding-right: Layout.player-progress-edge ? 0px : Theme.space-lg;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-xs;

        if Layout.player-progress && Layout.player-progress-edge: Slider {
            label: "Progresso da faixa";
            value: root.progress;
            enabled: root.has-track;
            thickness: Theme.progress-thickness;
            committed(v) => { root.seek(v); }
        }

        HorizontalLayout {
            spacing: Theme.space-md;
            padding-left: Layout.player-progress-edge ? Theme.space-lg : 0px;
            padding-right: Layout.player-progress-edge ? Theme.space-lg : 0px;

            HorizontalLayout {
                spacing: Theme.space-md;
                width: root.mini-player ? 36% : 26%;

                if Layout.player-artwork: Artwork {
                    seed: root.title;
                    source: root.cover;
                    width: Layout.player-artwork-size;
                    height: Layout.player-artwork-size;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.has-track ? root.title : "Nada tocando";
                        color: Theme.text;
                        font-size: Theme.size-md;
                        font-weight: Theme.weight-medium;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }

                    Text {
                        text: root.artist;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        overflow: elide;
                    }
                }

                IconButton {
                    label: root.favorite
                        ? "Remover faixa atual das Musicas curtidas do Spotify"
                        : "Adicionar faixa atual as Musicas curtidas do Spotify";
                    path: Icons.heart;
                    filled: root.favorite;
                    active: root.favorite;
                    checkable: true;
                    enabled: root.has-track;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-favorite(); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-xs;

                HorizontalLayout {
                    alignment: Layout.player-center-controls
                        ? LayoutAlignment.center
                        : LayoutAlignment.start;
                    spacing: Theme.space-sm;

                    if Layout.player-shuffle-repeat: IconButton {
                        label: root.shuffle ? "Desligar modo aleatorio" : "Ligar modo aleatorio";
                        path: Icons.shuffle;
                        active: root.shuffle;
                        checkable: true;
                        tint: Theme.text-muted;
                        clicked => { root.toggle-shuffle(); }
                    }

                    IconButton {
                        label: "Faixa anterior";
                        path: Icons.previous;
                        filled: true;
                        enabled: root.has-track;
                        clicked => { root.previous(); }
                    }

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent;
                        opacity: root.has-track ? 1.0 : 0.45;

                        Icon {
                            path: root.playing ? Icons.pause : Icons.play;
                            tint: Theme.text-on-accent;
                            filled: true;
                            size: 18px;
                        }

                        PressableArea {
                            enabled-input: root.has-track;
                            accessible-label: root.playing ? "Pausar" : "Reproduzir";
                            focus-radius: 20px;
                            clicked => { root.toggle-play(); }
                        }
                    }

                    IconButton {
                        label: "Proxima faixa";
                        path: Icons.next;
                        filled: true;
                        enabled: root.has-track;
                        clicked => { root.next(); }
                    }

                    if Layout.player-shuffle-repeat: IconButton {
                        label: root.repeat == 0
                            ? "Ligar repeticao da fila"
                            : (root.repeat == 1 ? "Repetir esta faixa" : "Desligar repeticao");
                        path: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                        active: root.repeat != 0;
                        checkable: true;
                        tint: Theme.text-muted;
                        clicked => { root.cycle-repeat(); }
                    }
                }

                // Com a barra colada na borda nao ha onde por os tempos ao lado
                // dela, e antes disto o `show_times` do tema era simplesmente
                // ignorado: nao havia nenhuma indicacao de posicao na tela.
                if Layout.player-progress && Layout.player-progress-edge && Layout.player-times: Text {
                    text: root.elapsed + " / " + root.total;
                    color: Theme.text-muted;
                    font-size: Theme.size-xs;
                    font-family: Theme.font-family;
                    horizontal-alignment: Layout.player-center-controls ? center : left;
                }

                if Layout.player-progress && !Layout.player-progress-edge: HorizontalLayout {
                    spacing: Theme.space-sm;

                    if Layout.player-times: Text {
                        text: root.elapsed;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                        width: 40px;
                        horizontal-alignment: right;
                    }

                    Slider {
                        label: "Progresso da faixa";
                        horizontal-stretch: 1;
                        value: root.progress;
                        enabled: root.has-track;
                        committed(v) => { root.seek(v); }
                    }

                    if Layout.player-times: Text {
                        text: root.total;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                        width: 40px;
                    }
                }
            }

            HorizontalLayout {
                width: root.mini-player ? 12% : 26%;
                alignment: end;
                spacing: Theme.space-sm;

                IconButton {
                    label: root.mini-player ? "Sair do mini-player" : "Abrir mini-player";
                    path: Icons.mini-player;
                    active: root.mini-player;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-mini-player(); }
                }

                if !root.mini-player && Layout.player-queue-button: IconButton {
                    label: "Abrir fila";
                    path: Icons.queue;
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-queue(); }
                }

                if !root.mini-player && Layout.player-volume: Icon {
                    path: Icons.volume;
                    tint: Theme.text-muted;
                    size: 16px;
                    y: (parent.height - self.size) / 2;
                }

                if !root.mini-player && Layout.player-volume: Slider {
                    label: "Volume";
                    width: 96px;
                    value: root.volume;
                    y: (parent.height - self.height) / 2;
                    changed(v) => { root.set-volume(v); }
                    committed(v) => { root.set-volume(v); }
                }
            }
        }
    }
}

// Faixa horizontal de cards.
//
// Rola de lado, e nao quebra em varias linhas: uma prateleira com trinta itens
// empurraria tudo que vem depois para fora da tela. O gesto nao briga com o do
// Inicio porque os eixos sao diferentes -- a pagina rola na vertical, a
// prateleira na horizontal.
component ScrollableCardShelf inherits VerticalLayout {
    in property <string> title;
    in property <[CardItem]> items;
    callback activated(string);

    spacing: Theme.space-sm;
    vertical-stretch: 0;

    SectionTitle { text: root.title; }

    Flickable {
        height: cards.preferred-height;
        viewport-width: cards.preferred-width;
        viewport-height: self.height;

        cards := HorizontalLayout {
            spacing: Theme.space-md;
            alignment: start;
            for item in root.items: Card {
                item: item;
                activated => { root.activated(item.id); }
            }
        }
    }
}

// Uma secao do Inicio feita de faixas, para o que se ouve e nao se navega.
//
// Rola por dentro, com altura fixa. A alternativa -- listar tudo e deixar o
// Inicio crescer -- empurraria as prateleiras de cards para muito abaixo da
// dobra so para mostrar musicas curtidas.
component TrackShelf inherits VerticalLayout {
    in property <string> title;
    in property <[TrackRow]> tracks;
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    in property <bool> queue-actions: true;
    // Oito linhas: o bastante para procurar sem tomar a tela inteira. Sai do
    // token de altura de linha para acompanhar a densidade do tema.
    in property <length> visible-height: Layout.row-height * 8;

    spacing: Theme.space-sm;
    vertical-stretch: 0;

    SectionTitle { text: root.title; }

    Flickable {
        // Lista curta nao ganha area vazia: o bloco encolhe para caber nela.
        height: min(root.visible-height, rows.preferred-height);
        viewport-height: rows.preferred-height;
        viewport-width: self.width;

        rows := VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;

            for track[i] in root.tracks: TrackListRow {
                track: track;
                index: i;
                queue-actions: root.queue-actions;
                activated => { root.activated(track.id); }
                favorite-toggled => { root.favorite-toggled(track.id); }
                play-next => { root.play-next(track.id); }
                enqueue => { root.enqueue(track.id); }
            }
        }
    }
}

component HomePage inherits Flickable {
    in property <[CardItem]> made-for-you;
    in property <[CardItem]> stations;
    in property <[CardItem]> retrospectives;
    in property <[CardItem]> playlists;
    in property <[TrackRow]> liked;
    in property <bool> logged-in;
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback login();

    // Verdadeiro enquanto nenhuma secao tem conteudo: antes do login, e nos
    // segundos entre entrar e as listas chegarem.
    property <bool> empty: root.made-for-you.length == 0 && root.stations.length == 0
        && root.retrospectives.length == 0 && root.liked.length == 0
        && root.playlists.length == 0;

    viewport-height: sections.preferred-height;

    sections := VerticalLayout {
        spacing: Theme.space-lg;
        alignment: start;

        if root.empty && !root.logged-in: EmptyState {
            title: "Nada por aqui ainda";
            hint: "Entre na sua conta para ver suas musicas curtidas, o que voce mais ouve e suas playlists.";
            action-label: "Entrar no Spotify";
            action => { root.login(); }
        }

        if root.empty && root.logged-in: EmptyState {
            title: "Carregando sua conta";
            hint: "Suas listas aparecem aqui em instantes.";
        }

        if root.liked.length > 0: TrackShelf {
            title: "Musicas curtidas";
            tracks: root.liked;
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            play-next(id) => { root.play-next(id); }
            enqueue(id) => { root.enqueue(id); }
        }

        // Antes das prateleiras recomendadas: o que o usuario montou vem antes
        // do que o Spotify sugeriu.
        if root.playlists.length > 0: ScrollableCardShelf {
            title: "Suas playlists";
            items: root.playlists;
            activated(id) => { root.activated(id); }
        }

        if root.made-for-you.length > 0: ScrollableCardShelf {
            title: "Feito para voce";
            items: root.made-for-you;
            activated(id) => { root.activated(id); }
        }

        if root.stations.length > 0: ScrollableCardShelf {
            title: "Estacoes recomendadas";
            items: root.stations;
            activated(id) => { root.activated(id); }
        }

        if root.retrospectives.length > 0: ScrollableCardShelf {
            title: "Seus mais ouvidos";
            items: root.retrospectives;
            activated(id) => { root.activated(id); }
        }
    }
}

component SearchPage inherits VerticalLayout {
    in property <[TrackRow]> tracks;
    in property <[CardItem]> items;
    in property <string> query;
    in property <bool> searching;
    in property <int> grid-columns: 5;
    callback search(string);
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    private property <string> pending-query;

    debounce := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.search(root.pending-query);
        }
    }

    spacing: Theme.space-md;

    SearchField {
        placeholder: "O que voce quer ouvir?";
        text: root.query;
        edited(q) => {
            root.pending-query = q;
            debounce.running = false;
            if q.is-empty { root.search(""); }
            else { debounce.running = true; }
        }
        accepted(q) => {
            debounce.running = false;
            root.search(q);
        }
    }

    if root.searching: EmptyState {
        title: "Buscando";
        hint: "Procurando faixas, albuns, artistas e playlists para voce.";
    }

    if !root.searching && root.tracks.length == 0 && root.items.length == 0 && root.query == "": EmptyState {
        title: "Busque por musica";
        hint: "Digite uma faixa, album, artista ou playlist. A busca comeca enquanto voce escreve.";
    }

    if !root.searching && root.tracks.length == 0 && root.items.length == 0 && root.query != "": EmptyState {
        title: "Nenhum resultado";
        hint: "Tente outro termo ou confira a escrita de \"" + root.query + "\".";
    }

    if !root.searching && (root.tracks.length > 0 || root.items.length > 0): Flickable {
        vertical-stretch: 1;
        viewport-height: results.preferred-height;

        results := VerticalLayout {
            spacing: Theme.space-lg;
            alignment: start;

            if root.tracks.length > 0: TrackShelf {
                title: "Faixas";
                tracks: root.tracks;
                activated(id) => { root.activated(id); }
                favorite-toggled(id) => { root.favorite-toggled(id); }
                play-next(id) => { root.play-next(id); }
                enqueue(id) => { root.enqueue(id); }
            }

            if root.items.length > 0: VerticalLayout {
                spacing: Theme.space-sm;
                SectionTitle { text: "Albuns, artistas e playlists"; }
                CardCollection {
                    items: root.items;
                    columns: root.grid-columns;
                    activated(id) => { root.activated(id); }
                }
            }
        }
    }
}

component LibraryPage inherits Flickable {
    in property <[CardItem]> items;
    in property <bool> logged-in;
    in property <int> grid-columns: 5;
    callback login();
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback explore();

    viewport-height: content.preferred-height;

    content := VerticalLayout {
        spacing: Theme.space-lg;
        alignment: start;

        SectionTitle { text: "Biblioteca"; }

        if root.items.length == 0 && !root.logged-in: EmptyState {
            title: "Sua biblioteca comeca aqui";
            hint: "Entre no Spotify para ver sua biblioteca e suas Musicas curtidas.";
            action-label: "Entrar no Spotify";
            action => { root.login(); }
        }

        if root.items.length == 0 && root.logged-in: EmptyState {
            title: "Sua biblioteca esta vazia";
            hint: "Use o coracao para salvar no Spotify. Suas Musicas curtidas ficam na barra lateral.";
            action-label: "Explorar musicas";
            action => { root.explore(); }
        }

        if root.items.length > 0: VerticalLayout {
            spacing: Theme.space-sm;
            SectionTitle { text: "Da sua conta"; }
            CardCollection {
                items: root.items;
                columns: root.grid-columns;
                activated(id) => { root.activated(id); }
            }
        }

    }
}

// Um criterio de ordenacao da tela de detalhe.
//
// Chip e nao cabecalho de coluna de proposito: a linha de faixa mostra numero,
// titulo com artista e duracao, entao um cabecalho alinhado nao teria onde
// pendurar "artista" nem "album". O chip diz o que ordena sem fingir uma
// tabela que nao existe.
component SortChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    callback clicked();

    height: 28px;
    width: rotulo.preferred-width + Theme.space-md * 2;
    border-radius: Theme.radius-sm;
    background: root.active
        ? Theme.surface-raised
        : (toque.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.motion-fast; }

    rotulo := Text {
        // A seta so aparece no criterio ativo: repetida em todos, viraria
        // ruido, e num criterio inativo ela nao significa nada.
        text: root.active
            ? (root.descending ? root.label + " \u{2193}" : root.label + " \u{2191}")
            : root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.size-sm;
        font-family: Theme.font-family;
        x: Theme.space-md;
        y: (parent.height - self.height) / 2;
    }

    toque := PressableArea {
        accessible-label: "Ordenar por " + root.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        clicked => { root.clicked(); }
    }
}

// Uma lista aberta: playlist, album, artista ou as curtidas.
//
// Existe porque ativar um card tocava direto, e isso tira da pessoa a escolha
// mais basica -- qual faixa ela quer. Aqui ela le antes de tocar, procura, e
// ordena do jeito que preferir.
component DetailPage inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    in property <image> cover;
    in property <[TrackRow]> tracks;
    in property <[CardItem]> items;
    in property <int> sort;
    in property <bool> descending;
    in property <bool> filtered;
    in property <bool> has-more;
    in property <bool> loading;
    in property <int> loaded-count;

    callback back();
    callback play();
    callback filter(string);
    callback sort-by(int);
    callback activated(string);
    callback favorite-toggled(string);
    callback play-next(string);
    callback enqueue(string);
    callback load-more();

    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;

        GhostButton {
            label: "\u{2190} Voltar";
            clicked => { root.back(); }
        }

        Rectangle { horizontal-stretch: 1; }
    }

    // Cabecalho: capa grande, tipo, nome e o que ha dentro.
    HorizontalLayout {
        spacing: Theme.space-lg;
        vertical-stretch: 0;

        Artwork {
            source: root.cover;
            seed: root.title;
            width: min(Layout.detail-cover-size, 128px);
            height: self.width;
        }

        VerticalLayout {
            alignment: end;
            spacing: Theme.space-xs;
            horizontal-stretch: 1;

            Text {
                text: root.kind;
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
            }

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.size-xl;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
                overflow: elide;
            }

            Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                padding-top: Theme.space-sm;

                PrimaryButton {
                    label: "Tocar";
                    clicked => { root.play(); }
                }
            }
        }
    }

    SearchField {
        placeholder: "Filtrar nesta lista";
        edited(q) => { root.filter(q); }
    }

    if root.has-more || root.loading: Rectangle {
        vertical-stretch: 0;
        height: Theme.space-xl + Theme.space-md;

        HorizontalLayout {
            spacing: Theme.space-md;

            Text {
                text: root.loading
                    ? "Carregando mais faixas..."
                    : root.loaded-count + " faixas carregadas";
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.has-more && !root.loading: GhostButton {
                label: "Carregar mais";
                clicked => { root.load-more(); }
            }
        }
    }

    if root.items.length > 0: ScrollableCardShelf {
        title: "Discografia";
        items: root.items;
        activated(id) => { root.activated(id); }
    }

    HorizontalLayout {
        spacing: Theme.space-xs;
        alignment: start;
        vertical-stretch: 0;

        Text {
            text: "Ordenar por";
            color: Theme.text-muted;
            font-size: Theme.size-sm;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }

        SortChip {
            label: "Ordem da lista";
            active: root.sort == 0;
            descending: root.descending;
            clicked => { root.sort-by(0); }
        }
        SortChip {
            label: "Titulo";
            active: root.sort == 1;
            descending: root.descending;
            clicked => { root.sort-by(1); }
        }
        SortChip {
            label: "Artista";
            active: root.sort == 2;
            descending: root.descending;
            clicked => { root.sort-by(2); }
        }
        SortChip {
            label: "Album";
            active: root.sort == 3;
            descending: root.descending;
            clicked => { root.sort-by(3); }
        }
        SortChip {
            label: "Duracao";
            active: root.sort == 4;
            descending: root.descending;
            clicked => { root.sort-by(4); }
        }
    }

    // Lista vazia com filtro e outra coisa de lista vazia sem: uma diz que a
    // busca nao achou, a outra que nao ha nada.
    if root.tracks.length == 0 && root.filtered: EmptyState {
        title: "Nada com esse texto";
        hint: "Nenhuma faixa desta lista combina com o que voce digitou.";
    }

    if root.kind == "Artista" && root.tracks.length > 0: SectionTitle {
        text: "Faixas populares";
    }

    if root.tracks.length > 0: TrackList {
        vertical-stretch: 1;
        tracks: root.tracks;
        has-more: root.has-more;
        loading: root.loading;
        nearing-end => { root.load-more(); }
        activated(id) => { root.activated(id); }
        favorite-toggled(id) => { root.favorite-toggled(id); }
        play-next(id) => { root.play-next(id); }
        enqueue(id) => { root.enqueue(id); }
    }
}

component ManagedQueueShelf inherits VerticalLayout {
    in property <[TrackRow]> tracks;
    callback activated(int);
    callback favorite-toggled(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback clear();

    spacing: Theme.space-sm;
    vertical-stretch: 0;

    HorizontalLayout {
        SectionTitle { text: "Tocara a seguir"; horizontal-stretch: 1; }
        GhostButton {
            label: "Limpar";
            clicked => { root.clear(); }
        }
    }

    for track[i] in root.tracks: TrackListRow {
        track: track;
        index: i;
        queue-actions: false;
        queue-management: true;
        can-move-up: i > 0;
        can-move-down: i + 1 < root.tracks.length;
        activated => { root.activated(i); }
        favorite-toggled => { root.favorite-toggled(track.id); }
        remove-queued => { root.remove-queued(i); }
        move-up => { root.move-queued(i, i - 1); }
        move-down => { root.move-queued(i, i + 1); }
    }
}

component QueuePage inherits Flickable {
    in property <[TrackRow]> manual-tracks;
    in property <[TrackRow]> context-tracks;
    callback activated(string);
    callback activate-manual(int);
    callback favorite-toggled(string);
    callback remove-queued(int);
    callback move-queued(int, int);
    callback clear();
    callback explore();

    viewport-height: content.preferred-height;

    content := VerticalLayout {
        spacing: Theme.space-lg;
        alignment: start;

        SectionTitle { text: "Fila"; }

        if root.manual-tracks.length == 0 && root.context-tracks.length == 0: EmptyState {
            title: "Fila vazia";
            hint: "Use os controles de uma faixa para toca-la a seguir ou adicionar ao fim.";
            action-label: "Buscar musica";
            action => { root.explore(); }
        }

        if root.manual-tracks.length > 0: ManagedQueueShelf {
            tracks: root.manual-tracks;
            activated(i) => { root.activate-manual(i); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
            remove-queued(i) => { root.remove-queued(i); }
            move-queued(from, to) => { root.move-queued(from, to); }
            clear => { root.clear(); }
        }

        if root.context-tracks.length > 0: TrackShelf {
            title: root.manual-tracks.length > 0 ? "Depois, da lista atual" : "Da lista atual";
            tracks: root.context-tracks;
            queue-actions: false;
            activated(id) => { root.activated(id); }
            favorite-toggled(id) => { root.favorite-toggled(id); }
        }
    }
}

component ThemeRow inherits Rectangle {
    in property <ThemeItem> item;
    callback selected();
    callback export-pack();
    callback duplicate();

    height: 56px;
    border-radius: Theme.radius-md;
    background: root.item.active ? Theme.selected : (touch.has-hover ? Theme.hover : Theme.surface);
    animate background { duration: Theme.motion-fast; }

    // Fica atras do conteudo: os botoes Duplicar e Exportar continuam com
    // alvos independentes, em vez de o clique ser roubado pela linha inteira.
    touch := PressableArea {
        accessible-label: root.item.active
            ? "Tema " + root.item.name + ", ativo"
            : "Usar tema " + root.item.name;
        accessible-checkable: true;
        accessible-checked: root.item.active;
        focus-radius: Theme.radius-md;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.size-md;
                font-weight: root.item.active ? Theme.weight-medium : Theme.weight-normal;
                font-family: Theme.font-family;
            }

            Text {
                text: root.item.builtin
                    ? "Embutido"
                    : (root.item.author == "" ? root.item.id : root.item.author);
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
            }
        }

        if root.item.active: Text {
            text: "Ativo";
            color: Theme.accent;
            font-size: Theme.size-sm;
            font-weight: Theme.weight-medium;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }

        GhostButton {
            label: "Duplicar";
            y: (parent.height - self.height) / 2;
            clicked => { root.duplicate(); }
        }

        if !root.item.builtin: GhostButton {
            label: "Exportar";
            y: (parent.height - self.height) / 2;
            clicked => { root.export-pack(); }
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);

    height: 44px;

    touch := PressableArea {
        accessible-role: switch;
        accessible-label: root.label;
        accessible-description: root.hint;
        accessible-checkable: true;
        accessible-checked: root.checked;
        clicked => { root.toggled(!root.checked); }
    }

    HorizontalLayout {
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
            }

            Text {
                text: root.hint;
                color: Theme.text-muted;
                font-size: Theme.size-xs;
                font-family: Theme.font-family;
                overflow: elide;
            }
        }

        Toggle {
            label: root.label;
            checked: root.checked;
            interactive: false;
            y: (parent.height - self.height) / 2;
            toggled(v) => { root.toggled(v); }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <[ThemeItem]> themes;
    in property <[Diagnostic]> diagnostics;
    in property <bool> dev-mode;
    in property <bool> logged-in;
    in property <string> account-name;
    in property <bool> close-to-tray;
    in property <bool> autoplay;
    in property <bool> start-with-windows;

    callback set-close-to-tray(bool);
    callback set-autoplay(bool);
    callback set-start-with-windows(bool);
    callback select-theme(string);
    callback import-theme();
    callback export-theme(string);
    callback duplicate-theme(string);
    callback reset-theme();
    callback open-theme-folder();
    callback reload-theme();
    callback login();
    callback logout();

    spacing: Theme.space-md;

    // Cabecalho e controles ficam num layout proprio com `alignment: start`.
    //
    // Sem essa separacao o VerticalLayout externo reparte a altura sobrando
    // entre todos os filhos, e cada titulo de secao ganha uma faixa vazia de
    // ~90 px. Com `alignment: start` no bloco fixo e `vertical-stretch: 1` na
    // lista, a sobra vai toda para a lista, que e quem sabe crescer.
    VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;
        vertical-stretch: 0;

        SectionTitle { text: "Configuracoes"; }

        HorizontalLayout {
            spacing: Theme.space-sm;
            height: 34px;

            Text {
                text: root.logged-in ? root.account-name : "Nao conectado";
                color: Theme.text-muted;
                font-size: Theme.size-md;
                font-family: Theme.font-family;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if !root.logged-in: PrimaryButton {
                label: "Entrar no Spotify";
                clicked => { root.login(); }
            }

            if root.logged-in: GhostButton {
                label: "Sair";
                danger: true;
                clicked => { root.logout(); }
            }
        }

        Text {
            text: "Comportamento";
            color: Theme.text;
            font-size: Theme.size-md;
            font-weight: Theme.weight-bold;
            font-family: Theme.font-family;
        }

        SettingRow {
            label: "Continuar com radio";
            hint: "Quando a fila acabar, toca uma estacao baseada na ultima faixa.";
            checked: root.autoplay;
            toggled(v) => { root.set-autoplay(v); }
        }

        Rectangle {
            height: 44px;
            HorizontalLayout {
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: "Saida de audio"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                    Text { text: "Segue o dispositivo escolhido no Windows."; color: Theme.text-muted; font-size: Theme.size-xs; font-family: Theme.font-family; }
                }
                Text {
                    text: "Padrao do Windows";
                    color: Theme.text-muted;
                    font-size: Theme.size-sm;
                    font-family: Theme.font-family;
                    vertical-alignment: center;
                }
            }
        }

        SettingRow {
            label: "Continuar tocando ao fechar";
            hint: "Fechar a janela esconde o Morune na bandeja em vez de encerrar.";
            checked: root.close-to-tray;
            toggled(v) => { root.set-close-to-tray(v); }
        }

        SettingRow {
            label: "Iniciar com o Windows";
            hint: "Abre em segundo plano na bandeja quando voce entra no Windows.";
            checked: root.start-with-windows;
            toggled(v) => { root.set-start-with-windows(v); }
        }

        Text {
            text: "Temas";
            color: Theme.text;
            font-size: Theme.size-md;
            font-weight: Theme.weight-bold;
            font-family: Theme.font-family;
        }

        Text {
            text: "A troca e imediata. Voce pode voltar ao tema padrao a qualquer momento.";
            color: Theme.text-muted;
            font-size: Theme.size-xs;
            font-family: Theme.font-family;
        }

        VerticalLayout {
            spacing: Theme.space-sm;
            height: 76px;
            alignment: start;

            HorizontalLayout {
                spacing: Theme.space-sm;
                height: 34px;
                alignment: start;

                PrimaryButton {
                    label: "Importar tema";
                    clicked => { root.import-theme(); }
                }

                GhostButton {
                    label: "Abrir pasta de temas";
                    clicked => { root.open-theme-folder(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                height: 34px;
                alignment: start;

                GhostButton {
                    label: "Recarregar temas";
                    clicked => { root.reload-theme(); }
                }

                GhostButton {
                    label: "Usar tema padrao";
                    clicked => { root.reset-theme(); }
                }
            }
        }
    }

    Flickable {
        vertical-stretch: 1;
        viewport-height: theme-list.preferred-height;

        theme-list := VerticalLayout {
            spacing: Theme.space-xs;
            // A lista comeca no topo do visor; sem isto ela desce e fica
            // colada no rodape quando ha poucos temas.
            alignment: start;

            for item in root.themes: ThemeRow {
                item: item;
                selected => { root.select-theme(item.id); }
                export-pack => { root.export-theme(item.id); }
                duplicate => { root.duplicate-theme(item.id); }
            }

            if root.diagnostics.length > 0: Text {
                text: "Diagnosticos do tema";
                color: Theme.text;
                font-size: Theme.size-md;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family;
            }

            for d in root.diagnostics: Rectangle {
                height: diag.preferred-height + Theme.space-sm * 2;
                border-radius: Theme.radius-sm;
                background: Theme.surface;

                diag := Text {
                    text: d.field + ": " + d.message;
                    color: d.level == "error" ? Theme.danger : Theme.warning;
                    font-size: Theme.size-xs;
                    font-family: Theme.font-family;
                    wrap: word-wrap;
                    x: Theme.space-md;
                    y: Theme.space-sm;
                    width: parent.width - Theme.space-md * 2;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // --- estado vindo do Rust ---
    in property <int> page: 0;
    in property <string> status-message;
    in property <bool> undo-available: false;
    in property <bool> retry-available: false;
    in property <bool> logged-in: false;
    in property <string> account-name;

    in property <[CardItem]> home-made-for-you;
    in property <[CardItem]> home-stations;
    in property <[CardItem]> home-retrospectives;
    in property <[CardItem]> home-playlists;
    in property <[TrackRow]> home-liked;
    in property <[TrackRow]> search-tracks;
    in property <[CardItem]> search-items;
    in property <string> search-query;
    in property <bool> searching;
    in property <[CardItem]> library-items;
    in property <[TrackRow]> queue-manual-tracks;
    in property <[TrackRow]> queue-context-tracks;
    in property <[ThemeItem]> themes;
    in property <[Diagnostic]> diagnostics;

    in property <string> now-title;
    in property <string> now-id;
    in property <image> now-cover;
    in property <[CardItem]> sidebar-playlists;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-kind;
    in property <image> detail-cover;
    in property <[TrackRow]> detail-tracks;
    in property <[CardItem]> detail-items;
    in property <int> detail-sort;
    in property <bool> detail-descending;
    in property <bool> detail-filtered;
    in property <bool> detail-has-more;
    in property <bool> detail-loading;
    in property <int> detail-loaded-count;
    in property <string> now-artist;
    in property <bool> playing;
    in property <bool> has-track;
    in property <bool> now-favorite;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <float> volume: 0.7;
    in property <bool> shuffle;
    in property <int> repeat;

    in property <bool> dev-mode: false;
    in property <string> perf-text;
    in property <bool> close-to-tray: true;
    in property <bool> autoplay: true;
    in property <bool> start-with-windows: false;
    private property <bool> shortcuts-visible: false;
    in-out property <bool> mini-player: false;
    property <int> grid-columns: 5;
    private property <bool> sidebar-is-collapsed: Layout.sidebar-collapsed;
    changed width => {
        root.grid-columns = max(1, floor((root.width
            - (Layout.sidebar-collapsed ? Layout.sidebar-collapsed-width : Layout.sidebar-width)
            - Theme.space-lg * 2 + Theme.space-md)
            / (Layout.card-width + Theme.space-md)));
    }
    changed sidebar-is-collapsed => {
        root.grid-columns = max(1, floor((root.width
            - (Layout.sidebar-collapsed ? Layout.sidebar-collapsed-width : Layout.sidebar-width)
            - Theme.space-lg * 2 + Theme.space-md)
            / (Layout.card-width + Theme.space-md)));
    }

    // --- eventos para o Rust ---
    callback navigate(int);
    callback search(string);
    callback play-track(string);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite(string);
    callback queue-play-next(string);
    callback queue-enqueue(string);
    callback queue-remove(int);
    callback queue-play-manual(int);
    callback queue-move(int, int);
    callback queue-clear();
    callback select-theme(string);
    callback import-theme();
    callback export-theme(string);
    callback duplicate-theme(string);
    callback reset-theme();
    callback open-theme-folder();
    callback reload-theme();
    callback toggle-sidebar();
    callback filter-playlists(string);
    callback detail-back();
    callback detail-play();
    callback detail-filter(string);
    callback detail-sort-by(int);
    callback detail-activate(string);
    callback detail-load-more();
    callback set-close-to-tray(bool);
    callback set-autoplay(bool);
    callback set-start-with-windows(bool);
    callback login();
    callback logout();
    callback dismiss-status();
    callback undo-last();
    callback retry-last();
    callback dismiss-undo();
    callback move-window(float, float);
    callback toggle-mini-player();

    // Icone da janela e da barra de tarefas. O Slint embute o arquivo no
    // binario e o decodifica ao abrir; o desenho de 128 px e o maior tamanho
    // com hinting proprio, e o suficiente para o Windows escalar.
    //
    // Nao adianta montar este icone em codigo: o backend so reaplica o icone
    // quando a chave de cache da imagem muda, e imagens criadas em tempo de
    // execucao nao tem chave -- a janela ficaria sem icone nenhum.
    icon: @image-url("../../../assets/brand/morune-logo-system/morune-symbol-128.png");

    title: "Morune";
    no-frame: true;
    resize-border-width: root.maximized ? 0px : Theme.border-width * 6;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-md;
    min-width: root.mini-player ? 600px : 720px;
    min-height: root.mini-player ? 120px : 480px;
    preferred-width: 1180px;
    preferred-height: 760px;
    forward-focus: keys;

    VerticalLayout {
        AppTitleBar {
            maximized: root.maximized;
            move-window(dx, dy) => { root.move-window(dx, dy); }
            toggle-maximize => { root.maximized = !root.maximized; }
            minimize => { root.minimized = true; }
            close => { root.close(); }
        }

        if Layout.player-position == 1: PlayerBar {
            mini-player: root.mini-player;
            title: root.now-title;
            artist: root.now-artist;
            cover: root.now-cover;
            playing: root.playing;
            has-track: root.has-track;
            favorite: root.now-favorite;
            progress: root.progress;
            elapsed: root.elapsed;
            total: root.total;
            volume: root.volume;
            shuffle: root.shuffle;
            repeat: root.repeat;
            toggle-play => { root.toggle-play(); }
            next => { root.next-track(); }
            previous => { root.previous-track(); }
            seek(v) => { root.seek(v); }
            set-volume(v) => { root.set-volume(v); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-favorite => { root.toggle-favorite(root.now-id); }
            open-queue => { root.navigate(4); }
            toggle-mini-player => { root.toggle-mini-player(); }
        }

        if !root.mini-player: HorizontalLayout {
            vertical-stretch: 1;

            if Layout.sidebar-position == 0: Rectangle {
                width: Layout.sidebar-collapsed
                    ? Layout.sidebar-collapsed-width
                    : Layout.sidebar-width;
                background: Theme.sidebar-background;
                animate width { duration: Theme.motion-normal; easing: ease-in-out; }

                Sidebar {
                    width: 100%;
                    height: 100%;
                    page: root.page;
                    logged-in: root.logged-in;
                    account-name: root.account-name;
                    playlists: root.sidebar-playlists;
                    navigate(p) => { root.navigate(p); }
                    toggle-sidebar => { root.toggle-sidebar(); }
                    login => { root.login(); }
                    filter-playlists(q) => { root.filter-playlists(q); }
                    open-playlist(id) => { root.play-track(id); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.background;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    if root.page == 0: HomePage {
                        made-for-you: root.home-made-for-you;
                        stations: root.home-stations;
                        retrospectives: root.home-retrospectives;
                        playlists: root.home-playlists;
                        liked: root.home-liked;
                        logged-in: root.logged-in;
                        login => { root.login(); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    if root.page == 1: SearchPage {
                        tracks: root.search-tracks;
                        items: root.search-items;
                        query: root.search-query;
                        searching: root.searching;
                        grid-columns: root.grid-columns;
                        search(q) => { root.search(q); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    if root.page == 2: LibraryPage {
                        items: root.library-items;
                        logged-in: root.logged-in;
                        grid-columns: root.grid-columns;
                        login => { root.login(); }
                        explore => { root.navigate(1); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                    }

                    if root.page == 3: SettingsPage {
                        themes: root.themes;
                        diagnostics: root.diagnostics;
                        dev-mode: root.dev-mode;
                        logged-in: root.logged-in;
                        account-name: root.account-name;
                        close-to-tray: root.close-to-tray;
                        autoplay: root.autoplay;
                        start-with-windows: root.start-with-windows;
                        set-close-to-tray(v) => { root.set-close-to-tray(v); }
                        set-autoplay(v) => { root.set-autoplay(v); }
                        set-start-with-windows(v) => { root.set-start-with-windows(v); }
                        select-theme(id) => { root.select-theme(id); }
                        import-theme => { root.import-theme(); }
                        export-theme(id) => { root.export-theme(id); }
                        duplicate-theme(id) => { root.duplicate-theme(id); }
                        reset-theme => { root.reset-theme(); }
                        open-theme-folder => { root.open-theme-folder(); }
                        reload-theme => { root.reload-theme(); }
                        login => { root.login(); }
                        logout => { root.logout(); }
                    }

                    if root.page == 5: DetailPage {
                        title: root.detail-title;
                        subtitle: root.detail-subtitle;
                        kind: root.detail-kind;
                        cover: root.detail-cover;
                        tracks: root.detail-tracks;
                        items: root.detail-items;
                        sort: root.detail-sort;
                        descending: root.detail-descending;
                        filtered: root.detail-filtered;
                        has-more: root.detail-has-more;
                        loading: root.detail-loading;
                        loaded-count: root.detail-loaded-count;
                        back => { root.detail-back(); }
                        play => { root.detail-play(); }
                        filter(q) => { root.detail-filter(q); }
                        sort-by(c) => { root.detail-sort-by(c); }
                        activated(id) => { root.detail-activate(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        play-next(id) => { root.queue-play-next(id); }
                        enqueue(id) => { root.queue-enqueue(id); }
                        load-more => { root.detail-load-more(); }
                    }

                    if root.page == 4: QueuePage {
                        manual-tracks: root.queue-manual-tracks;
                        context-tracks: root.queue-context-tracks;
                        explore => { root.navigate(1); }
                        activated(id) => { root.play-track(id); }
                        favorite-toggled(id) => { root.toggle-favorite(id); }
                        activate-manual(i) => { root.queue-play-manual(i); }
                        remove-queued(i) => { root.queue-remove(i); }
                        move-queued(from, to) => { root.queue-move(from, to); }
                        clear => { root.queue-clear(); }
                    }
                }

                if root.status-message != "": Rectangle {
                    x: parent.width - self.width - Theme.space-lg;
                    y: parent.height - self.height - Theme.space-lg;
                    width: min(420px, parent.width - Theme.space-lg * 2);
                    height: max(40px, status-text.preferred-height + Theme.space-md * 2);
                    border-radius: Theme.radius-md;
                    background: Theme.surface-raised;
                    border-width: Theme.border-width;
                    border-color: Theme.border;

                    status-text := Text {
                        text: root.status-message;
                        color: Theme.text;
                        font-size: Theme.size-sm;
                        font-family: Theme.font-family;
                        wrap: word-wrap;
                        width: parent.width - Theme.space-md * 2 - 32px - ((root.undo-available || root.retry-available) ? 128px : 0px);
                        x: Theme.space-md;
                        y: Theme.space-md;
                    }

                    if root.undo-available: GhostButton {
                        label: "Desfazer";
                        width: 80px;
                        x: parent.width - self.width - 40px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.undo-last(); }
                    }

                    if !root.undo-available && root.retry-available: GhostButton {
                        label: "Tentar novamente";
                        width: 120px;
                        x: parent.width - self.width - 40px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.retry-last(); }
                    }

                    IconButton {
                        label: "Dispensar mensagem";
                        path: Icons.close;
                        tint: Theme.text-muted;
                        button-size: 28px;
                        x: parent.width - self.width - Theme.space-sm;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            if root.undo-available || root.retry-available { root.dismiss-undo(); }
                            else { root.dismiss-status(); }
                        }
                    }
                }

                if root.dev-mode: Rectangle {
                    x: Theme.space-md;
                    y: Theme.space-md;
                    width: perf.preferred-width + Theme.space-md * 2;
                    height: perf.preferred-height + Theme.space-sm * 2;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface-raised;
                    opacity: 0.92;

                    perf := Text {
                        text: root.perf-text;
                        color: Theme.text-muted;
                        font-size: Theme.size-xs;
                        font-family: Theme.font-family;
                        x: Theme.space-md;
                        y: Theme.space-sm;
                    }
                }
            }

            if Layout.sidebar-position == 1: Rectangle {
                width: Layout.sidebar-collapsed
                    ? Layout.sidebar-collapsed-width
                    : Layout.sidebar-width;
                background: Theme.sidebar-background;
                animate width { duration: Theme.motion-normal; easing: ease-in-out; }

                Sidebar {
                    width: 100%;
                    height: 100%;
                    page: root.page;
                    logged-in: root.logged-in;
                    account-name: root.account-name;
                    playlists: root.sidebar-playlists;
                    navigate(p) => { root.navigate(p); }
                    toggle-sidebar => { root.toggle-sidebar(); }
                    login => { root.login(); }
                    filter-playlists(q) => { root.filter-playlists(q); }
                    open-playlist(id) => { root.play-track(id); }
                }
            }
        }

        if Layout.player-position != 1: PlayerBar {
            mini-player: root.mini-player;
            title: root.now-title;
            artist: root.now-artist;
            cover: root.now-cover;
            playing: root.playing;
            has-track: root.has-track;
            favorite: root.now-favorite;
            progress: root.progress;
            elapsed: root.elapsed;
            total: root.total;
            volume: root.volume;
            shuffle: root.shuffle;
            repeat: root.repeat;
            toggle-play => { root.toggle-play(); }
            next => { root.next-track(); }
            previous => { root.previous-track(); }
            seek(v) => { root.seek(v); }
            set-volume(v) => { root.set-volume(v); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-favorite => { root.toggle-favorite(root.now-id); }
            open-queue => { root.navigate(4); }
            toggle-mini-player => { root.toggle-mini-player(); }
        }
    }

    if root.shortcuts-visible: Rectangle {
        z: 100;
        background: #00000099;

        TouchArea { clicked => { root.shortcuts-visible = false; } }

        Rectangle {
            width: min(480px, parent.width - Theme.space-xl * 2);
            height: 360px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-lg;
            background: Theme.surface-raised;
            border-width: Theme.border-width;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-md;

                HorizontalLayout {
                    Text {
                        text: "Atalhos de teclado";
                        color: Theme.text;
                        font-size: Theme.size-xl;
                        font-weight: Theme.weight-bold;
                        font-family: Theme.font-family;
                        vertical-alignment: center;
                    }
                    IconButton {
                        label: "Fechar atalhos";
                        path: Icons.close;
                        clicked => { root.shortcuts-visible = false; }
                    }
                }

                Text { text: "Ctrl + K     Buscar"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Ctrl + ,     Configuracoes"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Espaco       Reproduzir ou pausar"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Ctrl + →     Proxima faixa"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Ctrl + ←     Faixa anterior"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Alt + ←      Voltar"; color: Theme.text; font-size: Theme.size-md; font-family: Theme.font-family; }
                Text { text: "Ctrl + /     Mostrar estes atalhos"; color: Theme.text-muted; font-size: Theme.size-md; font-family: Theme.font-family; }
            }
        }
    }

    // Atalhos globais. As teclas de midia sao tratadas no Rust, porque precisam
    // funcionar com a janela sem foco.
    keys := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == "/" && event.modifiers.control) {
                root.shortcuts-visible = !root.shortcuts-visible;
                return EventResult.accept;
            }
            if (root.shortcuts-visible && event.text == Key.Escape) {
                root.shortcuts-visible = false;
                return EventResult.accept;
            }
            if (event.text == Key.K && event.modifiers.control) {
                root.navigate(1);
                return EventResult.accept;
            }
            if (event.text == Key.Comma && event.modifiers.control) {
                root.navigate(3);
                return EventResult.accept;
            }
            if (root.page == 5 && (event.text == Key.Escape
                    || (event.text == Key.LeftArrow && event.modifiers.alt))) {
                root.detail-back();
                return EventResult.accept;
            }
            if (event.text == " ") {
                root.toggle-play();
                return EventResult.accept;
            }
            if (event.text == Key.RightArrow && event.modifiers.control) {
                root.next-track();
                return EventResult.accept;
            }
            if (event.text == Key.LeftArrow && event.modifiers.control) {
                root.previous-track();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

// --- menu da bandeja ---

// Linha de acao do menu da bandeja.
//
// O menu nativo do Windows nao aceita estilo: e um HMENU desenhado pelo
// sistema. Trocado por uma janela propria, cada item volta a ser um retangulo
// comum -- e o realce de hover passa a ser o mesmo dos itens de navegacao da
// janela principal, em vez do azul do sistema.
component TrayMenuItem inherits Rectangle {
    in property <string> text;
    in property <string> path;
    in property <brush> tint: Theme.text;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.hover : transparent;

    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Icon {
            path: root.path;
            tint: root.tint;
            size: 16px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.tint;
            font-size: Theme.size-md;
            font-family: Theme.font-family;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    touch := PressableArea {
        accessible-label: root.text;
        focus-radius: Theme.radius-sm;
        clicked => { root.clicked(); }
    }
}

// Menu da bandeja, no lugar do menu nativo do Windows.
//
// Existe so enquanto esta aberto: o Rust cria a janela ao clique com o botao
// direito e a descarta ao fechar. Manter viva custaria um segundo contexto
// OpenGL em repouso, e o orcamento do aplicativo e justamente nao pesar na
// maquina de quem esta fazendo outra coisa.
export component TrayMenuWindow inherits Window {
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-cover;
    in property <bool> playing: false;
    in property <bool> has-track: false;

    callback show-window();
    callback toggle-play();
    callback next();
    callback previous();
    callback quit();
    callback dismiss();

    no-frame: true;
    always-on-top: true;
    // A janela e do tamanho do cartao: sem moldura, o Windows nao acrescenta
    // nada em volta, e a sombra fica por conta do proprio Windows.
    width: 272px;
    height: root.has-track ? 214px : 158px;
    background: Theme.surface-raised;
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-md;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: Theme.border-width;
        border-color: Theme.border;
        background: Theme.surface-raised;

        VerticalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-xs;

            if root.has-track: HorizontalLayout {
                padding: Theme.space-xs;
                spacing: Theme.space-sm;

                Artwork {
                    width: 44px;
                    height: 44px;
                    source: root.now-cover;
                    seed: root.now-title;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.now-title;
                        color: Theme.text;
                        font-size: Theme.size-md;
                        font-weight: Theme.weight-medium;
                        overflow: elide;
                    }

                    Text {
                        text: root.now-artist;
                        color: Theme.text-muted;
                        font-size: Theme.size-sm;
                        overflow: elide;
                    }
                }
            }

            // Sem faixa nao ha o que controlar, e uma linha de botoes apagados
            // so ocuparia espaco dizendo que nada funciona.
            if root.has-track: HorizontalLayout {
                alignment: center;
                spacing: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                IconButton {
                    path: Icons.previous;
                    filled: true;
                    clicked => { root.previous(); }
                }

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.accent;

                    Icon {
                        path: root.playing ? Icons.pause : Icons.play;
                        tint: Theme.text-on-accent;
                        filled: true;
                        size: 18px;
                    }

                    PressableArea {
                        accessible-label: root.playing ? "Pausar" : "Reproduzir";
                        focus-radius: 20px;
                        clicked => { root.toggle-play(); }
                    }
                }

                IconButton {
                    path: Icons.next;
                    filled: true;
                    clicked => { root.next(); }
                }
            }

            if !root.has-track: Text {
                text: "Nada tocando";
                color: Theme.text-muted;
                font-size: Theme.size-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 44px;
            }

            Rectangle {
                height: Theme.border-width;
                background: Theme.border;
            }

            TrayMenuItem {
                text: "Abrir Morune";
                path: Icons.home;
                clicked => { root.show-window(); }
            }

            TrayMenuItem {
                text: "Sair do Morune";
                path: Icons.close;
                tint: Theme.danger;
                clicked => { root.quit(); }
            }
        }
    }
}

// Reexportados para que o Rust consiga aplicar o tema em tempo de execucao.
export { Theme, Layout }
